# ──────────────────────────────────────────────────────────────
# bildfie.com — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# ──────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://bildfie:bildfie@localhost:5432/bildfie?schema=public"

# --- API (NestJS) ---
API_PORT=4000
API_URL="http://localhost:4000"

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Auth / RBAC ---
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="change-me-too"
REFRESH_TOKEN_EXPIRES_IN="7d"
# MFA is required for admin + super-admin logins
MFA_ISSUER="bildfie"

# --- Payments: M-Pesa Daraja ---
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_ENV="sandbox"
MPESA_CALLBACK_URL="http://localhost:4000/payments/mpesa/callback"

# --- Payments: Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- Notifications ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@bildfie.com"

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL="http://localhost:4000"
