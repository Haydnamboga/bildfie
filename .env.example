# bildfie — environment template
# Copy to .env on the SERVER (cPanel) and fill real values there.
# NEVER commit a real .env to GitHub. This template is safe to commit.

APP_NAME=bildfie
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.co.ke

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (MySQL on cPanel) ────────────────────────────────────────
# Create the DB + user in cPanel → "MySQL Databases", then paste here.
# cPanel usually prefixes names, e.g. cpaneluser_bildfie / cpaneluser_dbuser
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_bildfie
DB_USERNAME=cpaneluser_bildfie
DB_PASSWORD=

# ── Sessions / cache / queue ──────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Email (cPanel email account or SMTP relay) ────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mail.your-domain.co.ke
MAIL_PORT=587
MAIL_USERNAME=noreply@your-domain.co.ke
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

# ── SMS (notifications — spec §4.8). Africa's Talking recommended for Kenya ──
SMS_PROVIDER=africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ── M-Pesa (Safaricom Daraja) — escrow funding + payout, spec §4.4/4.5 ──
# Fill these ONLY in the server .env. Never in GitHub.
MPESA_ENV=production
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_HEAD_OFFICE_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.co.ke/api/mpesa/callback

# bildfie platform fee (basis points). 250 = 2.5% (spec §4.4)
BILDFIE_FEE_BPS=250
