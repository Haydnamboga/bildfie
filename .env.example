# BuildLink — Environment Template
# Copy this file to .env and fill in your values.
# NEVER put real credentials here — this file is committed to git.

# ── Server ───────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins (production only)
# ALLOWED_ORIGINS=https://buildlink.africa,https://www.buildlink.africa

# ── Session ──────────────────────────────────────────────────────────
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=your-strong-random-secret-here

# ── Database ─────────────────────────────────────────────────────────
# Development: SQLite file path
DB_PATH=./db/buildlink.db
# Production: PostgreSQL connection string (set by Render/Railway automatically)
# DATABASE_URL=postgresql://user:password@host:5432/buildlink
# PGSSLMODE=no-verify   # only needed for self-signed certs

# ── File uploads ─────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── M-Pesa (Safaricom Daraja) ────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_till_number
# Leave blank if your till is standalone (not under a head-office shortcode)
MPESA_HEAD_OFFICE_SHORTCODE=
MPESA_PASSKEY=your_passkey
# Public HTTPS URL — use ngrok/serveo for local dev; your domain in production
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# ── Email (Phase 2 / future) ──────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@buildlink.africa
