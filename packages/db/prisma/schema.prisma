// bildfie.com — Prisma schema (single source of DB truth)
// All access goes through the API; no client touches the DB directly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ProLevel {
  STARTER
  VERIFIED
  TOP_RATED
}

enum TradeCategory {
  ELECTRICAL
  PLUMBING
  CARPENTRY
  CIVIL
  TILING
  PAINTING
  ROOFING
  HVAC
  LANDSCAPING
  MASONRY
  WELDING
  GENERAL
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum MilestoneStatus {
  PENDING
  ACTIVE
  SUBMITTED
  COMPLETED
  PAID
}

enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REVISION_REQUESTED
  AUTO_RELEASED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum JobPostStatus {
  OPEN
  IN_REVIEW
  AWARDED
  CLOSED
}

enum ProposalStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ChangeOrderStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentProvider {
  MPESA
  STRIPE
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  RELEASED
  REFUNDED
  FAILED
}

// ──────────────────────────────────────────────────────────────
// User — ALL accounts (user/admin/super-admin distinguished by role)
// ──────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         Role      @default(USER)

  // MFA — required for admin & super-admin logins
  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  emailVerified Boolean @default(false)

  // Marketplace profile
  headline   String?
  bio        String?
  skills     String[]      @default([])
  hourlyRate Decimal?      @db.Decimal(10, 2)
  location   String?
  category   TradeCategory?
  proLevel   ProLevel      @default(STARTER)

  // Relations
  ownedProjects        Project[]             @relation("ProjectOwner")
  teamMemberships      TeamMember[]
  sentOffers           Offer[]               @relation("OfferFrom")
  receivedOffers       Offer[]               @relation("OfferTo")
  reviewsGiven         Review[]              @relation("ReviewAuthor")
  reviewsReceived      Review[]              @relation("ReviewSubject")
  messages             Message[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  refreshTokens        RefreshToken[]
  verificationTokens   VerificationToken[]
  jobPosts             JobPost[]             @relation("ClientJobPosts")
  proposals            Proposal[]
  portfolio            PortfolioItem[]
  changeOrders         ChangeOrder[]
  dailyLogs            DailyLog[]
  milestoneSubmissions MilestoneSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

// ──────────────────────────────────────────────────────────────
// JobPost — client posts a job; pros submit proposals
// ──────────────────────────────────────────────────────────────

model JobPost {
  id          String        @id @default(cuid())
  title       String
  description String
  category    TradeCategory
  location    String
  budgetMin   Decimal?      @db.Decimal(12, 2)
  budgetMax   Decimal?      @db.Decimal(12, 2)
  dueDate     DateTime?
  status      JobPostStatus @default(OPEN)

  clientId String
  client   User     @relation("ClientJobPosts", fields: [clientId], references: [id], onDelete: Cascade)
  proposals Proposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([category])
  @@map("job_posts")
}

// ──────────────────────────────────────────────────────────────
// Proposal — pro submits a bid on a JobPost
// ──────────────────────────────────────────────────────────────

model Proposal {
  id          String         @id @default(cuid())
  coverLetter String
  amount      Decimal        @db.Decimal(12, 2)
  timeline    String?
  status      ProposalStatus @default(PENDING)

  jobPostId String
  jobPost   JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  proId     String
  pro       User    @relation(fields: [proId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobPostId, proId])
  @@index([proId])
  @@index([jobPostId, status])
  @@map("proposals")
}

// ──────────────────────────────────────────────────────────────
// Project lifecycle (draft → active → complete)
// ──────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      ProjectStatus @default(DRAFT)

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  team         TeamMember[]
  tasks        Task[]
  milestones   Milestone[]
  offers       Offer[]
  messages     Message[]
  changeOrders ChangeOrder[]
  dailyLogs    DailyLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

// ──────────────────────────────────────────────────────────────
// Team — invited members of a project
// ──────────────────────────────────────────────────────────────

model TeamMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleLabel String?
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("team_members")
}

// ──────────────────────────────────────────────────────────────
// Task — breakdown under a project, optionally grouped by milestone
// ──────────────────────────────────────────────────────────────

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  assigneeId String?
  dueDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([milestoneId])
  @@map("tasks")
}

// ──────────────────────────────────────────────────────────────
// Milestone — groups tasks, triggers payments
// ──────────────────────────────────────────────────────────────

model Milestone {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      MilestoneStatus @default(PENDING)
  amount      Decimal         @db.Decimal(12, 2)
  dueDate     DateTime?
  autoReleaseAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks      Task[]
  payment    Payment?
  submission MilestoneSubmission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("milestones")
}

// ──────────────────────────────────────────────────────────────
// MilestoneSubmission — pro submits work for review; auto-releases after 14 days
// ──────────────────────────────────────────────────────────────

model MilestoneSubmission {
  id            String           @id @default(cuid())
  notes         String?
  status        SubmissionStatus @default(PENDING_REVIEW)
  autoReleaseAt DateTime
  reviewedAt    DateTime?

  milestoneId   String    @unique
  milestone     Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  submittedById String
  submittedBy   User      @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("milestone_submissions")
}

// ──────────────────────────────────────────────────────────────
// Offer — direct hire between users (complement to job-board flow)
// ──────────────────────────────────────────────────────────────

model Offer {
  id      String      @id @default(cuid())
  message String?
  amount  Decimal?    @db.Decimal(12, 2)
  status  OfferStatus @default(PENDING)

  fromUserId String
  fromUser   User   @relation("OfferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User   @relation("OfferTo", fields: [toUserId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
  @@map("offers")
}

// ──────────────────────────────────────────────────────────────
// PortfolioItem — pro showcases past work
// ──────────────────────────────────────────────────────────────

model PortfolioItem {
  id          String         @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  category    TradeCategory?
  completedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("portfolio_items")
}

// ──────────────────────────────────────────────────────────────
// ChangeOrder — formal scope/price amendment on a project
// ──────────────────────────────────────────────────────────────

model ChangeOrder {
  id          String            @id @default(cuid())
  title       String
  description String
  amount      Decimal           @db.Decimal(12, 2)
  status      ChangeOrderStatus @default(PENDING)

  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User    @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("change_orders")
}

// ──────────────────────────────────────────────────────────────
// DailyLog — construction site diary
// ──────────────────────────────────────────────────────────────

model DailyLog {
  id           String   @id @default(cuid())
  logDate      DateTime
  weather      String?
  workersCount Int?
  notes        String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("daily_logs")
}

// ──────────────────────────────────────────────────────────────
// Payment — escrow, M-Pesa Daraja + Stripe, tied to a Milestone
// ──────────────────────────────────────────────────────────────

model Payment {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  status      PaymentStatus   @default(PENDING)
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("KES")
  providerRef String?

  milestoneId String    @unique
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payments")
}

// ──────────────────────────────────────────────────────────────
// Review — ratings about a User after a Project
// ──────────────────────────────────────────────────────────────

model Review {
  id      String  @id @default(cuid())
  rating  Int
  comment String?

  authorId  String
  author    User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectId String
  subject   User   @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  projectId String?

  createdAt DateTime @default(now())

  @@index([subjectId])
  @@map("reviews")
}

// ──────────────────────────────────────────────────────────────
// Message — in-project chat
// ──────────────────────────────────────────────────────────────

model Message {
  id   String @id @default(cuid())
  body String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("messages")
}

// ──────────────────────────────────────────────────────────────
// Notification
// ──────────────────────────────────────────────────────────────

model Notification {
  id    String  @id @default(cuid())
  type  String
  title String
  body  String?
  read  Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ──────────────────────────────────────────────────────────────
// AuditLog — immutable record of every privileged action
// ──────────────────────────────────────────────────────────────

model AuditLog {
  id       String  @id @default(cuid())
  action   String
  entity   String?
  entityId String?
  metadata Json?

  actorId String?
  actor   User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("verification_tokens")
}
