// bildfie.com — Prisma schema (single source of DB truth)
// Build order §10: User, Role, Project, Task, Milestone, Offer, Team, Payment.
// All access goes through the API; no client touches the DB directly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Roles & access (user | admin | super_admin)
// ──────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

// ──────────────────────────────────────────────────────────────
// User — ALL accounts (user/admin/super-admin distinguished by role)
// ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(USER)

  // MFA — required for admin & super-admin logins
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?

  emailVerified Boolean @default(false)

  // Marketplace profile
  headline   String?
  bio        String?
  skills     String[] @default([])
  hourlyRate Decimal? @db.Decimal(10, 2)

  // Relations
  ownedProjects   Project[]      @relation("ProjectOwner")
  teamMemberships TeamMember[]
  sentOffers      Offer[]        @relation("OfferFrom")
  receivedOffers  Offer[]        @relation("OfferTo")
  reviewsGiven    Review[]       @relation("ReviewAuthor")
  reviewsReceived Review[]       @relation("ReviewSubject")
  messages        Message[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

// ──────────────────────────────────────────────────────────────
// Project lifecycle (draft → active → complete)
// ──────────────────────────────────────────────────────────────

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      ProjectStatus @default(DRAFT)

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  team       TeamMember[]
  tasks      Task[]
  milestones Milestone[]
  offers     Offer[]
  messages   Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

// ──────────────────────────────────────────────────────────────
// Team — invited members of a project
// ──────────────────────────────────────────────────────────────

model TeamMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleLabel String?  // e.g. "Lead Carpenter" — free-text project role
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("team_members")
}

// ──────────────────────────────────────────────────────────────
// Task — breakdown under a project, optionally grouped by milestone
// ──────────────────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  assigneeId String?
  dueDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([milestoneId])
  @@map("tasks")
}

// ──────────────────────────────────────────────────────────────
// Milestone — groups tasks, triggers payments
// ──────────────────────────────────────────────────────────────

enum MilestoneStatus {
  PENDING
  ACTIVE
  COMPLETED
  PAID
}

model Milestone {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      MilestoneStatus @default(PENDING)
  amount      Decimal         @db.Decimal(12, 2)
  dueDate     DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks   Task[]
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("milestones")
}

// ──────────────────────────────────────────────────────────────
// Offer — marketplace hiring (sent/received between users)
// ──────────────────────────────────────────────────────────────

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Offer {
  id      String      @id @default(cuid())
  message String?
  amount  Decimal?    @db.Decimal(12, 2)
  status  OfferStatus @default(PENDING)

  fromUserId String
  fromUser   User   @relation("OfferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User   @relation("OfferTo", fields: [toUserId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
  @@map("offers")
}

// ──────────────────────────────────────────────────────────────
// Payment — escrow, M-Pesa Daraja + Stripe, tied to a Milestone
// ──────────────────────────────────────────────────────────────

enum PaymentProvider {
  MPESA
  STRIPE
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  RELEASED
  REFUNDED
  FAILED
}

model Payment {
  id       String          @id @default(cuid())
  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)
  amount   Decimal         @db.Decimal(12, 2)
  currency String          @default("KES")

  // Provider reference (M-Pesa receipt / Stripe payment intent)
  providerRef String?

  milestoneId String    @unique
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payments")
}

// ──────────────────────────────────────────────────────────────
// Review — ratings about a User after a Project
// ──────────────────────────────────────────────────────────────

model Review {
  id      String @id @default(cuid())
  rating  Int    // 1–5
  comment String?

  authorId  String
  author    User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectId String
  subject   User   @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  projectId String?

  createdAt DateTime @default(now())

  @@index([subjectId])
  @@map("reviews")
}

// ──────────────────────────────────────────────────────────────
// Message — in-project chat
// ──────────────────────────────────────────────────────────────

model Message {
  id      String @id @default(cuid())
  body    String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("messages")
}

// ──────────────────────────────────────────────────────────────
// Notification — email / SMS / push
// ──────────────────────────────────────────────────────────────

model Notification {
  id     String  @id @default(cuid())
  type   String
  title  String
  body   String?
  read   Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ──────────────────────────────────────────────────────────────
// AuditLog — immutable record of every privileged action
// ──────────────────────────────────────────────────────────────

model AuditLog {
  id       String   @id @default(cuid())
  action   String   // e.g. "user.role.changed"
  entity   String?  // affected entity type
  entityId String?
  metadata Json?

  actorId String?
  actor   User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@map("audit_logs")
}
