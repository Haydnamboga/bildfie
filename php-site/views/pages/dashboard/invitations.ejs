<%- include('../../partials/head', { title: "Invitations — bildfie" }) %>
<%- include('../../partials/dash-topbar', { user: locals.user }) %>
<%- include('../../partials/dash-sidebar', { activeSection: "invitations" }) %>


<!-- MAIN -->
<main class="bl-dash-main">

  <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
      <h4 class="fw-bold mb-0" style="font-family:'Playfair Display',serif;color:var(--bl-navy)">Project Invitations</h4>
      <p class="text-muted small mb-0">Manage invitations to join or collaborate on projects</p>
    </div>
  </div>

  <!-- TABS -->
  <div class="d-flex gap-2 mb-4">
    <button class="btn btn-primary btn-sm" id="tab-received-btn" onclick="switchTab('received')" style="border-radius:8px">
      Received <span class="badge bg-white text-primary ms-1" id="received-count" style="font-size:9px">0</span>
    </button>
    <button class="btn btn-outline-secondary btn-sm" id="tab-sent-btn" onclick="switchTab('sent')" style="border-radius:8px">
      Sent <span class="badge bg-secondary text-white ms-1" id="sent-count" style="font-size:9px">0</span>
    </button>
  </div>

  <!-- RECEIVED -->
  <div id="tab-received">
    <div id="received-list" class="row g-3">
      <div class="col-12 text-center py-5">
        <div class="spinner-border text-primary" style="width:24px;height:24px"></div>
      </div>
    </div>
  </div>

  <!-- SENT -->
  <div id="tab-sent" style="display:none">
    <div id="sent-list" class="row g-3">
      <div class="col-12 text-center py-5">
        <div class="spinner-border text-primary" style="width:24px;height:24px"></div>
      </div>
    </div>
  </div>

</main>


<%- include('../../partials/scripts') %>
<script>
function showToast(msg, type) {
  let t = document.getElementById('bl-toast');
  if (!t) {
    t = document.createElement('div'); t.id = 'bl-toast'; t.className = 'bl-toast';
    t.innerHTML = '<div class="bl-toast-dot"></div><span id="bl-toast-msg"></span>';
    document.body.appendChild(t);
  }
  t.querySelector('.bl-toast-dot').style.background = type === 'error' ? '#ef9a9a' : type === 'warning' ? '#D4A017' : '#4CAF50';
  t.querySelector('#bl-toast-msg').textContent = msg;
  t.classList.add('show');
  clearTimeout(t._t);
  t._t = setTimeout(() => t.classList.remove('show'), 3500);
}

function switchTab(tab) {
  document.getElementById('tab-received').style.display    = tab === 'received' ? 'block' : 'none';
  document.getElementById('tab-sent').style.display        = tab === 'sent'     ? 'block' : 'none';
  document.getElementById('tab-received-btn').className    = tab === 'received' ? 'btn btn-primary btn-sm' : 'btn btn-outline-secondary btn-sm';
  document.getElementById('tab-sent-btn').className        = tab === 'sent'     ? 'btn btn-primary btn-sm' : 'btn btn-outline-secondary btn-sm';
  document.getElementById('tab-received-btn').style.borderRadius = '8px';
  document.getElementById('tab-sent-btn').style.borderRadius     = '8px';
}

const statusBadge = {
  pending:  '<span class="badge" style="background:var(--bl-bg);color:var(--bl-muted);font-size:10px;border:1px solid var(--bl-rule)">Pending</span>',
  accepted: '<span class="badge" style="background:var(--bl-bg);color:var(--bl-navy);font-size:10px;border:1px solid var(--bl-rule)">Accepted</span>',
  declined: '<span class="badge" style="background:var(--bl-bg);color:var(--bl-muted);font-size:10px;border:1px solid var(--bl-rule)">Declined</span>',
};

function timeAgo(iso) {
  if (!iso) return '';
  const d = new Date(iso), now = new Date();
  const diff = (now - d) / 1000;
  if (diff < 3600) return Math.floor(diff / 60) + ' min ago';
  if (diff < 86400) return Math.floor(diff / 3600) + ' hr ago';
  return d.toLocaleDateString('en-KE', { day:'numeric', month:'short', year:'numeric' });
}

async function loadAll() {
  const user = await BLApi.me();
  if (user) document.getElementById('topbar-avatar').src = user.avatar || `https://i.pravatar.cc/100?img=${user.id % 70 + 1}`;

  const [received, sent] = await Promise.all([BLApi.getInvitations(), BLApi.getSentInvitations()]);

  // Received
  const rEl = document.getElementById('received-list');
  document.getElementById('received-count').textContent = (received || []).length;
  if (!received || !received.length) {
    rEl.innerHTML = `<div class="col-12 text-center text-muted py-5"><div style="font-size:13px">No invitations received yet.</div><div style="font-size:11px;color:var(--bl-faint);margin-top:4px">When project owners invite you to collaborate, they'll appear here.</div></div>`;
  } else {
    rEl.innerHTML = received.map(inv => `
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100" style="border-radius:14px">
          <div class="card-body p-4">
            <div class="d-flex align-items-start justify-content-between mb-3">
              <div class="d-flex align-items-center gap-3">
                <img src="${inv.inviter_avatar || 'https://i.pravatar.cc/100?img=1'}" style="width:42px;height:42px;border-radius:50%;object-fit:cover" alt="">
                <div>
                  <div class="fw-bold" style="font-size:13px;color:var(--bl-navy)">${inv.inviter_name || 'Unknown'}</div>
                  <div class="text-muted" style="font-size:11px">Invited you · ${timeAgo(inv.created_at)}</div>
                </div>
              </div>
              ${statusBadge[inv.status] || statusBadge.pending}
            </div>
            <div class="p-3 rounded-3 mb-3" style="background:var(--bl-bg);border:1px solid var(--bl-rule)">
              <div class="fw-bold mb-1" style="font-size:13px;color:var(--bl-navy)">${inv.project_name || 'Unnamed Project'}</div>
              <div class="text-muted" style="font-size:11px">${inv.project_location || '—'} · ${inv.project_type || '—'}</div>
            </div>
            <div class="mb-3">
              <div style="font-size:11px;color:var(--bl-muted)">Invited as</div>
              <div class="fw-600" style="font-size:13px;color:var(--bl-navy)">${inv.role || 'Team Member'}</div>
            </div>
            ${inv.message ? `<div class="p-3 rounded-3 mb-3" style="background:var(--bl-bg);border:1px solid var(--bl-rule);font-size:12px;color:var(--bl-navy);line-height:1.6">"${inv.message}"</div>` : ''}
            ${inv.status === 'pending' ? `
            <div class="d-flex gap-2">
              <button class="btn btn-success btn-sm flex-fill" onclick="respond(${inv.id},'accepted',this)" style="border-radius:8px;font-size:12px">Accept Invitation</button>
              <button class="btn btn-outline-secondary btn-sm flex-fill" onclick="respond(${inv.id},'declined',this)" style="border-radius:8px;font-size:12px">Decline</button>
            </div>` : `<div class="text-muted" style="font-size:12px">Responded ${timeAgo(inv.responded_at)}</div>`}
          </div>
        </div>
      </div>`).join('');
  }

  // Sent
  const sEl = document.getElementById('sent-list');
  document.getElementById('sent-count').textContent = (sent || []).length;
  if (!sent || !sent.length) {
    sEl.innerHTML = `<div class="col-12 text-center text-muted py-5"><div style="font-size:13px">No invitations sent yet.</div><div style="font-size:11px;color:var(--bl-faint);margin-top:4px">Go to a professional's profile or your project to send an invite.</div><a href="/professionals" class="btn btn-outline-primary btn-sm mt-3">Find Professionals</a></div>`;
  } else {
    sEl.innerHTML = sent.map(inv => `
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100" style="border-radius:14px">
          <div class="card-body p-4">
            <div class="d-flex align-items-start justify-content-between mb-3">
              <div class="d-flex align-items-center gap-3">
                <img src="${inv.invitee_avatar || 'https://i.pravatar.cc/100?img=2'}" style="width:42px;height:42px;border-radius:50%;object-fit:cover" alt="">
                <div>
                  <div class="fw-bold" style="font-size:13px;color:var(--bl-navy)">${inv.invitee_name || 'Professional'}</div>
                  <div class="text-muted" style="font-size:11px">${inv.invitee_role || 'Professional'} · ${timeAgo(inv.created_at)}</div>
                </div>
              </div>
              ${statusBadge[inv.status] || statusBadge.pending}
            </div>
            <div class="p-3 rounded-3" style="background:var(--bl-bg);border:1px solid var(--bl-rule)">
              <div class="fw-600 mb-1" style="font-size:12px;color:var(--bl-navy)">Project: ${inv.project_name || '—'}</div>
              <div class="text-muted" style="font-size:11px">Role offered: ${inv.role || 'Team Member'}</div>
            </div>
          </div>
        </div>
      </div>`).join('');
  }
}

async function respond(id, status, btn) {
  btn.disabled = true;
  const sibling = btn.parentElement.querySelector('button:not([disabled])');
  if (sibling) sibling.disabled = true;
  const result = await BLApi.respondInvitation(id, status);
  if (result && !result.error) {
    showToast(status === 'accepted' ? 'Invitation accepted! You\'ve joined the project.' : 'Invitation declined.');
    setTimeout(() => loadAll(), 600);
  } else {
    showToast(result?.error || 'Something went wrong', 'error');
    btn.disabled = false;
    if (sibling) sibling.disabled = false;
  }
}

document.addEventListener('DOMContentLoaded', loadAll);
</script>
</body>
</html>
