<div class="page-header d-flex justify-content-between align-items-center">
  <div><h1 class="h3 fw-bold mb-1">Services</h1><p class="text-muted mb-0">Church services record</p></div>
  <a href="/church/services/new" class="btn btn-primary"><i class="bi bi-plus"></i> Record Service</a>
</div>
<div class="card mb-3"><div class="card-body py-2">
  <form class="row g-2">
    <div class="col-md-4"><select name="type" class="form-select form-select-sm"><option value="">All Types</option><%['sabbath','midweek','prayer','special','evangelism','camp_meeting'].forEach(t=>{%><option value="<%= t %>" <%=filters.type===t?'selected':''%>><%= t.replace('_',' ') %></option><%})%></select></div>
    <div class="col-md-2"><button class="btn btn-sm btn-primary w-100">Filter</button></div>
  </form>
</div></div>
<div class="card"><div class="card-body p-0">
  <table class="table table-hover mb-0">
    <thead><tr><th>Date</th><th>Service</th><th>Type</th><th>Members</th><th>Visitors</th><th>Total</th><th></th></tr></thead>
    <tbody>
      <%services.forEach(s=>{%>
      <tr>
        <td class="small"><%=new Date(s.scheduled_at).toLocaleDateString()%></td>
        <td class="small fw-semibold"><a href="/church/services/<%=s.id%>" class="text-decoration-none"><%=s.title%></a></td>
        <td><span class="badge bg-light text-dark"><%=s.service_type%></span></td>
        <td class="small"><%=s.members_present||0%></td>
        <td class="small"><%=s.visitors_present||0%></td>
        <td class="small fw-bold"><%=(s.members_present||0)+(s.visitors_present||0)%></td>
        <td><a href="/church/services/<%=s.id%>" class="btn btn-sm btn-link p-0">View</a></td>
      </tr>
      <%})%>
      <%if(!services.length){%><tr><td colspan="7" class="text-center py-4 text-muted">No services recorded yet.</td></tr><%}%>
    </tbody>
  </table>
</div></div>
