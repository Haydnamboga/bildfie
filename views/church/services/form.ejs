<div class="page-header"><h1 class="h3 fw-bold mb-1"><%= title %></h1></div>
<%if(errors.length){%><div class="alert alert-danger"><%errors.forEach(e=>{%><div><%=e%></div><%})%></div><%}%>
<form method="POST" action="/church/services">
<div class="row g-3">
  <div class="col-md-8">
    <div class="card"><div class="card-header">Service Details</div><div class="card-body row g-3">
      <div class="col-md-8"><label class="form-label">Service Title *</label><input name="title" class="form-control" value="<%=service.title||''%>" placeholder="e.g. Sabbath Morning Service" required></div>
      <div class="col-md-4"><label class="form-label">Type</label><select name="service_type" class="form-select"><%['sabbath','midweek','prayer','special','evangelism','camp_meeting'].forEach(t=>{%><option value="<%=t%>" <%=service.service_type===t?'selected':''%>><%=t.replace('_',' ')%></option><%})%></select></div>
      <div class="col-md-6"><label class="form-label">Date & Time *</label><input name="scheduled_at" type="datetime-local" class="form-control" value="<%=service.scheduled_at||''%>" required></div>
      <div class="col-md-6"><label class="form-label">Theme</label><input name="theme" class="form-control" value="<%=service.theme||''%>"></div>
      <div class="col-md-6"><label class="form-label">Scripture Reference</label><input name="scripture_reference" class="form-control" value="<%=service.scripture_reference||''%>" placeholder="e.g. John 3:16"></div>
      <div class="col-md-6"><label class="form-label">Preacher</label><select name="preacher_id" class="form-select"><option value="">Select preacher</option><%preachers.forEach(p=>{%><option value="<%=p.id%>" <%=service.preacher_id==p.id?'selected':''%>><%=p.name%></option><%})%></select></div>
      <div class="col-md-6"><label class="form-label">Officiant/Elder</label><select name="officiant_id" class="form-select"><option value="">Select officiant</option><%preachers.forEach(p=>{%><option value="<%=p.id%>"><%=p.name%></option><%})%></select></div>
      <div class="col-12"><label class="form-label">Program Notes</label><textarea name="program_notes" class="form-control" rows="3"><%=service.program_notes||''%></textarea></div>
    </div></div>
  </div>
  <div class="col-md-4">
    <div class="card"><div class="card-header">Attendance Numbers</div><div class="card-body">
      <div class="mb-3"><label class="form-label">Members Present</label><input name="members_present" type="number" class="form-control" value="<%=service.members_present||0%>" min="0"></div>
      <div class="mb-3"><label class="form-label">Visitors</label><input name="visitors_present" type="number" class="form-control" value="<%=service.visitors_present||0%>" min="0"></div>
      <div class="mb-3"><label class="form-label">Children</label><input name="children_present" type="number" class="form-control" value="<%=service.children_present||0%>" min="0"></div>
    </div></div>
    <div class="mt-3 d-flex gap-2">
      <button class="btn btn-primary flex-grow-1">Record Service</button>
      <a href="/church/services" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </div>
</div>
</form>
