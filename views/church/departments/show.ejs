<div class="page-header d-flex justify-content-between align-items-start">
  <div>
    <nav><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a href="/church/departments">Departments</a></li><li class="breadcrumb-item active"><%=dept.name%></li></ol></nav>
    <h1 class="h3 fw-bold mb-0"><%=dept.name%></h1>
    <%if(dept.description){%><p class="text-muted small"><%=dept.description%></p><%}%>
  </div>
  <div class="d-flex gap-2">
    <span class="badge bg-success"><%=members.length%> members</span>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addMemberModal"><i class="bi bi-plus"></i> Add Member</button>
  </div>
</div>
<div class="card"><div class="card-header">Members</div><div class="card-body p-0">
  <table class="table table-hover mb-0">
    <thead><tr><th>Name</th><th>Phone</th><th>Role</th><th></th></tr></thead>
    <tbody>
      <%members.forEach(m=>{%>
      <tr>
        <td class="small fw-semibold"><%=m.name%></td>
        <td class="small text-muted"><%=m.phone||'—'%></td>
        <td><span class="badge bg-light text-dark"><%=m.role_in_dept%></span></td>
        <td>
          <form method="POST" action="/church/departments/<%=dept.id%>/members/<%=m.member_id%>/remove" class="d-inline">
            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove from department?')">Remove</button>
          </form>
        </td>
      </tr>
      <%})%>
      <%if(!members.length){%><tr><td colspan="4" class="text-center py-4 text-muted">No members in this department.</td></tr><%}%>
    </tbody>
  </table>
</div></div>

<div class="modal fade" id="addMemberModal" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Add Member to <%=dept.name%></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <form method="POST" action="/church/departments/<%=dept.id%>/members">
      <div class="modal-body row g-3">
        <div class="col-12"><label class="form-label">Member *</label><select name="member_id" class="form-select" required><option value="">Select member</option><%allMembers.forEach(m=>{%><option value="<%=m.id%>"><%=m.name%></option><%})%></select></div>
        <div class="col-12"><label class="form-label">Role in Department</label><select name="role_in_dept" class="form-select"><%['member','leader','secretary','treasurer'].forEach(r=>{%><option value="<%=r%>"><%=r%></option><%})%></select></div>
      </div>
      <div class="modal-footer"><button class="btn btn-primary">Add</button><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div>
    </form>
  </div></div>
</div>
