<div class="page-header d-flex justify-content-between align-items-start">
  <div>
    <nav><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a href="/church/reports">Reports</a></li><li class="breadcrumb-item active"><%=report.period_label%></li></ol></nav>
    <h1 class="h3 fw-bold mb-0"><%=report.report_type.charAt(0).toUpperCase()+report.report_type.slice(1)%> Report</h1>
    <p class="text-muted small"><%=report.period_label%></p>
  </div>
  <div class="d-flex gap-2">
    <span class="badge badge-status-<%=report.status%> fs-6"><%=report.status%></span>
    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer"></i></button>
  </div>
</div>
<div class="card mb-3"><div class="card-header">Report Data</div><div class="card-body">
  <pre class="bg-light p-3 rounded small"><%=JSON.stringify(report.data, null, 2)%></pre>
  <%if(report.summary){%><div class="mt-3"><h6>Narrative</h6><p><%=report.summary%></p></div><%}%>
</div></div>
