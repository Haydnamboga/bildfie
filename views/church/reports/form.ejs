<div class="page-header"><h1 class="h3 fw-bold mb-1">Submit Report to Field</h1><p class="text-muted mb-0">The system will automatically gather data for the selected period.</p></div>
<%if(errors.length){%><div class="alert alert-danger"><%errors.forEach(e=>{%><div><%=e%></div><%})%></div><%}%>
<div class="row justify-content-center">
  <div class="col-md-7">
    <form method="POST" action="/church/reports/submit" class="card">
      <div class="card-body row g-3">
        <div class="col-12"><label class="form-label">Report Type *</label>
          <select name="report_type" class="form-select" required>
            <option value="">Select type</option>
            <option value="attendance">Attendance Report</option>
            <option value="financial">Financial Report</option>
            <option value="membership">Membership Report</option>
            <option value="quarterly">Quarterly Report</option>
            <option value="annual">Annual Report</option>
          </select>
        </div>
        <div class="col-md-6"><label class="form-label">Period Label *</label><input name="period_label" class="form-control" placeholder="e.g. Q1 2026, January 2026" required></div>
        <div class="col-md-6"><label class="form-label">Period Start</label><input name="period_start" type="date" class="form-control"></div>
        <div class="col-md-6"><label class="form-label">Period End</label><input name="period_end" type="date" class="form-control"></div>
        <div class="col-12"><label class="form-label">Summary / Narrative</label><textarea name="summary" class="form-control" rows="5" placeholder="Write a brief narrative of the period's activities..."></textarea></div>
        <div class="col-12 d-flex gap-2">
          <button class="btn btn-primary"><i class="bi bi-send"></i> Submit Report</button>
          <a href="/church/reports" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </div>
    </form>
  </div>
</div>
