<div class="page-header d-flex justify-content-between align-items-center">
  <div><h1 class="h3 fw-bold mb-1">Giving Records</h1><p class="text-muted mb-0">Period: <%=filters.period%></p></div>
  <div class="d-flex gap-2">
    <a href="/church/giving/summary" class="btn btn-outline-primary btn-sm"><i class="bi bi-pie-chart"></i> Summary</a>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#givingModal"><i class="bi bi-plus"></i> Record Giving</button>
  </div>
</div>

<!-- Totals -->
<div class="row g-2 mb-3">
  <div class="col-md-3"><div class="stat-card text-center"><div class="fw-bold fs-3 text-success">KES <%=Number(grandTotal||0).toLocaleString()%></div><div class="small text-muted">Grand Total</div></div></div>
  <%totals.forEach(t=>{%>
  <div class="col-md-3 col-6"><div class="stat-card text-center"><div class="fw-bold text-success">KES <%=Number(t.total||0).toLocaleString()%></div><div class="small text-muted"><%=t.giving_type.replace('_',' ')%></div></div></div>
  <%})%>
</div>

<div class="card mb-3"><div class="card-body py-2">
  <form class="row g-2">
    <div class="col-md-4"><input name="month" type="month" class="form-control form-control-sm" value="<%=filters.period%>"></div>
    <div class="col-md-3"><select name="type" class="form-select form-select-sm"><option value="">All Types</option><%['tithe','offering','building_fund','special','camp_meeting','bible_school'].forEach(t=>{%><option value="<%=t%>" <%=filters.type===t?'selected':''%>><%=t.replace('_',' ')%></option><%})%></select></div>
    <div class="col-md-2"><button class="btn btn-sm btn-primary w-100">Filter</button></div>
  </form>
</div></div>

<div class="card"><div class="card-body p-0">
  <table class="table table-hover mb-0">
    <thead><tr><th>Date</th><th>Member</th><th>Type</th><th>Amount</th><th>Reference</th></tr></thead>
    <tbody>
      <%records.forEach(r=>{%>
      <tr>
        <td class="small"><%=new Date(r.date).toLocaleDateString()%></td>
        <td class="small"><%=r.member_name||'Anonymous'%></td>
        <td><span class="badge bg-primary bg-opacity-10 text-primary"><%=r.giving_type.replace('_',' ')%></span></td>
        <td class="fw-semibold text-success small">KES <%=Number(r.amount).toLocaleString()%></td>
        <td class="small text-muted"><%=r.reference_no||'—'%></td>
      </tr>
      <%})%>
      <%if(!records.length){%><tr><td colspan="5" class="text-center py-4 text-muted">No records for this period.</td></tr><%}%>
    </tbody>
  </table>
</div></div>

<!-- Record Giving Modal -->
<div class="modal fade" id="givingModal" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Record Giving</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <form method="POST" action="/church/giving">
      <div class="modal-body row g-3">
        <div class="col-12"><label class="form-label">Member</label><select name="member_id" class="form-select"><option value="">Anonymous</option><%members.forEach(m=>{%><option value="<%=m.id%>"><%=m.name%></option><%})%></select></div>
        <div class="col-md-6"><label class="form-label">Type *</label><select name="giving_type" class="form-select"><%['tithe','offering','building_fund','special','camp_meeting','bible_school'].forEach(t=>{%><option value="<%=t%>"><%=t.replace('_',' ')%></option><%})%></select></div>
        <div class="col-md-6"><label class="form-label">Amount (KES) *</label><input name="amount" type="number" step="0.01" class="form-control" required min="1"></div>
        <div class="col-md-6"><label class="form-label">Date *</label><input name="date" type="date" class="form-control" value="<%=new Date().toISOString().slice(0,10)%>" required></div>
        <div class="col-md-6"><label class="form-label">Service</label><select name="service_id" class="form-select"><option value="">No specific service</option><%services.forEach(s=>{%><option value="<%=s.id%>"><%=s.title%> (<%=new Date(s.scheduled_at).toLocaleDateString()%>)</option><%})%></select></div>
        <div class="col-md-6"><label class="form-label">Reference No.</label><input name="reference_no" class="form-control" placeholder="e.g. M-PESA code"></div>
        <div class="col-12"><label class="form-label">Description</label><input name="description" class="form-control"></div>
      </div>
      <div class="modal-footer"><button class="btn btn-primary">Record</button><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div>
    </form>
  </div></div>
</div>
