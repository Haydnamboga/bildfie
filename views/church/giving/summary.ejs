<div class="page-header d-flex justify-content-between align-items-center">
  <div><h1 class="h3 fw-bold mb-1">Financial Summary</h1><p class="text-muted mb-0">Year <%=year%></p></div>
  <form class="d-flex gap-2">
    <input name="year" type="number" class="form-control form-control-sm" value="<%=year%>" min="2020" max="2030" style="width:90px">
    <button class="btn btn-sm btn-primary">Go</button>
  </form>
</div>
<div class="row g-3 mb-4">
  <div class="col-md-4"><div class="stat-card text-center"><div class="fw-bold fs-2 text-success">KES <%=Number(yearTotal||0).toLocaleString()%></div><div class="small text-muted">Total <%=year%></div></div></div>
  <%byType.forEach(t=>{%>
  <div class="col-md-4 col-6"><div class="stat-card text-center"><div class="fw-bold text-success">KES <%=Number(t.total||0).toLocaleString()%></div><div class="small text-muted"><%=t.giving_type.replace('_',' ')%></div></div></div>
  <%})%>
</div>
<div class="card"><div class="card-header">Monthly Breakdown</div><div class="card-body p-0">
  <table class="table table-sm mb-0">
    <thead><tr><th>Month</th><th>Type</th><th>Amount</th></tr></thead>
    <tbody>
      <%monthly.forEach(m=>{%>
      <tr><td class="small"><%=new Date(year+'-'+m.month+'-01').toLocaleString('default',{month:'long'})%></td><td><span class="badge bg-primary bg-opacity-10 text-primary"><%=m.giving_type.replace('_',' ')%></span></td><td class="small fw-semibold text-success">KES <%=Number(m.total||0).toLocaleString()%></td></tr>
      <%})%>
      <%if(!monthly.length){%><tr><td colspan="3" class="text-center py-4 text-muted">No giving data for this year.</td></tr><%}%>
    </tbody>
  </table>
</div></div>
