<div class="page-header d-flex justify-content-between align-items-center">
  <div><h1 class="h3 fw-bold mb-1">Members</h1><p class="text-muted mb-0"><%= members.length %> members found</p></div>
  <a href="/church/members/new" class="btn btn-primary"><i class="bi bi-plus"></i> Add Member</a>
</div>
<div class="card mb-3"><div class="card-body py-2">
  <form class="row g-2">
    <div class="col-md-4"><input name="search" class="form-control form-control-sm" placeholder="Search name / phone..." value="<%= filters.search||'' %>"></div>
    <div class="col-md-2"><select name="gender" class="form-select form-select-sm"><option value="">Gender</option><option value="male" <%=filters.gender==='male'?'selected':''%>>Male</option><option value="female" <%=filters.gender==='female'?'selected':''%>>Female</option></select></div>
    <div class="col-md-2"><select name="status" class="form-select form-select-sm"><option value="">Status</option><%['active','inactive','transferred','deceased'].forEach(s=>{%><option value="<%= s %>" <%=filters.status===s?'selected':''%>><%= s %></option><%})%></select></div>
    <div class="col-md-3"><select name="dept" class="form-select form-select-sm"><option value="">All Departments</option><%departments.forEach(d=>{%><option value="<%= d.id %>" <%=filters.dept==d.id?'selected':''%>><%= d.name %></option><%})%></select></div>
    <div class="col-md-1"><button class="btn btn-sm btn-primary w-100"><i class="bi bi-search"></i></button></div>
  </form>
</div></div>
<div class="card"><div class="card-body p-0">
  <table class="table table-hover mb-0">
    <thead><tr><th>Name</th><th>Phone</th><th>Gender</th><th>Baptism</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% members.forEach(m => { %>
      <tr>
        <td><div class="d-flex align-items-center gap-2"><div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width:32px;height:32px;font-size:.75rem"><%= m.first_name.charAt(0)%><%= m.last_name.charAt(0)%></div><span class="fw-semibold small"><%= m.first_name %> <%= m.last_name %></span></div></td>
        <td class="small text-muted"><%= m.phone||'—' %></td>
        <td class="small"><%= m.gender||'—' %></td>
        <td class="small"><%= m.baptism_date ? new Date(m.baptism_date).getFullYear() : '—' %></td>
        <td><span class="badge badge-<%= m.membership_status %>"><%= m.membership_status %></span></td>
        <td><a href="/church/members/<%= m.id %>" class="btn btn-sm btn-link p-0">View</a></td>
      </tr>
      <% }) %>
      <% if (!members.length) { %><tr><td colspan="6" class="text-center py-4 text-muted">No members found.</td></tr><% } %>
    </tbody>
  </table>
</div></div>
