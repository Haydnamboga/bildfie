<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Nyamira West Field</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root {
      --field-primary: #1a3a5c;
      --field-accent: #c8a44a;
      --field-light: #f0f4f8;
    }
    body { font-family: 'Inter', sans-serif; background: var(--field-light); }
    .sidebar { width: 260px; min-height: 100vh; background: var(--field-primary); position: fixed; left: 0; top: 0; z-index: 1000; overflow-y: auto; }
    .sidebar-logo { padding: 1.5rem; border-bottom: 1px solid rgba(255,255,255,.1); }
    .sidebar-logo .field-name { color: #fff; font-weight: 700; font-size: 1rem; }
    .sidebar-logo .field-sub { color: var(--field-accent); font-size: .75rem; }
    .sidebar-logo .cross { font-size: 2rem; color: var(--field-accent); }
    .sidebar .nav-link { color: rgba(255,255,255,.75); padding: .6rem 1.5rem; font-size: .875rem; border-radius: 0; transition: all .2s; }
    .sidebar .nav-link:hover, .sidebar .nav-link.active { color: #fff; background: rgba(255,255,255,.1); border-left: 3px solid var(--field-accent); }
    .sidebar .nav-section { color: rgba(255,255,255,.4); font-size: .7rem; text-transform: uppercase; letter-spacing: .1em; padding: 1rem 1.5rem .3rem; }
    .sidebar .nav-link i { width: 20px; }
    .main-content { margin-left: 260px; min-height: 100vh; }
    .topbar { background: #fff; border-bottom: 1px solid #e2e8f0; padding: .75rem 1.5rem; position: sticky; top: 0; z-index: 100; }
    .stat-card { background: #fff; border-radius: 12px; padding: 1.25rem; border: 1px solid #e2e8f0; transition: transform .2s; }
    .stat-card:hover { transform: translateY(-2px); }
    .stat-card .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
    .stat-card .stat-value { font-size: 1.75rem; font-weight: 700; }
    .stat-card .stat-label { color: #64748b; font-size: .8rem; }
    .badge-status-active { background: #d1fae5; color: #065f46; }
    .badge-status-inactive { background: #fee2e2; color: #991b1b; }
    .badge-status-planning { background: #dbeafe; color: #1e40af; }
    .badge-status-completed { background: #d1fae5; color: #065f46; }
    .badge-status-pending { background: #fef3c7; color: #92400e; }
    .badge-status-in_progress { background: #dbeafe; color: #1e40af; }
    .badge-priority-critical { background: #fee2e2; color: #991b1b; }
    .badge-priority-high { background: #fef3c7; color: #92400e; }
    .badge-priority-medium { background: #dbeafe; color: #1e40af; }
    .badge-priority-low { background: #f1f5f9; color: #64748b; }
    .page-header { background: #fff; border-bottom: 1px solid #e2e8f0; padding: 1.5rem; margin-bottom: 1.5rem; }
    .card { border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: none; }
    .card-header { background: #fff; border-bottom: 1px solid #e2e8f0; font-weight: 600; }
    .btn-primary { background: var(--field-primary); border-color: var(--field-primary); }
    .btn-primary:hover { background: #0f2940; border-color: #0f2940; }
    .btn-accent { background: var(--field-accent); border-color: var(--field-accent); color: #fff; }
    .table th { font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; color: #64748b; border-bottom: 2px solid #e2e8f0; }
    .avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; background: var(--field-accent); display: inline-flex; align-items: center; justify-content: center; color: #fff; font-weight: 600; font-size: .9rem; }
    @media (max-width: 768px) { .sidebar { transform: translateX(-100%); } .main-content { margin-left: 0; } }
  </style>
</head>
<body>
  <!-- Sidebar -->
  <nav class="sidebar">
    <div class="sidebar-logo d-flex align-items-center gap-2">
      <div class="cross">✝</div>
      <div>
        <div class="field-name">Nyamira West Field</div>
        <div class="field-sub">SDA Church • Field Office</div>
      </div>
    </div>
    <ul class="nav flex-column mt-2">
      <li class="nav-section">Overview</li>
      <li class="nav-item"><a href="/field/dashboard" class="nav-link <%= locals.path === '/field/dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i> Dashboard</a></li>

      <li class="nav-section">Field Management</li>
      <li class="nav-item"><a href="/field/churches" class="nav-link <%= (locals.path||'').startsWith('/field/churches') ? 'active' : '' %>"><i class="bi bi-building"></i> Churches</a></li>
      <li class="nav-item"><a href="/field/members" class="nav-link <%= (locals.path||'').startsWith('/field/members') ? 'active' : '' %>"><i class="bi bi-people"></i> Members Registry</a></li>
      <li class="nav-item"><a href="/field/projects" class="nav-link <%= (locals.path||'').startsWith('/field/projects') ? 'active' : '' %>"><i class="bi bi-kanban"></i> Projects</a></li>
      <li class="nav-item"><a href="/field/events" class="nav-link <%= (locals.path||'').startsWith('/field/events') ? 'active' : '' %>"><i class="bi bi-calendar-event"></i> Events</a></li>

      <li class="nav-section">Communications</li>
      <li class="nav-item">
        <a href="/field/communications" class="nav-link <%= (locals.path||'').startsWith('/field/communications') ? 'active' : '' %>">
          <i class="bi bi-envelope"></i> Messages
          <% if (locals.unreadMessages > 0) { %><span class="badge bg-danger ms-auto"><%= locals.unreadMessages %></span><% } %>
        </a>
      </li>
      <li class="nav-item"><a href="/field/announcements" class="nav-link <%= (locals.path||'').startsWith('/field/announcements') ? 'active' : '' %>"><i class="bi bi-megaphone"></i> Announcements</a></li>

      <li class="nav-section">Reports & Analytics</li>
      <li class="nav-item"><a href="/field/reports" class="nav-link <%= (locals.path||'').startsWith('/field/reports') ? 'active' : '' %>"><i class="bi bi-file-earmark-bar-graph"></i> Reports</a></li>
      <li class="nav-item"><a href="/field/reports/generate" class="nav-link"><i class="bi bi-bar-chart-line"></i> Generate Report</a></li>

      <li class="nav-section">Administration</li>
      <li class="nav-item"><a href="/field/users" class="nav-link <%= (locals.path||'').startsWith('/field/users') ? 'active' : '' %>"><i class="bi bi-person-gear"></i> User Management</a></li>
      <li class="nav-item"><a href="/" class="nav-link"><i class="bi bi-globe"></i> Public Site</a></li>
      <li class="nav-item mt-3 pb-3"><a href="/auth/logout" class="nav-link text-danger"><i class="bi bi-box-arrow-right"></i> Sign Out</a></li>
    </ul>
  </nav>

  <!-- Main content -->
  <div class="main-content">
    <!-- Top bar -->
    <div class="topbar d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <button class="btn btn-sm btn-light d-md-none" onclick="document.querySelector('.sidebar').style.transform='translateX(0)'"><i class="bi bi-list"></i></button>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/field/dashboard" class="text-decoration-none">Field</a></li>
            <li class="breadcrumb-item active"><%= title %></li>
          </ol>
        </nav>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-warning text-dark">Field Admin</span>
        <span class="text-muted small"><%= locals.currentUser?.name || session?.userName %></span>
      </div>
    </div>

    <!-- Page body -->
    <div class="p-4">
      <%- body %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
