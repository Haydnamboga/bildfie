<body class="bg-light" style="font-family:'Sora',sans-serif">

<!-- TOPBAR -->
<header class="fixed-top bg-white border-bottom" style="height:56px;z-index:200">
  <div class="d-flex align-items-center h-100 px-3 gap-3">
    <a href="/" class="d-flex align-items-center gap-2 text-decoration-none fw-800 text-dark" style="width:220px;flex-shrink:0">
      <div class="bl-nav-mark"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
      <span style="font-size:15px">bildfie</span>
    </a>
    <div class="d-flex align-items-center bg-light border rounded-3 px-3 gap-2" style="flex:1;max-width:500px;height:36px">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ABABB3" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input type="text" class="border-0 bg-transparent w-100 outline-0" style="font-size:12px;outline:none;font-family:'Sora',sans-serif" placeholder="Search projects, professionals, invoices&hellip;">
    </div>
    <div class="d-flex align-items-center gap-2 ms-auto">
      <button class="btn btn-sm btn-outline-secondary position-relative" style="width:34px;height:34px;padding:0" onclick="showToast('3 new notifications')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
        <span class="position-absolute top-0 end-0 translate-middle badge rounded-pill bg-primary" style="font-size:7px;padding:2px 4px">3</span>
      </button>
      <button class="btn btn-sm btn-outline-secondary" style="width:34px;height:34px;padding:0" onclick="showToast('Settings')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
      </button>
      <div class="d-flex align-items-center gap-2 px-2 py-1 rounded-3" style="cursor:pointer" onclick="window.location.href='/account'">
        <img id="dash-user-avatar" src="https://i.pravatar.cc/100?img=22" class="rounded-circle" style="width:30px;height:30px;object-fit:cover" alt="User">
        <div>
          <div class="fw-600" id="dash-user-name" style="font-size:12px;color:var(--bl-navy)"><%= (user && user.name) ? user.name.split(' ')[0] : '&hellip;' %></div>
          <div class="text-muted" style="font-size:9px">bildfie Member</div>
        </div>
      </div>
    </div>
  </div>
</header>
