<div class="page-header d-flex justify-content-between align-items-center">
  <div><h1 class="h3 fw-bold mb-1">Communications</h1><p class="text-muted mb-0">Messages between the field office and churches</p></div>
  <a href="/field/communications/compose" class="btn btn-primary"><i class="bi bi-pencil-square"></i> Compose Message</a>
</div>
<div class="row g-3">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><i class="bi bi-inbox me-2"></i>Inbox — From Churches (<%= inbox.length %>)</div>
      <div class="card-body p-0">
        <% if (inbox.length) { %>
        <ul class="list-group list-group-flush">
          <% inbox.forEach(m => { %>
          <li class="list-group-item px-3 py-2 <%= m.status==='unread'?'bg-light':'' %>">
            <div class="d-flex justify-content-between align-items-start">
              <div class="flex-grow-1">
                <% if (m.status==='unread') { %><span class="badge bg-danger me-1 mb-1">New</span><% } %>
                <a href="/field/communications/<%= m.id %>" class="text-decoration-none fw-semibold small"><%= m.subject %></a>
                <div class="text-muted small"><i class="bi bi-building"></i> <%= m.from_church_name||'Unknown' %> <% if (m.sender_name) {%>· <%= m.sender_name %><% } %></div>
              </div>
              <div class="text-muted small text-end ms-2"><%= new Date(m.created_at).toLocaleDateString() %></div>
            </div>
          </li>
          <% }) %>
        </ul>
        <% } else { %><div class="p-4 text-center text-muted small">No messages received.</div><% } %>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><i class="bi bi-send me-2"></i>Sent — To Churches (<%= sent.length %>)</div>
      <div class="card-body p-0">
        <% if (sent.length) { %>
        <ul class="list-group list-group-flush">
          <% sent.forEach(m => { %>
          <li class="list-group-item px-3 py-2">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <a href="/field/communications/<%= m.id %>" class="text-decoration-none fw-semibold small"><%= m.subject %></a>
                <div class="text-muted small"><i class="bi bi-building"></i> <%= m.to_church_name||'All Churches' %></div>
              </div>
              <div class="text-end ms-2">
                <span class="badge badge-status-<%= m.status %>"><%= m.status %></span>
                <div class="text-muted small"><%= new Date(m.created_at).toLocaleDateString() %></div>
              </div>
            </div>
          </li>
          <% }) %>
        </ul>
        <% } else { %><div class="p-4 text-center text-muted small">No messages sent.</div><% } %>
      </div>
    </div>
  </div>
</div>
