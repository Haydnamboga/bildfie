<div class="page-header">
  <h1 class="h3 fw-bold mb-1"><%= title %></h1>
  <p class="text-muted mb-0"><%= church.id ? 'Update church information' : 'Add a new affiliated church' %></p>
</div>
<% if (errors.length) { %><div class="alert alert-danger"><% errors.forEach(e => { %><div><i class="bi bi-exclamation-triangle"></i> <%= e %></div><% }) %></div><% } %>
<form method="POST" action="<%= church.id ? '/field/churches/'+church.id+'/edit' : '/field/churches' %>">
  <div class="row g-3">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">Church Details</div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-8"><label class="form-label">Church Name *</label><input name="name" class="form-control" value="<%= church.name||'' %>" required></div>
            <div class="col-md-4"><label class="form-label">Code</label><input name="code" class="form-control" value="<%= church.code||'' %>" placeholder="e.g. NWF-001"></div>
            <div class="col-md-6"><label class="form-label">County</label><input name="county" class="form-control" value="<%= church.county||'Nyamira' %>"></div>
            <div class="col-md-6"><label class="form-label">Sub-County</label><input name="sub_county" class="form-control" value="<%= church.sub_county||'' %>"></div>
            <div class="col-md-6"><label class="form-label">Ward</label><input name="ward" class="form-control" value="<%= church.ward||'' %>"></div>
            <div class="col-md-6"><label class="form-label">Village</label><input name="village" class="form-control" value="<%= church.village||'' %>"></div>
            <div class="col-12"><label class="form-label">Physical Address</label><textarea name="address" class="form-control" rows="2"><%= church.address||'' %></textarea></div>
            <div class="col-12"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="3"><%= church.description||'' %></textarea></div>
          </div>
        </div>
      </div>
      <div class="card mt-3">
        <div class="card-header">Pastor / Leadership</div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-4"><label class="form-label">Pastor Name</label><input name="pastor_name" class="form-control" value="<%= church.pastor_name||'' %>"></div>
            <div class="col-md-4"><label class="form-label">Pastor Email</label><input name="pastor_email" type="email" class="form-control" value="<%= church.pastor_email||'' %>"></div>
            <div class="col-md-4"><label class="form-label">Pastor Phone</label><input name="pastor_phone" class="form-control" value="<%= church.pastor_phone||'' %>"></div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card">
        <div class="card-header">Status & Classification</div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
              <% ['active','inactive','planting'].forEach(s => { %><option value="<%= s %>" <%= church.status===s?'selected':'' %>><%= s.charAt(0).toUpperCase()+s.slice(1) %></option><% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Church Type</label>
            <select name="church_type" class="form-select">
              <% ['local','company','group'].forEach(s => { %><option value="<%= s %>" <%= church.church_type===s?'selected':'' %>><%= s.charAt(0).toUpperCase()+s.slice(1) %> Church</option><% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Seating Capacity</label>
            <input name="capacity" type="number" class="form-control" value="<%= church.capacity||'' %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Established Date</label>
            <input name="established_date" type="date" class="form-control" value="<%= church.established_date||'' %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Building Status</label>
            <select name="building_status" class="form-select">
              <option value="">Not specified</option>
              <% ['owned','rented','under_construction','no_building'].forEach(s => { %><option value="<%= s %>" <%= church.building_status===s?'selected':'' %>><%= s.replace('_',' ') %></option><% }) %>
            </select>
          </div>
          <div class="form-check mb-2"><input type="checkbox" name="has_land" class="form-check-input" id="hl" <%= church.has_land?'checked':'' %>><label for="hl" class="form-check-label">Has land</label></div>
          <div class="form-check mb-3"><input type="checkbox" name="has_building" class="form-check-input" id="hb" <%= church.has_building?'checked':'' %>><label for="hb" class="form-check-label">Has building</label></div>
        </div>
      </div>
      <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary flex-grow-1"><i class="bi bi-check2"></i> <%= church.id ? 'Update' : 'Add' %> Church</button>
        <a href="/field/churches" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </div>
  </div>
</form>
