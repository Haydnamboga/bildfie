<div class="page-header d-flex justify-content-between align-items-center">
  <div><h1 class="h3 fw-bold mb-1">Churches</h1><p class="text-muted mb-0">Manage affiliated churches</p></div>
  <a href="/field/churches/new" class="btn btn-primary"><i class="bi bi-plus"></i> Add Church</a>
</div>

<div class="card mb-3">
  <div class="card-body py-2">
    <form class="row g-2 align-items-end">
      <div class="col-md-5"><input name="search" class="form-control form-control-sm" placeholder="Search churches..." value="<%= filters.search||'' %>"></div>
      <div class="col-md-3">
        <select name="status" class="form-select form-select-sm">
          <option value="">All Status</option>
          <% ['active','inactive','planting'].forEach(s => { %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= s %></option><% }) %>
        </select>
      </div>
      <div class="col-md-2"><button class="btn btn-sm btn-primary w-100">Filter</button></div>
    </form>
  </div>
</div>

<div class="row g-3">
  <% churches.forEach(c => { %>
  <div class="col-md-6 col-lg-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-2">
          <div class="avatar" style="background:var(--field-primary)"><%= c.name.charAt(0) %></div>
          <div>
            <h6 class="fw-bold mb-0"><%= c.name %></h6>
            <small class="text-muted"><%= c.sub_county || c.county %></small>
          </div>
          <span class="ms-auto badge <%= c.status==='active'?'badge-status-active':'badge-status-inactive' %>"><%= c.status %></span>
        </div>
        <% if (c.pastor_name) { %><p class="small mb-1"><i class="bi bi-person-badge text-primary"></i> <%= c.pastor_name %></p><% } %>
        <% if (c.pastor_phone) { %><p class="small mb-1"><i class="bi bi-telephone text-success"></i> <%= c.pastor_phone %></p><% } %>
        <div class="d-flex align-items-center justify-content-between mt-2">
          <span class="small text-muted"><i class="bi bi-people"></i> <%= c.member_count %> members</span>
          <a href="/field/churches/<%= c.id %>" class="btn btn-sm btn-outline-primary">View →</a>
        </div>
      </div>
    </div>
  </div>
  <% }) %>
  <% if (!churches.length) { %><div class="col-12 text-center py-5 text-muted"><i class="bi bi-building display-4"></i><p>No churches found.</p></div><% } %>
</div>
