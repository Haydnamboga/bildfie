<div class="page-header"><h1 class="h3 fw-bold mb-1">Generate Report</h1><p class="text-muted mb-0">Generate field-wide or church-specific reports</p></div>
<div class="row g-3">
  <div class="col-md-4">
    <div class="card">
      <div class="card-header">Report Parameters</div>
      <div class="card-body">
        <form method="GET" action="/field/reports/generate">
          <div class="mb-3"><label class="form-label">Report Type *</label>
            <select name="type" class="form-select" required>
              <option value="">Select type</option>
              <option value="attendance" <%=params.type==='attendance'?'selected':''%>>Attendance Report</option>
              <option value="financial" <%=params.type==='financial'?'selected':''%>>Financial Report</option>
              <option value="membership" <%=params.type==='membership'?'selected':''%>>Membership Report</option>
            </select>
          </div>
          <div class="mb-3"><label class="form-label">From Date</label><input name="period_start" type="date" class="form-control" value="<%= params.period_start||'' %>"></div>
          <div class="mb-3"><label class="form-label">To Date</label><input name="period_end" type="date" class="form-control" value="<%= params.period_end||'' %>"></div>
          <div class="mb-3"><label class="form-label">Church (leave blank for all)</label>
            <select name="church_id" class="form-select"><option value="">All Churches</option><%churches.forEach(c=>{%><option value="<%= c.id %>" <%=params.church_id==c.id?'selected':''%>><%=c.name%></option><%})%></select>
          </div>
          <button class="btn btn-primary w-100">Generate</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-md-8">
    <% if (locals.error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <% if (result) { %>
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-file-earmark-bar-graph me-2"></i><%= params.type.charAt(0).toUpperCase()+params.type.slice(1) %> Report</span>
        <form method="POST" action="/field/reports/save" class="d-inline">
          <input type="hidden" name="report_type" value="<%= params.type %>">
          <input type="hidden" name="period_start" value="<%= params.period_start %>">
          <input type="hidden" name="period_end" value="<%= params.period_end %>">
          <input type="hidden" name="church_id" value="<%= params.church_id||'' %>">
          <input type="hidden" name="data" value='<%= JSON.stringify(result) %>'>
          <input type="hidden" name="period_label" value="<%= params.period_start %> to <%= params.period_end %>">
          <button class="btn btn-success btn-sm"><i class="bi bi-save"></i> Save Report</button>
        </form>
      </div>
      <div class="card-body">
        <% if (params.type === 'attendance') { %>
        <div class="row g-3 mb-3">
          <div class="col-3 text-center"><div class="fw-bold fs-2 text-primary"><%= result.total_services %></div><div class="small text-muted">Services</div></div>
          <div class="col-3 text-center"><div class="fw-bold fs-2 text-success"><%= result.total_members_present %></div><div class="small text-muted">Members Present</div></div>
          <div class="col-3 text-center"><div class="fw-bold fs-2 text-info"><%= result.total_visitors %></div><div class="small text-muted">Visitors</div></div>
          <div class="col-3 text-center"><div class="fw-bold fs-2 text-warning"><%= result.avg_attendance %></div><div class="small text-muted">Avg/Service</div></div>
        </div>
        <% if (result.by_type && Object.keys(result.by_type).length) { %>
        <h6>By Service Type:</h6>
        <table class="table table-sm"><thead><tr><th>Type</th><th>Services</th><th>Members</th></tr></thead><tbody>
          <% Object.entries(result.by_type).forEach(([type, data]) => { %><tr><td><%= type %></td><td><%= data.count %></td><td><%= data.members %></td></tr><% }) %>
        </tbody></table>
        <% } %>
        <% } else if (params.type === 'financial') { %>
        <div class="text-center mb-3"><div class="fw-bold fs-1 text-success">KES <%= Number(result.total||0).toLocaleString() %></div><div class="text-muted">Total Giving</div></div>
        <h6>Breakdown by Type:</h6>
        <table class="table"><thead><tr><th>Type</th><th>Amount (KES)</th></tr></thead><tbody>
          <% Object.entries(result.by_type||{}).forEach(([type, amt]) => { %><tr><td><%= type.replace('_',' ') %></td><td class="fw-semibold text-success">KES <%= Number(amt).toLocaleString() %></td></tr><% }) %>
        </tbody></table>
        <% } else if (params.type === 'membership') { %>
        <div class="row g-3">
          <div class="col-2 text-center"><div class="fw-bold fs-2"><%= result.total %></div><div class="small text-muted">Total</div></div>
          <div class="col-2 text-center"><div class="fw-bold fs-2 text-success"><%= result.active %></div><div class="small text-muted">Active</div></div>
          <div class="col-2 text-center"><div class="fw-bold fs-2 text-danger"><%= result.inactive %></div><div class="small text-muted">Inactive</div></div>
          <div class="col-2 text-center"><div class="fw-bold fs-2 text-primary"><%= result.male %></div><div class="small text-muted">Male</div></div>
          <div class="col-2 text-center"><div class="fw-bold fs-2 text-info"><%= result.female %></div><div class="small text-muted">Female</div></div>
          <div class="col-2 text-center"><div class="fw-bold fs-2 text-warning"><%= result.baptized %></div><div class="small text-muted">Baptized</div></div>
        </div>
        <% } %>
      </div>
    </div>
    <% } else { %>
    <div class="card p-5 text-center text-muted">
      <i class="bi bi-bar-chart-line display-3 mb-3"></i>
      <h5>Select parameters and click Generate</h5>
      <p class="small">Choose report type, date range, and optionally filter by church.</p>
    </div>
    <% } %>
  </div>
</div>
