<div class="page-header d-flex justify-content-between align-items-center">
  <div><h1 class="h3 fw-bold mb-1">Reports</h1><p class="text-muted mb-0">Field and church reports archive</p></div>
  <a href="/field/reports/generate" class="btn btn-primary"><i class="bi bi-bar-chart-line"></i> Generate Report</a>
</div>
<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead><tr><th>Period</th><th>Type</th><th>Church</th><th>Status</th><th>Generated By</th><th>Date</th><th></th></tr></thead>
      <tbody>
        <% reports.forEach(r => { %>
        <tr>
          <td class="fw-semibold small"><%= r.period_label||'—' %></td>
          <td><span class="badge bg-primary bg-opacity-10 text-primary"><%= r.report_type %></span></td>
          <td class="small text-muted"><%= r.church_name||'Field Report' %></td>
          <td><span class="badge badge-status-<%= r.status %>"><%= r.status %></span></td>
          <td class="small"><%= r.generated_by_name||'—' %></td>
          <td class="small text-muted"><%= new Date(r.created_at).toLocaleDateString() %></td>
          <td><a href="/field/reports/<%= r.id %>" class="btn btn-sm btn-link p-0">View</a></td>
        </tr>
        <% }) %>
        <% if (!reports.length) { %><tr><td colspan="7" class="text-center py-4 text-muted">No reports yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
