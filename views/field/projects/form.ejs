<div class="page-header"><h1 class="h3 fw-bold mb-1"><%= title %></h1></div>
<% if (errors.length) { %><div class="alert alert-danger"><% errors.forEach(e=>{%><div><%= e %></div><%})%></div><% } %>
<form method="POST" action="<%= project.id ? '/field/projects/'+project.id+'/edit' : '/field/projects' %>">
<div class="row g-3">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">Project Details</div>
      <div class="card-body row g-3">
        <div class="col-12"><label class="form-label">Title *</label><input name="title" class="form-control" value="<%= project.title||'' %>" required></div>
        <div class="col-12"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="3"><%= project.description||'' %></textarea></div>
        <div class="col-md-6">
          <label class="form-label">Category</label>
          <select name="category" class="form-select">
            <option value="">Select category</option>
            <% ['construction','evangelism','education','health','social','spiritual','administrative'].forEach(c=>{%><option value="<%= c %>" <%= project.category===c?'selected':'' %>><%= c.charAt(0).toUpperCase()+c.slice(1) %></option><%})%>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">Church (leave blank for field project)</label>
          <select name="church_id" class="form-select">
            <option value="">Field-level Project</option>
            <% churches.forEach(c=>{%><option value="<%= c.id %>" <%= project.church_id==c.id?'selected':'' %>><%= c.name %></option><%})%>
          </select>
        </div>
        <div class="col-md-6"><label class="form-label">Start Date</label><input name="start_date" type="date" class="form-control" value="<%= project.start_date||'' %>"></div>
        <div class="col-md-6"><label class="form-label">End Date</label><input name="end_date" type="date" class="form-control" value="<%= project.end_date||'' %>"></div>
        <div class="col-md-6"><label class="form-label">Budget (KES)</label><input name="budget" type="number" class="form-control" value="<%= project.budget||0 %>"></div>
        <div class="col-md-6"><label class="form-label">Spent (KES)</label><input name="spent" type="number" class="form-control" value="<%= project.spent||0 %>"></div>
        <div class="col-12"><label class="form-label">Notes</label><textarea name="notes" class="form-control" rows="2"><%= project.notes||'' %></textarea></div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card">
      <div class="card-header">Management</div>
      <div class="card-body">
        <div class="mb-3"><label class="form-label">Status</label>
          <select name="status" class="form-select"><%['planning','active','on_hold','completed','cancelled'].forEach(s=>{%><option value="<%= s %>" <%= project.status===s?'selected':'' %>><%= s.replace('_',' ') %></option><%})%></select>
        </div>
        <div class="mb-3"><label class="form-label">Priority</label>
          <select name="priority" class="form-select"><%['low','medium','high','critical'].forEach(s=>{%><option value="<%= s %>" <%= project.priority===s?'selected':'' %>><%= s %></option><%})%></select>
        </div>
        <div class="mb-3"><label class="form-label">Project Manager</label>
          <select name="manager_id" class="form-select"><option value="">Unassigned</option><%users.forEach(u=>{%><option value="<%= u.id %>" <%= project.manager_id==u.id?'selected':'' %>><%= u.name %></option><%})%></select>
        </div>
        <div class="mb-3"><label class="form-label">Completion %</label><input name="completion_percent" type="number" min="0" max="100" class="form-control" value="<%= project.completion_percent||0 %>"></div>
      </div>
    </div>
    <div class="mt-3 d-flex gap-2">
      <button class="btn btn-primary flex-grow-1">Save Project</button>
      <a href="/field/projects" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </div>
</div>
</form>
