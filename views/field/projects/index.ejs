<div class="page-header d-flex justify-content-between align-items-center">
  <div><h1 class="h3 fw-bold mb-1">Projects</h1><p class="text-muted mb-0">Field-wide and church project management</p></div>
  <a href="/field/projects/new" class="btn btn-primary"><i class="bi bi-plus"></i> New Project</a>
</div>
<div class="card mb-3"><div class="card-body py-2">
  <form class="row g-2">
    <div class="col-md-4">
      <select name="status" class="form-select form-select-sm">
        <option value="">All Status</option>
        <% ['planning','active','on_hold','completed','cancelled'].forEach(s => { %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= s.replace('_',' ') %></option><% }) %>
      </select>
    </div>
    <div class="col-md-5">
      <select name="church_id" class="form-select form-select-sm">
        <option value="">All Churches + Field</option>
        <% churches.forEach(c => { %><option value="<%= c.id %>" <%= filters.church_id==c.id?'selected':'' %>><%= c.name %></option><% }) %>
      </select>
    </div>
    <div class="col-md-3"><button class="btn btn-sm btn-primary w-100">Filter</button></div>
  </form>
</div></div>

<div class="row g-3">
  <% projects.forEach(p => { %>
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <h6 class="fw-bold mb-0"><a href="/field/projects/<%= p.id %>" class="text-decoration-none"><%= p.title %></a></h6>
          <div class="d-flex gap-1"><span class="badge badge-status-<%= p.status %>"><%= p.status.replace('_',' ') %></span><span class="badge badge-priority-<%= p.priority %>"><%= p.priority %></span></div>
        </div>
        <% if (p.church_name) { %><p class="small text-muted mb-1"><i class="bi bi-building"></i> <%= p.church_name %></p><% } else { %><p class="small text-warning mb-1"><i class="bi bi-star"></i> Field Project</p><% } %>
        <% if (p.category) { %><p class="small text-muted mb-1"><i class="bi bi-tag"></i> <%= p.category %></p><% } %>
        <% if (p.manager_name) { %><p class="small text-muted mb-2"><i class="bi bi-person"></i> <%= p.manager_name %></p><% } %>
        <div class="d-flex justify-content-between align-items-center small">
          <div>Budget: <strong>KES <%= Number(p.budget||0).toLocaleString() %></strong></div>
          <div>Spent: <strong>KES <%= Number(p.spent||0).toLocaleString() %></strong></div>
        </div>
        <div class="progress mt-2" style="height:6px">
          <div class="progress-bar bg-primary" style="width:<%= p.completion_percent||0 %>%" title="<%= p.completion_percent||0 %>% complete"></div>
        </div>
        <% if (p.end_date) { %><div class="text-muted mt-1" style="font-size:.72rem">Due: <%= new Date(p.end_date).toLocaleDateString() %></div><% } %>
      </div>
    </div>
  </div>
  <% }) %>
  <% if (!projects.length) { %><div class="col-12 text-center py-5 text-muted"><i class="bi bi-kanban display-4"></i><p>No projects found.</p></div><% } %>
</div>
