<div class="page-header d-flex justify-content-between align-items-center">
  <div><h1 class="h3 fw-bold mb-1">Events</h1><p class="text-muted mb-0">Field and church events</p></div>
  <a href="/field/events/new" class="btn btn-primary"><i class="bi bi-plus"></i> New Event</a>
</div>
<div class="row g-3">
  <% events.forEach(e => { %>
  <div class="col-md-6">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <span class="badge bg-primary mb-1"><%= (e.event_type||'event').replace(/_/g,' ') %></span>
            <% if (e.field_wide) { %><span class="badge bg-warning text-dark mb-1 ms-1">Field-wide</span><% } %>
            <h6 class="fw-bold"><a href="/field/events/<%= e.id %>" class="text-decoration-none"><%= e.title %></a></h6>
          </div>
          <span class="badge bg-<%= e.status==='upcoming'?'success':e.status==='completed'?'secondary':'warning' %>"><%= e.status %></span>
        </div>
        <% if (e.church_name) { %><p class="small text-muted mb-1"><i class="bi bi-building"></i> <%= e.church_name %></p><% } %>
        <div class="d-flex gap-3 small text-muted flex-wrap">
          <span><i class="bi bi-calendar3"></i> <%= new Date(e.start_date).toLocaleDateString() %></span>
          <% if (e.venue) { %><span><i class="bi bi-geo-alt"></i> <%= e.venue %></span><% } %>
          <% if (e.expected_attendance) { %><span><i class="bi bi-people"></i> Expected: <%= e.expected_attendance %></span><% } %>
          <span><i class="bi bi-cash"></i> Budget: KES <%= Number(e.budget||0).toLocaleString() %></span>
        </div>
      </div>
    </div>
  </div>
  <% }) %>
  <% if (!events.length) { %><div class="col-12 text-center py-5 text-muted"><i class="bi bi-calendar-x display-4"></i><p>No events yet.</p></div><% } %>
</div>
