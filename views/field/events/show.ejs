<div class="page-header d-flex justify-content-between align-items-start">
  <div>
    <nav><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a href="/field/events">Events</a></li><li class="breadcrumb-item active"><%= event.title %></li></ol></nav>
    <h1 class="h3 fw-bold mb-0"><%= event.title %></h1>
    <p class="text-muted small"><%= event.church_name || 'Field-wide Event' %> · <%= (event.event_type||'').replace(/_/g,' ') %></p>
  </div>
  <span class="badge bg-<%= event.status==='upcoming'?'success':event.status==='completed'?'secondary':'warning' %> fs-6"><%= event.status %></span>
</div>
<div class="row g-3">
  <div class="col-md-4">
    <div class="card mb-3"><div class="card-header">Event Details</div><div class="card-body small">
      <% if (event.start_date) { %><div class="mb-2"><span class="text-muted">Start:</span> <strong><%= new Date(event.start_date).toLocaleString() %></strong></div><% } %>
      <% if (event.end_date) { %><div class="mb-2"><span class="text-muted">End:</span> <%= new Date(event.end_date).toLocaleString() %></div><% } %>
      <% if (event.venue) { %><div class="mb-2"><span class="text-muted">Venue:</span> <%= event.venue %></div><% } %>
      <% if (event.expected_attendance) { %><div class="mb-2"><span class="text-muted">Expected:</span> <%= event.expected_attendance %></div><% } %>
      <% if (event.actual_attendance) { %><div class="mb-2"><span class="text-muted">Actual:</span> <strong><%= event.actual_attendance %></strong></div><% } %>
      <div class="mb-2"><span class="text-muted">Budget:</span> KES <%= Number(event.budget||0).toLocaleString() %></div>
      <% if (event.actual_cost) { %><div class="mb-2"><span class="text-muted">Cost:</span> KES <%= Number(event.actual_cost).toLocaleString() %></div><% } %>
      <% if (event.description) { %><p class="text-muted mt-2"><%= event.description %></p><% } %>
    </div></div>
    <% if (event.status === 'upcoming' || event.status === 'ongoing') { %>
    <div class="card"><div class="card-header">Update Status</div><div class="card-body">
      <form method="POST" action="/field/events/<%= event.id %>/status">
        <div class="mb-2"><select name="status" class="form-select form-select-sm"><%['ongoing','completed','cancelled'].forEach(s=>{%><option value="<%= s %>"><%= s %></option><%})%></select></div>
        <div class="mb-2"><input name="actual_attendance" type="number" class="form-control form-control-sm" placeholder="Actual attendance"></div>
        <div class="mb-2"><input name="actual_cost" type="number" class="form-control form-control-sm" placeholder="Actual cost (KES)"></div>
        <button class="btn btn-primary btn-sm w-100">Update</button>
      </form>
    </div></div>
    <% } %>
  </div>
  <div class="col-md-8">
    <div class="card"><div class="card-header">Volunteers (<%= volunteers.length %>)</div>
      <% if (volunteers.length) { %>
      <div class="card-body p-0"><table class="table table-sm mb-0">
        <thead><tr><th>Name</th><th>Phone</th><th>Role</th><th>Status</th></tr></thead>
        <tbody>
          <% volunteers.forEach(v => { %>
          <tr><td class="small"><%= v.display_name %></td><td class="small"><%= v.phone||'—' %></td><td class="small"><%= v.role||'—' %></td><td><span class="badge bg-<%= v.status==='confirmed'?'success':'warning' %>"><%= v.status %></span></td></tr>
          <% }) %>
        </tbody>
      </table></div>
      <% } else { %><div class="card-body text-center text-muted small">No volunteers registered.</div><% } %>
    </div>
  </div>
</div>
