<section class="py-5">
  <div class="container">
    <h1 class="section-title mb-1">Sermons</h1>
    <p class="text-muted mb-4">Messages from across the field</p>
    <div class="row g-3">
      <% sermons.forEach(s => { %>
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-start border-success border-3">
          <div class="card-body">
            <h6 class="fw-bold"><%= s.title %></h6>
            <p class="small text-muted mb-1"><i class="bi bi-person"></i> <%= s.preacher %></p>
            <% if (s.scripture_reference) { %><p class="small text-muted mb-1"><i class="bi bi-book"></i> <%= s.scripture_reference %></p><% } %>
            <p class="small text-muted mb-1"><i class="bi bi-building"></i> <%= s.church_name %></p>
            <p class="small text-muted mb-2"><i class="bi bi-calendar3"></i> <%= new Date(s.sermon_date).toLocaleDateString() %></p>
            <% if (s.summary) { %><p class="small text-muted"><%= s.summary.substring(0,120) %></p><% } %>
            <% if (s.audio_url || s.video_url) { %>
            <div class="mt-2 d-flex gap-2">
              <% if (s.audio_url) { %><a href="<%= s.audio_url %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-headphones"></i> Audio</a><% } %>
              <% if (s.video_url) { %><a href="<%= s.video_url %>" class="btn btn-sm btn-outline-danger"><i class="bi bi-play-circle"></i> Video</a><% } %>
            </div>
            <% } %>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>
