<!-- Hero -->
<section class="hero text-white py-5">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <p class="text-warning fw-semibold mb-2"><i class="bi bi-star-fill"></i> Seventh-day Adventist Church</p>
        <h1 class="display-4 fw-bold mb-3" style="font-family:'Playfair Display',serif">Nyamira West Field</h1>
        <p class="lead mb-4 opacity-75">Serving God together across Nyamira County — equipping churches, strengthening communities, spreading the gospel.</p>
        <div class="d-flex gap-3 flex-wrap">
          <a href="/churches" class="btn btn-gold btn-lg">Our Churches</a>
          <a href="/events" class="btn btn-outline-light btn-lg">Upcoming Events</a>
          <a href="/auth/login" class="btn btn-link text-white">Member Login →</a>
        </div>
      </div>
      <div class="col-lg-5 mt-5 mt-lg-0">
        <div class="row g-3">
          <div class="col-6">
            <div class="stat-hero">
              <div class="fw-bold fs-1" style="color:var(--pub-gold)"><%= stats.churches %></div>
              <div class="small">Affiliated Churches</div>
            </div>
          </div>
          <div class="col-6">
            <div class="stat-hero">
              <div class="fw-bold fs-1" style="color:var(--pub-gold)"><%= stats.members.toLocaleString() %></div>
              <div class="small">Active Members</div>
            </div>
          </div>
          <div class="col-12">
            <div class="stat-hero">
              <div class="small opacity-75">Part of the East-Central Africa Division</div>
              <div class="fw-semibold">Kenya Union Mission</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Scripture Banner -->
<div class="scripture-banner">
  <em>"But seek first the kingdom of God and his righteousness, and all these things will be added to you." — Matthew 6:33</em>
</div>

<!-- Announcements -->
<% if (announcements.length) { %>
<section class="py-4 bg-light">
  <div class="container">
    <div class="d-flex align-items-center gap-2 mb-3">
      <i class="bi bi-megaphone-fill text-warning"></i>
      <h6 class="mb-0 fw-bold">Field Announcements</h6>
    </div>
    <div class="row g-2">
      <% announcements.forEach(a => { %>
      <div class="col-md-4">
        <div class="card h-100 border-start border-warning border-3">
          <div class="card-body p-3">
            <span class="badge <%= a.priority==='urgent'?'bg-danger':a.priority==='important'?'bg-warning text-dark':'bg-secondary' %> mb-2"><%= a.priority.toUpperCase() %></span>
            <h6 class="fw-bold"><%= a.title %></h6>
            <p class="small text-muted mb-0"><%= a.content.substring(0,120) %><%= a.content.length>120?'...':'' %></p>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- Churches Grid -->
<section class="py-5">
  <div class="container">
    <div class="text-center mb-4">
      <h2 class="section-title">Our Churches</h2>
      <p class="text-muted">Affiliated congregations across Nyamira West</p>
    </div>
    <div class="row g-3">
      <% churches.forEach(c => { %>
      <div class="col-md-4 col-lg-3">
        <div class="card church-card h-100">
          <div class="card-body p-3">
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width:36px;height:36px;font-size:.85rem;background:var(--pub-primary)!important"><%= c.name.charAt(0) %></span>
              <div>
                <div class="fw-semibold small"><%= c.name %></div>
                <div class="text-muted" style="font-size:.7rem"><%= c.sub_county || 'Nyamira' %></div>
              </div>
            </div>
            <% if (c.pastor_name) { %><p class="small text-muted mb-2"><i class="bi bi-person"></i> <%= c.pastor_name %></p><% } %>
            <a href="/portal/church/<%= c.id %>" class="btn btn-sm btn-outline-primary w-100">View Church</a>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <div class="text-center mt-4">
      <a href="/churches" class="btn btn-primary">View All Churches <i class="bi bi-arrow-right"></i></a>
    </div>
  </div>
</section>

<!-- Upcoming Events -->
<% if (events.length) { %>
<section class="py-5 bg-light">
  <div class="container">
    <h2 class="section-title mb-4">Upcoming Events</h2>
    <div class="row g-3">
      <% events.forEach(e => { %>
      <div class="col-md-6 col-lg-3">
        <div class="card h-100">
          <div class="card-body p-3">
            <span class="badge badge-event mb-2"><%= (e.event_type||'event').replace('_',' ').toUpperCase() %></span>
            <h6 class="fw-bold"><%= e.title %></h6>
            <p class="small text-muted"><i class="bi bi-calendar3"></i> <%= new Date(e.start_date).toLocaleDateString('en-KE',{month:'short',day:'numeric',year:'numeric'}) %></p>
            <% if (e.venue) { %><p class="small text-muted mb-0"><i class="bi bi-geo-alt"></i> <%= e.venue %></p><% } %>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <div class="text-center mt-4"><a href="/events" class="btn btn-outline-primary">All Events</a></div>
  </div>
</section>
<% } %>

<!-- Recent Sermons -->
<% if (sermons.length) { %>
<section class="py-5">
  <div class="container">
    <h2 class="section-title mb-4">Recent Sermons</h2>
    <div class="row g-3">
      <% sermons.forEach(s => { %>
      <div class="col-md-4">
        <div class="card h-100 border-start border-success border-3">
          <div class="card-body p-3">
            <h6 class="fw-bold"><%= s.title %></h6>
            <p class="small text-muted mb-1"><i class="bi bi-person"></i> <%= s.preacher %></p>
            <% if (s.scripture_reference) { %><p class="small text-muted mb-1"><i class="bi bi-book"></i> <%= s.scripture_reference %></p><% } %>
            <p class="small text-muted mb-0"><i class="bi bi-calendar3"></i> <%= new Date(s.sermon_date).toLocaleDateString() %></p>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <div class="text-center mt-4"><a href="/sermons" class="btn btn-outline-success">All Sermons</a></div>
  </div>
</section>
<% } %>

<!-- CTA -->
<section class="py-5" style="background:linear-gradient(135deg,var(--pub-primary),var(--pub-green))">
  <div class="container text-center text-white">
    <h2 class="mb-3" style="font-family:'Playfair Display',serif">Join Our Community</h2>
    <p class="opacity-75 mb-4">Create your member profile to stay connected with your church and the Nyamira West Field.</p>
    <a href="/auth/register" class="btn btn-gold btn-lg me-2">Register Now</a>
    <a href="/contact" class="btn btn-outline-light btn-lg">Contact Us</a>
  </div>
</section>
