<section class="py-5 bg-light">
  <div class="container">
    <h1 class="section-title mb-1">Our Churches</h1>
    <p class="text-muted mb-4">Nyamira West Field Affiliated Congregations</p>
    <form class="row g-2 mb-4">
      <div class="col-md-5"><input name="search" class="form-control" placeholder="Search churches..." value="<%= filters.search||'' %>"></div>
      <div class="col-md-4">
        <select name="sub_county" class="form-select">
          <option value="">All Sub-counties</option>
          <% subCounties.forEach(s => { %><option value="<%= s %>" <%= filters.sub_county===s?'selected':'' %>><%= s %></option><% }) %>
        </select>
      </div>
      <div class="col-md-3"><button class="btn btn-primary w-100">Search</button></div>
    </form>
    <div class="row g-3">
      <% churches.forEach(c => { %>
      <div class="col-md-6 col-lg-4">
        <div class="card church-card h-100">
          <div class="card-body">
            <div class="d-flex align-items-center gap-3 mb-3">
              <div class="rounded-circle text-white fw-bold d-flex align-items-center justify-content-center" style="width:50px;height:50px;background:var(--pub-primary);font-size:1.2rem"><%= c.name.charAt(0) %></div>
              <div>
                <h6 class="fw-bold mb-0"><%= c.name %></h6>
                <small class="text-muted"><%= c.sub_county ? c.sub_county + ', ' : '' %><%= c.county || 'Nyamira' %></small>
              </div>
            </div>
            <% if (c.pastor_name) { %><p class="small mb-1"><i class="bi bi-person text-primary"></i> <strong>Pastor:</strong> <%= c.pastor_name %></p><% } %>
            <% if (c.pastor_phone) { %><p class="small mb-1"><i class="bi bi-telephone text-success"></i> <%= c.pastor_phone %></p><% } %>
            <% if (c.description) { %><p class="small text-muted mb-2"><%= c.description.substring(0,100) %></p><% } %>
            <span class="badge <%= c.status==='active'?'bg-success':'bg-secondary' %> mb-2"><%= c.status %></span>
            <div><a href="/portal/church/<%= c.id %>" class="btn btn-sm btn-outline-primary w-100">View Details</a></div>
          </div>
        </div>
      </div>
      <% }) %>
      <% if (!churches.length) { %>
      <div class="col-12 text-center py-5 text-muted"><i class="bi bi-building display-4"></i><p>No churches found.</p></div>
      <% } %>
    </div>
  </div>
</section>
