<section class="py-5 bg-light">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <h1 class="section-title">About Nyamira West Field</h1>
        <p class="lead text-muted">A conference field of the Kenya Union Mission, East-Central Africa Division, Seventh-day Adventist Church.</p>
        <p>Nyamira West Field encompasses numerous local churches across the Nyamira County area, working together under shared leadership to advance the mission of the Seventh-day Adventist Church in Western Kenya.</p>
        <h5 class="fw-bold mt-4 mb-2">Our Mission</h5>
        <p>To make disciples of all nations by preaching the everlasting gospel, developing Spirit-filled communities, and preparing people for the return of Jesus Christ.</p>
        <h5 class="fw-bold mt-4 mb-2">Our Vision</h5>
        <p>A transformed Nyamira West — spiritually vibrant, socially engaged, and mission-driven churches in every village.</p>
      </div>
      <div class="col-lg-6">
        <div class="row g-3">
          <div class="col-6">
            <div class="card text-center p-3 h-100 border-top border-warning border-3">
              <i class="bi bi-book-half text-warning fs-2 mb-2"></i>
              <h6>Scripture-centred</h6>
              <p class="small text-muted">All doctrines and practices rooted in the Bible</p>
            </div>
          </div>
          <div class="col-6">
            <div class="card text-center p-3 h-100 border-top border-primary border-3">
              <i class="bi bi-people text-primary fs-2 mb-2"></i>
              <h6>Community</h6>
              <p class="small text-muted">Caring for one another and the broader society</p>
            </div>
          </div>
          <div class="col-6">
            <div class="card text-center p-3 h-100 border-top border-success border-3">
              <i class="bi bi-globe text-success fs-2 mb-2"></i>
              <h6>Evangelism</h6>
              <p class="small text-muted">Active outreach through crusades, media, and service</p>
            </div>
          </div>
          <div class="col-6">
            <div class="card text-center p-3 h-100 border-top border-danger border-3">
              <i class="bi bi-heart text-danger fs-2 mb-2"></i>
              <h6>Holistic Health</h6>
              <p class="small text-muted">Whole-person care — spiritual, physical, social</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="py-5">
  <div class="container">
    <h2 class="section-title mb-4">Field Leadership</h2>
    <div class="row g-3">
      <% const leaders = [
        { role: 'Field Director', icon: 'person-badge', description: 'Oversees all field operations and strategy' },
        { role: 'Field Secretary', icon: 'file-earmark-text', description: 'Manages records, reports, and correspondence' },
        { role: 'Field Treasurer', icon: 'cash-coin', description: 'Handles finances and stewardship programs' },
        { role: 'Youth Director', icon: 'people', description: 'Leads Pathfinders, AYS, and youth ministries' },
        { role: 'Women\'s Ministry Leader', icon: 'person-heart', description: 'Coordinates women\'s programs across the field' },
        { role: 'Evangelism Director', icon: 'megaphone', description: 'Coordinates outreach and evangelistic efforts' },
      ]; %>
      <% leaders.forEach(l => { %>
      <div class="col-md-4">
        <div class="card p-3">
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:48px;height:48px;background:var(--pub-primary)!important"><i class="bi bi-<%= l.icon %>"></i></div>
            <div>
              <h6 class="fw-bold mb-0"><%= l.role %></h6>
              <small class="text-muted"><%= l.description %></small>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>
