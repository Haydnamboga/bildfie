<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><title>Error</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body class="bg-light">
<div class="container py-5 text-center">
  <div class="display-1 text-muted mb-3">⚠️</div>
  <h1 class="h3"><%= title || 'Error' %></h1>
  <p class="text-muted"><%= message || 'Something went wrong.' %></p>
  <a href="/" class="btn btn-primary me-2">Go Home</a>
  <a href="javascript:history.back()" class="btn btn-outline-secondary">Go Back</a>
</div>
</body>
</html>
