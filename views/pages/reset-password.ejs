<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Reset Password — Bildfie</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
:root{--accent:#C43100;--navy:#011D47}
body{background:#f2f4f8;font-family:'Sora',sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.card{background:#fff;border-radius:16px;border:1px solid #e4e7ef;max-width:420px;width:100%;padding:40px 36px;box-shadow:0 4px 24px rgba(0,0,0,.07)}
.logo-mark{width:44px;height:44px;border-radius:11px;background:var(--accent);display:grid;place-items:center;margin:0 auto 20px}
.logo-mark svg{width:20px;height:20px;fill:none;stroke:#fff;stroke-width:2.2;stroke-linecap:round}
h1{font-family:'Playfair Display',serif;font-size:22px;font-weight:800;color:var(--navy);text-align:center;margin-bottom:6px}
p.sub{font-size:12.5px;color:#6b7280;text-align:center;margin-bottom:24px}
label{display:block;font-size:11px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px}
input{width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:9px;font-family:'Sora',sans-serif;font-size:13px;outline:none;transition:border-color .15s}
input:focus{border-color:var(--navy)}
.btn-main{width:100%;padding:11px;background:var(--accent);color:#fff;border:none;border-radius:9px;font-size:13px;font-weight:700;font-family:'Sora',sans-serif;cursor:pointer;margin-top:18px;transition:opacity .15s}
.btn-main:hover{opacity:.9}
.btn-main:disabled{opacity:.5;cursor:not-allowed}
.msg{display:none;padding:10px 14px;border-radius:8px;font-size:12.5px;margin-top:14px;text-align:center}
.msg.ok{background:#f0fdf4;color:#166534;border:1px solid #bbf7d0}
.msg.err{background:#fef2f2;color:#991b1b;border:1px solid #fca5a5}
a.back{display:block;text-align:center;font-size:12.5px;color:var(--navy);margin-top:18px;text-decoration:none;font-weight:600}
a.back:hover{text-decoration:underline}
</style>
</head>
<body>

<div class="card">
  <div class="logo-mark">
    <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
  </div>
  <h1>Set New Password</h1>
  <p class="sub">Choose a strong password for your Bildfie account</p>

  <form id="form" onsubmit="doReset(event)">
    <div style="margin-bottom:14px">
      <label for="pw">New Password</label>
      <input type="password" id="pw" placeholder="At least 6 characters" autocomplete="new-password" required minlength="6">
    </div>
    <div>
      <label for="pw2">Confirm Password</label>
      <input type="password" id="pw2" placeholder="Repeat your new password" autocomplete="new-password" required>
    </div>
    <button class="btn-main" id="btn" type="submit">Set Password</button>
  </form>

  <div class="msg" id="msg"></div>
  <a href="/login" class="back">← Back to Sign In</a>
</div>

<script>
function getToken() {
  return new URLSearchParams(window.location.search).get('token') || '';
}

async function doReset(e) {
  e.preventDefault();
  const pw   = document.getElementById('pw').value;
  const pw2  = document.getElementById('pw2').value;
  const msg  = document.getElementById('msg');
  const btn  = document.getElementById('btn');

  msg.style.display = 'none';

  if (pw !== pw2) {
    msg.className = 'msg err';
    msg.textContent = 'Passwords do not match';
    msg.style.display = 'block';
    return;
  }

  const token = getToken();
  if (!token) {
    msg.className = 'msg err';
    msg.textContent = 'Invalid or missing reset token — please request a new link';
    msg.style.display = 'block';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Saving…';

  try {
    const r = await fetch('/api/auth/reset-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token, new_password: pw }),
    });
    const data = await r.json();

    if (!r.ok) throw new Error(data.error || 'Reset failed');

    msg.className = 'msg ok';
    msg.textContent = 'Password updated! Redirecting to sign in…';
    msg.style.display = 'block';
    document.getElementById('form').style.display = 'none';

    setTimeout(() => { window.location.href = '/login'; }, 2000);
  } catch(err) {
    msg.className = 'msg err';
    msg.textContent = err.message;
    msg.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Set Password';
  }
}
</script>
</body>
</html>
