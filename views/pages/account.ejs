<%- include('../partials/head', { title: "My Account — BuildLink" }) %>
<%- include('../partials/navbar', { activePage: "", user: locals.user }) %>


<div style="padding-top:64px;min-height:100vh;background:var(--bl-bg)">
  <div class="container-xl py-5">

    <!-- Account Header -->
    <div class="card border-0 shadow-sm mb-4 overflow-hidden" style="border-radius:16px">
      <div style="height:100px;background:var(--bl-navy)"></div>
      <div class="card-body pb-4 px-4">
        <div class="d-flex align-items-end gap-4" style="margin-top:-50px">
          <div class="bl-acc-avatar-wrap flex-shrink-0">
            <img id="acc-avatar" src="https://i.pravatar.cc/100?img=22" alt="Avatar">
            <div class="bl-acc-avatar-overlay">Edit</div>
          </div>
          <div class="pb-2">
            <h4 class="fw-bold mb-1" id="acc-name" style="font-family:'Playfair Display',serif;color:var(--bl-navy)">Loading…</h4>
            <div class="text-muted" id="acc-meta" style="font-size:13px"></div>
          </div>
          <div class="ms-auto pb-2 d-none d-md-flex gap-2">
            <span id="acc-badge" class="badge" style="font-size:11px;padding:6px 12px;display:none"></span>
            <a href="/dashboard" class="btn btn-outline-secondary btn-sm">Dashboard</a>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">

      <!-- Sidebar Tabs -->
      <div class="col-lg-3">
        <div class="card border-0 shadow-sm p-3" style="border-radius:14px;position:sticky;top:80px">
          <button class="bl-acc-tab active" onclick="showTab('profile',this)">Profile Settings</button>
          <button class="bl-acc-tab" onclick="showTab('security',this)">Security</button>
          <button class="bl-acc-tab" onclick="showTab('subscription',this)">Subscription</button>
          <button class="bl-acc-tab" onclick="showTab('saved',this)">Saved Professionals</button>
          <button class="bl-acc-tab" onclick="showTab('notifications',this)">Notifications</button>
          <hr class="my-2">
          <button class="bl-acc-tab" onclick="signOut()" style="color:#c62828">Sign Out</button>
        </div>
      </div>

      <!-- Main Content -->
      <div class="col-lg-9">

        <!-- PROFILE SETTINGS -->
        <div id="tab-profile" class="bl-acc-section active">
          <div class="card border-0 shadow-sm mb-4" style="border-radius:14px">
            <div class="card-body p-4">
              <h5 class="fw-bold mb-1" style="color:var(--bl-navy)">Profile Information</h5>
              <p class="text-muted small mb-4">This information will appear on your public BuildLink profile.</p>
              <div id="profile-ok" class="bl-auth-ok"></div>
              <div id="profile-err" class="bl-auth-err"></div>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-500 small">Full Name</label>
                  <input type="text" id="pf-name" class="form-control" style="border-radius:10px" placeholder="Your full name">
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-500 small">Email Address</label>
                  <input type="email" id="pf-email" class="form-control" style="border-radius:10px" readonly disabled>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-500 small">Phone Number</label>
                  <input type="tel" id="pf-phone" class="form-control" style="border-radius:10px" placeholder="+254 700 000 000">
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-500 small">Location</label>
                  <select id="pf-location" class="form-select" style="border-radius:10px">
                    <option>Nairobi, Kenya</option><option>Mombasa, Kenya</option><option>Kisumu, Kenya</option>
                    <option>Kampala, Uganda</option><option>Dar es Salaam, Tanzania</option><option>Kigali, Rwanda</option>
                    <option>Addis Ababa, Ethiopia</option><option>Other</option>
                  </select>
                </div>
                <div class="col-12">
                  <label class="form-label fw-500 small">Bio / About You</label>
                  <textarea id="pf-bio" class="form-control" rows="4" style="border-radius:10px;resize:none" placeholder="Tell clients and collaborators about your experience, specialisations, and approach…"></textarea>
                  <div class="text-end mt-1"><span id="bio-count" style="font-size:11px;color:var(--bl-muted)">0 / 500</span></div>
                </div>
              </div>
              <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary" onclick="saveProfile()">Save Changes</button>
                <button class="btn btn-outline-secondary" onclick="resetProfile()">Discard</button>
              </div>
            </div>
          </div>

          <!-- Professional Profile Card (shown only if role=professional) -->
          <div id="pro-profile-card" class="card border-0 shadow-sm" style="border-radius:14px;display:none">
            <div class="card-body p-4">
              <h5 class="fw-bold mb-1" style="color:var(--bl-navy)">Professional Details</h5>
              <p class="text-muted small mb-4">Shown on your professional listing page.</p>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-500 small">Trade / Profession</label>
                  <input type="text" id="pf-trade" class="form-control" style="border-radius:10px" readonly disabled>
                </div>
                <div class="col-md-3">
                  <label class="form-label fw-500 small">NCA Grade</label>
                  <input type="text" id="pf-nca" class="form-control" style="border-radius:10px" readonly disabled>
                </div>
                <div class="col-md-3">
                  <label class="form-label fw-500 small">Experience</label>
                  <input type="text" id="pf-exp" class="form-control" style="border-radius:10px" readonly disabled>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-500 small">Hourly Rate (KES)</label>
                  <input type="number" id="pf-rate" class="form-control" style="border-radius:10px" placeholder="e.g. 8500">
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-500 small">Availability</label>
                  <select id="pf-avail" class="form-select" style="border-radius:10px">
                    <option value="1">Available Now</option>
                    <option value="0">Not Available</option>
                  </select>
                </div>
              </div>
              <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary" onclick="saveProfile()">Save Changes</button>
                <a href="/profile" class="btn btn-outline-secondary">View Public Profile →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- SECURITY -->
        <div id="tab-security" class="bl-acc-section">
          <div class="card border-0 shadow-sm mb-4" style="border-radius:14px">
            <div class="card-body p-4">
              <h5 class="fw-bold mb-1" style="color:var(--bl-navy)">Change Password</h5>
              <p class="text-muted small mb-4">Use a strong password of at least 6 characters.</p>
              <div id="pwd-ok" class="bl-auth-ok"></div>
              <div id="pwd-err" class="bl-auth-err"></div>
              <div class="row g-3" style="max-width:480px">
                <div class="col-12">
                  <label class="form-label fw-500 small">Current Password</label>
                  <div class="position-relative">
                    <input type="password" id="sec-current" class="form-control" style="border-radius:10px;padding-right:44px" placeholder="Your current password">
                    <button type="button" class="btn position-absolute end-0 top-50 translate-middle-y pe-3" onclick="togglePwd('sec-current',this)" style="background:none;border:none;color:var(--bl-muted);font-size:12px">Show</button>
                  </div>
                </div>
                <div class="col-12">
                  <label class="form-label fw-500 small">New Password</label>
                  <div class="position-relative">
                    <input type="password" id="sec-new" class="form-control" style="border-radius:10px;padding-right:44px" placeholder="Min. 6 characters">
                    <button type="button" class="btn position-absolute end-0 top-50 translate-middle-y pe-3" onclick="togglePwd('sec-new',this)" style="background:none;border:none;color:var(--bl-muted);font-size:12px">Show</button>
                  </div>
                </div>
                <div class="col-12">
                  <label class="form-label fw-500 small">Confirm New Password</label>
                  <input type="password" id="sec-confirm" class="form-control" style="border-radius:10px" placeholder="Re-enter new password">
                </div>
              </div>
              <button class="btn btn-primary mt-4" onclick="changePassword()">Update Password</button>
            </div>
          </div>

          <div class="card border-0 shadow-sm" style="border-radius:14px">
            <div class="card-body p-4">
              <h5 class="fw-bold mb-1" style="color:var(--bl-navy)">Account Security</h5>
              <p class="text-muted small mb-4">Manage your account's security settings.</p>
              <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
                <div>
                  <div class="fw-600 small">Two-Factor Authentication</div>
                  <div class="text-muted" style="font-size:12px">Add an extra layer of security to your account</div>
                </div>
                <button class="btn btn-sm btn-outline-secondary" onclick="showToast('2FA setup coming soon')">Enable</button>
              </div>
              <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
                <div>
                  <div class="fw-600 small">Active Sessions</div>
                  <div class="text-muted" style="font-size:12px">Manage devices that are signed in to your account</div>
                </div>
                <button class="btn btn-sm btn-outline-secondary" onclick="showToast('Sessions management coming soon')">View</button>
              </div>
              <div class="d-flex align-items-center justify-content-between py-3">
                <div>
                  <div class="fw-600 small text-danger">Delete Account</div>
                  <div class="text-muted" style="font-size:12px">Permanently remove your account and all data</div>
                </div>
                <button class="btn btn-sm btn-outline-danger" onclick="showToast('Please contact support to delete your account','warning')">Request</button>
              </div>
            </div>
          </div>
        </div>

        <!-- SUBSCRIPTION -->
        <div id="tab-subscription" class="bl-acc-section">
          <div class="card border-0 shadow-sm mb-4" style="border-radius:14px">
            <div class="card-body p-4">
              <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                  <h5 class="fw-bold mb-1" style="color:var(--bl-navy)">Current Plan</h5>
                  <p class="text-muted small mb-0">Manage your BuildLink subscription</p>
                </div>
                <span class="badge fs-6 px-3 py-2" id="plan-badge" style="background:var(--bl-navy);color:#fff;border-radius:8px">Starter</span>
              </div>
              <div class="p-4 rounded-3 mb-4" style="background:linear-gradient(135deg,#F5F4F0,#EEF0F8);border:1px solid var(--bl-rule)">
                <div class="row g-3">
                  <div class="col-4 text-center">
                    <div class="fw-bold fs-4" style="color:var(--bl-navy)" id="plan-projects">3</div>
                    <div class="text-muted" style="font-size:11px">Active Projects</div>
                  </div>
                  <div class="col-4 text-center border-start border-end">
                    <div class="fw-bold fs-4" style="color:var(--bl-navy)">∞</div>
                    <div class="text-muted" style="font-size:11px">Professionals</div>
                  </div>
                  <div class="col-4 text-center">
                    <div class="fw-bold fs-4" style="color:var(--bl-navy)">Free</div>
                    <div class="text-muted" style="font-size:11px">Current Cost</div>
                  </div>
                </div>
              </div>
              <div class="row g-3">
                <div class="col-md-4">
                  <div class="card border-0 h-100" style="border-radius:12px;border:2px solid var(--bl-rule)!important;border:2px solid var(--bl-rule)">
                    <div class="card-body p-3 text-center">
                      <div class="fw-bold mb-1" style="color:var(--bl-navy)">Starter</div>
                      <div class="fs-3 fw-800 mb-1" style="font-family:'Playfair Display',serif;color:var(--bl-navy)">Free</div>
                      <div class="text-muted" style="font-size:11px;margin-bottom:12px">Forever</div>
                      <ul class="list-unstyled text-start" style="font-size:12px;color:var(--bl-muted)">
                        <li class="mb-1"><i class="bi bi-check"></i>  3 active projects</li>
                        <li class="mb-1"><i class="bi bi-check"></i>  5 invitations/month</li>
                        <li class="mb-1"><i class="bi bi-check"></i>  Basic analytics</li>
                        <li class="mb-1"><i class="bi bi-check"></i>  Email support</li>
                      </ul>
                      <span class="badge w-100" style="background:var(--bl-navy);color:#fff;border-radius:6px;padding:6px">Current Plan</span>
                    </div>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="card border-0 h-100" style="border-radius:12px;border:2px solid var(--bl-accent)!important">
                    <div class="card-body p-3 text-center position-relative">
                      <span class="badge bg-primary position-absolute top-0 start-50 translate-middle" style="font-size:9px;border-radius:100px">POPULAR</span>
                      <div class="fw-bold mb-1 mt-2" style="color:var(--bl-navy)">Professional</div>
                      <div class="fs-3 fw-800 mb-1" style="font-family:'Playfair Display',serif;color:var(--bl-navy)">KES 2,500</div>
                      <div class="text-muted" style="font-size:11px;margin-bottom:12px">/ month</div>
                      <ul class="list-unstyled text-start" style="font-size:12px;color:var(--bl-muted)">
                        <li class="mb-1"><i class="bi bi-check"></i>  20 active projects</li>
                        <li class="mb-1"><i class="bi bi-check"></i>  Unlimited invitations</li>
                        <li class="mb-1"><i class="bi bi-check"></i>  Advanced analytics</li>
                        <li class="mb-1"><i class="bi bi-check"></i>  Priority support</li>
                        <li class="mb-1"><i class="bi bi-check"></i>  Verified badge</li>
                      </ul>
                      <button class="btn btn-primary w-100" style="border-radius:6px;font-size:12px" onclick="showToast('Upgrade flow coming soon','warning')">Upgrade Now</button>
                    </div>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="card border-0 h-100" style="border-radius:12px;border:2px solid var(--bl-rule)!important">
                    <div class="card-body p-3 text-center">
                      <div class="fw-bold mb-1" style="color:var(--bl-navy)">Enterprise</div>
                      <div class="fs-3 fw-800 mb-1" style="font-family:'Playfair Display',serif;color:var(--bl-navy)">Custom</div>
                      <div class="text-muted" style="font-size:11px;margin-bottom:12px">Tailored pricing</div>
                      <ul class="list-unstyled text-start" style="font-size:12px;color:var(--bl-muted)">
                        <li class="mb-1"><i class="bi bi-check"></i>  Unlimited everything</li>
                        <li class="mb-1"><i class="bi bi-check"></i>  Dedicated account manager</li>
                        <li class="mb-1"><i class="bi bi-check"></i>  Custom integrations</li>
                        <li class="mb-1"><i class="bi bi-check"></i>  SLA guarantee</li>
                        <li class="mb-1"><i class="bi bi-check"></i>  White-label option</li>
                      </ul>
                      <button class="btn btn-outline-secondary w-100" style="border-radius:6px;font-size:12px" onclick="showToast('Contact sales@buildlink.co.ke')">Contact Sales</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- SAVED PROFESSIONALS -->
        <div id="tab-saved" class="bl-acc-section">
          <div class="card border-0 shadow-sm" style="border-radius:14px">
            <div class="card-body p-4">
              <h5 class="fw-bold mb-1" style="color:var(--bl-navy)">Saved Professionals</h5>
              <p class="text-muted small mb-4">Professionals you've bookmarked for future projects.</p>
              <div id="saved-grid" class="row g-3">
                <div class="col-12 text-center text-muted py-5">
                  <div style="font-size:13px">Loading saved professionals…</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- NOTIFICATIONS -->
        <div id="tab-notifications" class="bl-acc-section">
          <div class="card border-0 shadow-sm" style="border-radius:14px">
            <div class="card-body p-4">
              <h5 class="fw-bold mb-1" style="color:var(--bl-navy)">Notification Preferences</h5>
              <p class="text-muted small mb-4">Control how and when BuildLink contacts you.</p>
              <div class="d-flex flex-column gap-0">
                <!-- toggle rows -->
                <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
                  <div>
                    <div class="fw-600 small">Project Updates</div>
                    <div class="text-muted" style="font-size:12px">Progress, milestones, and team activity on your projects</div>
                  </div>
                  <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" checked></div>
                </div>
                <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
                  <div>
                    <div class="fw-600 small">New Messages</div>
                    <div class="text-muted" style="font-size:12px">Receive email when you get a new message</div>
                  </div>
                  <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" checked></div>
                </div>
                <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
                  <div>
                    <div class="fw-600 small">Invoice & Payment Alerts</div>
                    <div class="text-muted" style="font-size:12px">New invoices, approvals, and payment confirmations</div>
                  </div>
                  <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" checked></div>
                </div>
                <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
                  <div>
                    <div class="fw-600 small">Invitation Alerts</div>
                    <div class="text-muted" style="font-size:12px">When professionals accept or decline your project invitations</div>
                  </div>
                  <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" checked></div>
                </div>
                <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
                  <div>
                    <div class="fw-600 small">Material Price Alerts</div>
                    <div class="text-muted" style="font-size:12px">Weekly digest of significant price changes</div>
                  </div>
                  <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox"></div>
                </div>
                <div class="d-flex align-items-center justify-content-between py-3">
                  <div>
                    <div class="fw-600 small">Platform News & Tips</div>
                    <div class="text-muted" style="font-size:12px">New features, best practices, and BuildLink updates</div>
                  </div>
                  <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" checked></div>
                </div>
              </div>
              <button class="btn btn-primary mt-4" onclick="showToast('Notification preferences saved <i class="bi bi-check"></i> ')">Save Preferences</button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Footer -->
<footer class="bl-footer mt-0">
  <div class="container-xl">
    <div class="border-top border-white border-opacity-10 py-3 d-flex justify-content-between flex-wrap gap-2">
      <div class="text-white-50 small">© 2026 BuildLink Technologies Ltd.</div>
      <div class="bl-flive"><span></span>Platform operating normally</div>
    </div>
  </div>
</footer>


<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
<script>
let _originalUser = null;

/* ── Tab switching ── */
function showTab(name, el) {
  document.querySelectorAll('.bl-acc-section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.bl-acc-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('tab-' + name).classList.add('active');
  if (el) el.classList.add('active');
  if (name === 'saved') loadSaved();
}

/* ── Populate from user data ── */
function populateAccount(user) {
  _originalUser = user;
  document.getElementById('acc-name').textContent = user.name || '—';
  document.getElementById('acc-meta').textContent = `${user.email} · ${user.role === 'professional' ? user.trade || 'Professional' : 'Client'} · ${user.location || 'Kenya'}`;
  document.getElementById('acc-avatar').src = user.avatar || `https://i.pravatar.cc/100?img=${user.id % 70 + 1}`;
  if (user.verification_badge) {
    const badge = document.getElementById('acc-badge');
    badge.textContent = user.verification_badge;
    badge.style.display = '';
    badge.style.background = user.verification_badge === 'Elite Pro' ? 'var(--bl-navy)' : '#D4A017';
  }
  // Profile fields
  document.getElementById('pf-name').value     = user.name || '';
  document.getElementById('pf-email').value    = user.email || '';
  document.getElementById('pf-phone').value    = user.phone || '';
  document.getElementById('pf-bio').value      = user.bio || '';
  updateBioCount();
  const locSel = document.getElementById('pf-location');
  for (let o of locSel.options) { if (o.value === user.location) { o.selected = true; break; } }
  // Pro fields
  if (user.role === 'professional') {
    document.getElementById('pro-profile-card').style.display = 'block';
    document.getElementById('pf-trade').value = user.trade || '';
    document.getElementById('pf-nca').value   = user.nca_grade || '';
    document.getElementById('pf-exp').value   = user.experience_years ? `${user.experience_years} years` : '';
    document.getElementById('pf-rate').value  = user.hourly_rate || '';
    document.getElementById('pf-avail').value = user.available ? '1' : '0';
  }
  // Subscription
  const plan = (user.subscription_plan || 'starter').charAt(0).toUpperCase() + (user.subscription_plan || 'starter').slice(1);
  document.getElementById('plan-badge').textContent = plan;
}

function updateBioCount() {
  const v = document.getElementById('pf-bio').value.length;
  document.getElementById('bio-count').textContent = `${v} / 500`;
}
document.getElementById('pf-bio').addEventListener('input', updateBioCount);

/* ── Save profile ── */
async function saveProfile() {
  hideMsg('profile-ok'); hideMsg('profile-err');
  const data = {
    name:     document.getElementById('pf-name').value.trim(),
    phone:    document.getElementById('pf-phone').value.trim() || null,
    location: document.getElementById('pf-location').value,
    bio:      document.getElementById('pf-bio').value.trim() || null,
  };
  if (!data.name) { showMsg('profile-err', 'Name cannot be empty.'); return; }
  const result = await BLApi.updateProfile(data);
  if (!result || result.error) { showMsg('profile-err', result?.error || 'Failed to save. Please try again.'); return; }
  showMsg('profile-ok', 'Profile updated successfully <i class="bi bi-check"></i> ');
  document.getElementById('acc-name').textContent = data.name;
}

function resetProfile() {
  if (_originalUser) populateAccount(_originalUser);
}

/* ── Change password ── */
async function changePassword() {
  hideMsg('pwd-ok'); hideMsg('pwd-err');
  const current = document.getElementById('sec-current').value;
  const newPwd  = document.getElementById('sec-new').value;
  const confirm = document.getElementById('sec-confirm').value;
  if (!current || !newPwd) { showMsg('pwd-err', 'Please fill in all fields.'); return; }
  if (newPwd.length < 6) { showMsg('pwd-err', 'New password must be at least 6 characters.'); return; }
  if (newPwd !== confirm) { showMsg('pwd-err', 'New passwords do not match.'); return; }
  const result = await BLApi.changePassword(current, newPwd);
  if (!result || result.error) { showMsg('pwd-err', result?.error || 'Failed to update password.'); return; }
  showMsg('pwd-ok', 'Password changed successfully <i class="bi bi-check"></i> ');
  document.getElementById('sec-current').value = '';
  document.getElementById('sec-new').value = '';
  document.getElementById('sec-confirm').value = '';
}

/* ── Saved professionals ── */
async function loadSaved() {
  const grid = document.getElementById('saved-grid');
  grid.innerHTML = '<div class="col-12 text-center py-4"><div class="spinner-border text-primary" style="width:24px;height:24px"></div></div>';
  const data = await BLApi.getSavedProfessionals();
  if (!data || data.length === 0) {
    grid.innerHTML = `<div class="col-12 text-center text-muted py-5"><div style="font-size:13px">No saved professionals yet.</div><a href="/professionals.html" class="btn btn-outline-primary btn-sm mt-3">Browse Professionals</a></div>`;
    return;
  }
  grid.innerHTML = data.map(p => `
    <div class="col-md-6 col-lg-4">
      <div class="card border-0 shadow-sm h-100 p-3" style="border-radius:12px">
        <div class="d-flex align-items-center gap-3 mb-2">
          <img src="${p.avatar || 'https://i.pravatar.cc/100?img=1'}" style="width:44px;height:44px;border-radius:50%;object-fit:cover" alt="${p.name}">
          <div class="overflow-hidden">
            <div class="fw-bold text-truncate" style="font-size:13px;color:var(--bl-navy)">${p.name}</div>
            <div class="text-muted text-truncate" style="font-size:10px">${p.trade || ''}</div>
          </div>
        </div>
        <div class="d-flex gap-1 flex-wrap mb-2">
          <span class="badge" style="background:var(--bl-bg);color:var(--bl-muted);font-size:9px">${p.available ? 'Available' : 'Busy'}</span>
          ${p.verification_badge ? `<span class="badge" style="background:var(--bl-accent-light);color:var(--bl-accent);font-size:9px">${p.verification_badge}</span>` : ''}
        </div>
        <div class="d-flex justify-content-between align-items-center mt-auto pt-2" style="border-top:1px solid var(--bl-rule)">
          <span style="font-size:12px;font-weight:700">KES ${(p.hourly_rate||0).toLocaleString()}/hr</span>
          <div class="d-flex gap-1">
            <button class="btn btn-sm btn-outline-danger" style="padding:3px 10px;font-size:11px;border-radius:6px" onclick="unsave(${p.id}, this)">Remove</button>
            <button class="btn btn-sm btn-primary" style="padding:3px 10px;font-size:11px;border-radius:6px" onclick="showToast('Opening message…')">Message</button>
          </div>
        </div>
      </div>
    </div>`).join('');
}

async function unsave(id, btn) {
  btn.disabled = true;
  await BLApi.unsaveProfessional(id);
  btn.closest('.col-md-6').remove();
  showToast('Removed from saved professionals');
}

/* ── Helpers ── */
function showMsg(id, msg) { const el = document.getElementById(id); el.textContent = msg; el.classList.add('show'); }
function hideMsg(id) { document.getElementById(id).classList.remove('show'); }
function togglePwd(id, btn) {
  const inp = document.getElementById(id);
  if (inp.type === 'password') { inp.type = 'text'; btn.textContent = 'Hide'; }
  else { inp.type = 'password'; btn.textContent = 'Show'; }
}

/* ── Load user on page ready ── */
document.addEventListener('bl:user', e => populateAccount(e.detail));
</script>
</body>
</html>
