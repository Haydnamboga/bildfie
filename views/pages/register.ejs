<%- include('../partials/head', { title: "Create Account — Bildfie" }) %>
<%- include('../partials/navbar', { activePage: "", user: locals.user }) %>
<body style="background:#fff;margin:0;padding:0">

<div class="bl-auth-wrap">

  <!-- LEFT — Branding -->
  <div class="bl-auth-left">
    <div class="bl-auth-left-content">
      <a href="/" class="d-flex align-items-center gap-2 text-decoration-none mb-5">
        <div style="width:34px;height:34px;background:var(--bl-accent);border-radius:8px;display:grid;place-items:center;flex-shrink:0">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <span class="bl-auth-brand" style="margin:0;font-size:22px">Bildfie</span>
      </a>
      <div class="bl-auth-tagline">Join thousands of construction professionals and project owners building Africa's future.</div>

      <div class="d-flex flex-column gap-3 mb-5">
        <div>
          <div style="color:#fff;font-size:13px;font-weight:600">Post & Manage Projects</div>
          <div style="color:rgba(255,255,255,.5);font-size:11px">Create projects, invite professionals, track progress in real time</div>
        </div>
        <div>
          <div style="color:#fff;font-size:13px;font-weight:600">Hire Verified Professionals</div>
          <div style="color:rgba(255,255,255,.5);font-size:11px">NCA-licensed engineers, architects, PMs and more — all vetted</div>
        </div>
        <div>
          <div style="color:#fff;font-size:13px;font-weight:600">Source Materials & Equipment</div>
          <div style="color:rgba(255,255,255,.5);font-size:11px">Compare prices, order direct, track delivery — all in the CRM</div>
        </div>
        <div>
          <div style="color:#fff;font-size:13px;font-weight:600">Secure Milestone Payments</div>
          <div style="color:rgba(255,255,255,.5);font-size:11px">Escrow-backed invoices protect both parties on every project</div>
        </div>
      </div>

      <div class="p-4 rounded-3" style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12)">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span style="color:#F9A825;font-size:13px">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <span style="color:rgba(255,255,255,.7);font-size:11px">Trusted by 48,000+ professionals</span>
        </div>
        <div style="color:rgba(255,255,255,.8);font-size:12px;line-height:1.6">Free to join. No hidden fees. Upgrade only when you need more capacity.</div>
      </div>
    </div>
  </div>

  <!-- RIGHT — Form -->
  <div class="bl-auth-right" style="overflow-y:auto;padding:32px 40px">
    <div class="bl-auth-form-wrap">
      <div class="d-flex align-items-center gap-2 mb-4 d-md-none">
        <div style="width:28px;height:28px;background:var(--bl-accent);border-radius:7px;display:grid;place-items:center">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#fff" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <span style="font-family:'Playfair Display',serif;font-size:18px;font-weight:800;color:var(--bl-navy)">Bildfie</span>
      </div>

      <!-- STEP 1 -->
      <div id="step-1">
        <div class="bl-auth-title">Create your account</div>
        <div class="bl-auth-sub">Free forever. No credit card needed.</div>

        <div id="reg-err" class="bl-auth-err"></div>

        <div class="mb-4">
          <div class="fw-600 mb-3" style="font-size:13px;color:var(--bl-navy)">I am a…</div>
          <div class="row g-2">
            <div class="col-6">
              <button type="button" class="bl-role-btn selected" id="role-client" onclick="selectRole('client')">
                <div class="bl-role-lbl">Client / Developer</div>
                <div class="bl-role-sub">I need to hire professionals and manage construction projects</div>
              </button>
            </div>
            <div class="col-6">
              <button type="button" class="bl-role-btn" id="role-professional" onclick="selectRole('professional')">
                <div class="bl-role-lbl">Professional</div>
                <div class="bl-role-sub">I offer construction skills, services, or expertise</div>
              </button>
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-500" style="font-size:13px">Full name *</label>
          <input type="text" id="reg-name" class="form-control" placeholder="John Kariuki" autocomplete="name" required style="border-radius:10px;padding:11px 14px;font-size:14px">
        </div>
        <div class="mb-3">
          <label class="form-label fw-500" style="font-size:13px">Email address *</label>
          <input type="email" id="reg-email" class="form-control" placeholder="you@example.com" autocomplete="email" required style="border-radius:10px;padding:11px 14px;font-size:14px">
        </div>
        <div class="mb-3">
          <label class="form-label fw-500" style="font-size:13px">Phone number</label>
          <input type="tel" id="reg-phone" class="form-control" placeholder="+254 700 000 000" autocomplete="tel" style="border-radius:10px;padding:11px 14px;font-size:14px">
        </div>
        <div class="mb-3">
          <label class="form-label fw-500" style="font-size:13px">Location</label>
          <select id="reg-location" class="form-select" style="border-radius:10px;padding:11px 14px;font-size:14px">
            <option>Nairobi, Kenya</option><option>Mombasa, Kenya</option><option>Kisumu, Kenya</option>
            <option>Kampala, Uganda</option><option>Dar es Salaam, Tanzania</option><option>Kigali, Rwanda</option>
            <option>Addis Ababa, Ethiopia</option><option>Other</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label fw-500" style="font-size:13px">Password *</label>
          <div class="position-relative">
            <input type="password" id="reg-password" class="form-control" placeholder="Min. 6 characters" autocomplete="new-password" required style="border-radius:10px;padding:11px 14px;font-size:14px;padding-right:44px">
            <button type="button" class="btn position-absolute end-0 top-50 translate-middle-y pe-3" onclick="togglePwd('reg-password',this)" tabindex="-1" style="background:none;border:none;color:var(--bl-muted);font-size:12px">Show</button>
          </div>
          <div id="pwd-strength" class="mt-2" style="display:none">
            <div class="d-flex gap-1 mb-1">
              <div class="bl-pwd-bar" id="bar1" style="height:3px;flex:1;border-radius:2px;background:var(--bl-rule)"></div>
              <div class="bl-pwd-bar" id="bar2" style="height:3px;flex:1;border-radius:2px;background:var(--bl-rule)"></div>
              <div class="bl-pwd-bar" id="bar3" style="height:3px;flex:1;border-radius:2px;background:var(--bl-rule)"></div>
            </div>
            <div id="pwd-label" style="font-size:10px;color:var(--bl-muted)"></div>
          </div>
        </div>
        <div class="mb-4">
          <label class="form-label fw-500" style="font-size:13px">Confirm password *</label>
          <input type="password" id="reg-password2" class="form-control" placeholder="Re-enter password" autocomplete="new-password" required style="border-radius:10px;padding:11px 14px;font-size:14px">
        </div>

        <!-- Professional extra fields -->
        <div id="pro-fields" style="display:none">
          <div class="mb-3 p-3 rounded-3" style="background:var(--bl-bg);border:1px solid var(--bl-rule)">
            <div class="fw-600 mb-3" style="font-size:12px;color:var(--bl-navy);text-transform:uppercase;letter-spacing:.06em">Professional Details</div>
            <div class="mb-3">
              <label class="form-label fw-500" style="font-size:12px">Trade / Profession *</label>
              <select id="reg-trade" class="form-select form-select-sm" style="border-radius:8px">
                <option value="">Select your trade</option>
                <option>Architect & Interior Designer</option>
                <option>Civil & Structural Engineer</option>
                <option>MEP Engineer</option>
                <option>Quantity Surveyor</option>
                <option>Project Manager</option>
                <option>Electrical Engineer</option>
                <option>Water & Sanitation Engineer</option>
                <option>Geotechnical Engineer</option>
                <option>Urban Planner</option>
                <option>Landscape Architect</option>
                <option>Interior Designer</option>
                <option>Construction Foreman</option>
                <option>General Contractor</option>
                <option>Subcontractor</option>
                <option>Other</option>
              </select>
            </div>
            <div class="row g-2">
              <div class="col-6">
                <label class="form-label fw-500" style="font-size:12px">NCA Grade</label>
                <select id="reg-nca" class="form-select form-select-sm" style="border-radius:8px">
                  <option value="">Not applicable</option>
                  <option>G1</option><option>G2</option><option>G3</option><option>G4</option><option>G5</option><option>G6</option><option>G7</option><option>G8</option>
                </select>
              </div>
              <div class="col-6">
                <label class="form-label fw-500" style="font-size:12px">Experience (years)</label>
                <input type="number" id="reg-exp" class="form-control form-control-sm" min="0" max="50" placeholder="e.g. 8" style="border-radius:8px">
              </div>
            </div>
          </div>
        </div>

        <div class="mb-4">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="terms-check" required>
            <label class="form-check-label" for="terms-check" style="font-size:12px;color:var(--bl-muted)">
              I agree to Bildfie's <a href="#" class="text-decoration-none" style="color:var(--bl-accent)">Terms of Service</a> and <a href="#" class="text-decoration-none" style="color:var(--bl-accent)">Privacy Policy</a>
            </label>
          </div>
        </div>

        <button type="button" id="reg-btn" class="btn btn-primary w-100 fw-700 mb-4" style="border-radius:10px;padding:12px;font-size:14px" onclick="submitReg()">
          Create Free Account
        </button>

        <div class="text-center" style="font-size:13px;color:var(--bl-muted)">
          Already have an account? <a href="/login" class="fw-700 text-decoration-none" style="color:var(--bl-accent)">Sign in</a>
        </div>
      </div>

      <!-- STEP 2 — Success -->
      <div id="step-2" style="display:none;text-align:center">
        <div class="bl-auth-title mt-4">Welcome to Bildfie!</div>
        <div class="bl-auth-sub" id="success-name">Your account is ready. Let's get you set up.</div>
        <a href="/dashboard" class="btn btn-primary btn-lg w-100 mt-4 fw-700" style="border-radius:10px;padding:14px">
          Go to Dashboard →
        </a>
        <a href="/professionals" class="btn btn-outline-secondary w-100 mt-2" style="border-radius:10px;padding:12px;font-size:13px">
          Browse Professionals first
        </a>
      </div>

    </div>
  </div>
</div>


<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
</body>
</html>
