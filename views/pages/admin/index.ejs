      <a id="nav-superadmin" class="sb-link" onclick="showSection('superadmin')">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M5.34 17.66l-1.41 1.41M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 18.66l1.41-1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 5.34l1.41 1.41"/></svg>
        <span class="sb-lbl">Superadmin</span>
