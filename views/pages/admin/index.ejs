    <!-- GOVERNANCE -->
    <div class="sb-grp sb-lbl" onclick="toggleGrp('grp-gov')" style="cursor:pointer;display:flex;align-items:center;justify-content:space-between">
      <span>Governance</span><span class="grp-arr">▾</span>
    </div>
    <div id="grp-gov" class="sb-grp-items">
      <a id="nav-audit" class="sb-link" onclick="showSection('audit')">
        <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        <span class="sb-lbl">Audit Log</span>
