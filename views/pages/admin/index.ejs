let listingsType = 'materials', listingsPage = 1;

async function loadListings(type, page) {
  listingsType = type || listingsType;
  listingsPage = page || 1;
  ['materials','equipment','transport'].forEach(t => {
    document.getElementById('ltab-'+t).classList.toggle('active', t === listingsType);
  });
  document.getElementById('listings-title').textContent =
    listingsType.charAt(0).toUpperCase() + listingsType.slice(1);

  const thead = document.getElementById('listings-thead');
  if (listingsType === 'materials') {
    thead.innerHTML = '<tr><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Location</th><th>Supplier</th><th>Listed</th><th></th></tr>';
  } else if (listingsType === 'equipment') {
    thead.innerHTML = '<tr><th>Name</th><th>Category</th><th>Daily Rate</th><th>Available</th><th>Location</th><th>Owner</th><th>Listed</th><th></th></tr>';
  } else {
    thead.innerHTML = '<tr><th>Name</th><th>Type</th><th>Rate</th><th>Location</th><th>Owner</th><th>Listed</th><th></th></tr>';
  }

  const tbody = document.getElementById('listings-body');
  tbody.innerHTML = '<tr><td colspan="8" style="padding:20px;text-align:center;color:var(--muted)">Loading…</td></tr>';
  try {
    const { data, total, limit } = await apiFetch('/api/admin/listings?type='+listingsType+'&page='+listingsPage+'&limit=25');
    sectionLoaded.listings = true;
    document.getElementById('listings-count').textContent = total.toLocaleString() + ' listings';
    if (!data.length) {
      tbody.innerHTML = '<tr><td colspan="8" style="padding:20px;text-align:center;color:var(--muted)">No listings found</td></tr>';
      document.getElementById('listings-pager').style.display = 'none'; return;
    }
    if (listingsType === 'materials') {
      tbody.innerHTML = data.map(m => `
        <tr>
          <td style="font-size:12.5px;font-weight:600">${esc(m.name)}</td>
          <td><span class="bdg bdg-neutral">${esc(m.category||'—')}</span></td>
          <td style="font-size:12px;font-weight:500">KES ${Number(m.price).toLocaleString()}</td>
          <td><span class="bdg ${m.stock_status==='in'?'bdg-ok':'bdg-err'}">${esc(m.stock_status||'—')}</span></td>
          <td style="font-size:11.5px">${esc(m.location||'—')}</td>
          <td style="font-size:11.5px">${esc(m.owner_name||'—')}</td>
          <td style="font-size:11px;color:var(--muted)">${fmtDate(m.created_at)}</td>
          <td><button onclick="deleteListing('materials',${m.id})"
              style="background:#fef2f2;color:#dc2626;border:1px solid #fca5a5;border-radius:6px;font-size:10.5px;padding:3px 9px;cursor:pointer">Remove</button></td>
        </tr>`).join('');
    } else if (listingsType === 'equipment') {
      tbody.innerHTML = data.map(e => `
        <tr>
          <td style="font-size:12.5px;font-weight:600">${esc(e.name)}</td>
          <td><span class="bdg bdg-neutral">${esc(e.category||'—')}</span></td>
          <td style="font-size:12px">KES ${Number(e.daily_rate).toLocaleString()}/day</td>
          <td>${e.available ? '<span class="bdg bdg-ok">Yes</span>' : '<span class="bdg bdg-err">No</span>'}</td>
          <td style="font-size:11.5px">${esc(e.location||'—')}</td>
          <td style="font-size:11.5px">${esc(e.owner_name||'—')}</td>
          <td style="font-size:11px;color:var(--muted)">${fmtDate(e.created_at)}</td>
          <td><button onclick="deleteListing('equipment',${e.id})"
              style="background:#fef2f2;color:#dc2626;border:1px solid #fca5a5;border-radius:6px;font-size:10.5px;padding:3px 9px;cursor:pointer">Remove</button></td>
        </tr>`).join('');
    } else {
      tbody.innerHTML = data.map(t => `
        <tr>
          <td style="font-size:12.5px;font-weight:600">${esc(t.name)}</td>
          <td style="font-size:12px">${esc(t.type||'—')}</td>
          <td style="font-size:12px">${esc(t.rate_text||'—')}</td>
          <td style="font-size:11.5px">${esc(t.location||'—')}</td>
          <td style="font-size:11.5px">${esc(t.owner_name||'—')}</td>
          <td style="font-size:11px;color:var(--muted)">${fmtDate(t.created_at)}</td>
          <td><button onclick="deleteListing('transport',${t.id})"
              style="background:#fef2f2;color:#dc2626;border:1px solid #fca5a5;border-radius:6px;font-size:10.5px;padding:3px 9px;cursor:pointer">Remove</button></td>
        </tr>`).join('');
    }
    // listings uses custom prev/next since type must be passed
    const lp = document.getElementById('listings-pager');
    const lt = Math.ceil(total/limit);
    if (lt <= 1) { lp.style.display='none'; } else {
      lp.style.display='flex';
      lp.innerHTML = '<span style="font-size:11px;color:var(--muted)">Page '+listingsPage+' of '+lt+'</span>' +
        '<div style="display:flex;gap:6px">' +
        (listingsPage>1 ? '<button onclick="loadListings(\''+listingsType+'\','+(listingsPage-1)+')" style="'+pagerBtn+'">← Prev</button>' : '') +
        (listingsPage<lt ? '<button onclick="loadListings(\''+listingsType+'\','+(listingsPage+1)+')" style="'+pagerBtn+'">Next →</button>' : '') +
        '</div>';
    }
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="8" style="padding:20px;text-align:center;color:#dc2626">'+esc(e.message)+'</td></tr>';
  }
}

async function deleteListing(type, id) {
  if (!confirm('Remove this '+type+' listing? This cannot be undone.')) return;
  try {
    const r = await apiCall('DELETE', '/api/admin/listings/'+type+'/'+id, {});
    toast(r.message);
    loadListings(listingsType, listingsPage);
  } catch(e) { toast(e.message, true); }
}

