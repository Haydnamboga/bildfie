<%- include('../../partials/head', { title: 'Admin — Bildfie', extraHead: `
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
<style>
:root {
  --sb-w: 220px; --tb-h: 54px;
  --sb-bg: #0c1428; --sb-bg2: #111d38; --sb-border: rgba(255,255,255,.06);
  --sb-text: rgba(255,255,255,.78); --sb-muted: rgba(255,255,255,.38);
  --sb-hover: rgba(255,255,255,.05); --sb-active-bg: rgba(196,49,0,.14);
  --sb-active-border: #C43100; --accent: #C43100; --navy: #011D47;
  --bg: #f2f4f8; --card: #fff; --rule: #e4e7ef; --muted: #6b7280; --text: #1e293b;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Sora',sans-serif;background:var(--bg);color:var(--text);font-size:13px}

/* SIDEBAR */
#sb{position:fixed;top:0;left:0;width:var(--sb-w);height:100vh;background:var(--sb-bg);z-index:400;
    display:flex;flex-direction:column;overflow:hidden;transition:width .25s}
#sb.collapsed{width:54px}
#sb.collapsed .sb-lbl,#sb.collapsed .sb-logo-txt,#sb.collapsed .sb-badge{display:none!important}
#sb.collapsed .sb-link{justify-content:center;padding:9px 0}

.sb-logo{display:flex;align-items:center;gap:10px;padding:15px 16px 13px;
         border-bottom:1px solid var(--sb-border);text-decoration:none;flex-shrink:0}
.sb-logo-mark{width:28px;height:28px;border-radius:7px;background:var(--accent);
              display:grid;place-items:center;flex-shrink:0}
.sb-logo-mark svg{width:14px;height:14px;fill:none;stroke:#fff;stroke-width:2.3;stroke-linecap:round}
.sb-logo-name{font-family:'Playfair Display',serif;font-size:14px;font-weight:800;color:#fff;line-height:1}
.sb-logo-sub{font-size:8px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-top:2px}

.sb-nav{flex:1;overflow-y:auto;padding:8px 0 16px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.08) transparent}
.sb-nav::-webkit-scrollbar{width:3px}
.sb-nav::-webkit-scrollbar-thumb{background:rgba(255,255,255,.1);border-radius:3px}
.sb-grp{font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
        color:var(--sb-muted);padding:13px 16px 3px}
.sb-link{display:flex;align-items:center;gap:9px;padding:8px 16px;color:var(--sb-text);
         font-size:12px;font-weight:500;cursor:pointer;border-left:3px solid transparent;
         text-decoration:none;transition:background .12s,border-color .12s,color .12s;user-select:none}
.sb-link:hover{background:var(--sb-hover);color:#fff}
.sb-link.active{background:var(--sb-active-bg);border-left-color:var(--sb-active-border);color:#fff;font-weight:600}
.sb-link svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;flex-shrink:0;opacity:.75}
.sb-badge{margin-left:auto;background:var(--accent);color:#fff;font-size:9px;font-weight:700;
          padding:2px 6px;border-radius:100px;min-width:18px;text-align:center}
.sb-div{height:1px;background:var(--sb-border);margin:8px 16px}
.sb-footer{padding:10px 14px;border-top:1px solid var(--sb-border);flex-shrink:0}
.sb-user{display:flex;align-items:center;gap:9px}
.sb-avatar{width:28px;height:28px;border-radius:50%;background:var(--accent);color:#fff;
           display:grid;place-items:center;font-size:11px;font-weight:700;flex-shrink:0}

/* TOPBAR */
#tb{position:fixed;top:0;left:var(--sb-w);right:0;height:var(--tb-h);background:var(--card);
    border-bottom:1px solid var(--rule);z-index:300;display:flex;align-items:center;
    padding:0 20px;gap:12px;transition:left .25s}
#sb.collapsed~#tb{left:54px}
#sb.collapsed~#tb~#main{margin-left:54px}
.tb-toggle{width:30px;height:30px;border:1px solid var(--rule);border-radius:7px;background:none;
           cursor:pointer;display:grid;place-items:center;flex-shrink:0;color:var(--muted);transition:background .12s}
.tb-toggle:hover{background:var(--bg)}
.tb-toggle svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}
.tb-bc{font-size:10.5px;color:var(--muted)}
.tb-bc strong{font-size:13px;font-weight:700;color:var(--navy)}
.tb-right{display:flex;align-items:center;gap:8px;margin-left:auto}
.tb-user{display:flex;align-items:center;gap:7px;padding:4px 8px;border-radius:8px;cursor:default}
.tb-user-name{font-size:12px;font-weight:600;color:var(--navy)}
.tb-user-role{font-size:9.5px;color:var(--muted)}
.tb-avatar{width:28px;height:28px;border-radius:50%;background:var(--navy);color:#fff;
           display:grid;place-items:center;font-size:11px;font-weight:700;flex-shrink:0}

/* MAIN */
#main{margin-left:var(--sb-w);padding-top:var(--tb-h);min-height:100vh;transition:margin-left .25s}
.adm-page{padding:20px 22px}
.pg-head{margin-bottom:18px}
.pg-head h1{font-size:18px;font-weight:700;color:var(--navy);line-height:1.2}
.pg-head p{font-size:11.5px;color:var(--muted);margin-top:3px}
.pg-row{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap}

/* KPI */
.kpi{background:var(--card);border-radius:12px;padding:16px 18px;border:1px solid var(--rule);height:100%}
.kpi-icon{width:38px;height:38px;border-radius:9px;display:grid;place-items:center;margin-bottom:10px}
.kpi-icon svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round}
.kpi-val{font-family:'Playfair Display',serif;font-size:22px;font-weight:800;color:var(--navy);line-height:1}
.kpi-lbl{font-size:10px;color:var(--muted);margin-top:3px;text-transform:uppercase;letter-spacing:.07em}

/* CARD */
.card2{background:var(--card);border:1px solid var(--rule);border-radius:12px;overflow:hidden}
.card2-head{padding:13px 16px;border-bottom:1px solid var(--rule);display:flex;align-items:center;justify-content:space-between}
.card2-title{font-size:12.5px;font-weight:700;color:var(--navy)}
.card2-action{font-size:11px;color:var(--accent);font-weight:600;cursor:pointer}
.card2-action:hover{text-decoration:underline}

/* TABLE */
.adm-tbl{width:100%;border-collapse:collapse}
.adm-tbl th{padding:8px 13px;font-size:9.5px;font-weight:700;text-transform:uppercase;
            letter-spacing:.09em;color:var(--muted);background:var(--bg);
            border-bottom:1px solid var(--rule);text-align:left}
.adm-tbl td{padding:10px 13px;border-bottom:1px solid var(--rule);color:var(--text);vertical-align:middle}
.adm-tbl tr:last-child td{border-bottom:none}
.adm-tbl tbody tr:hover td{background:#fafbfd}

/* BADGES */
.bdg{display:inline-flex;align-items:center;padding:2px 7px;border-radius:100px;font-size:9.5px;font-weight:600;white-space:nowrap}
.bdg-admin{background:#eff6ff;color:#1e40af}
.bdg-professional{background:#f0fdf4;color:#166534}
.bdg-client{background:#f9fafb;color:#6b7280;border:1px solid var(--rule)}
.bdg-supplier{background:#fefce8;color:#854d0e}
.bdg-banned{background:#fef2f2;color:#991b1b}
.bdg-ok{background:#f0fdf4;color:#166534}
.bdg-pending{background:#fff7ed;color:#9a3412}
.bdg-done{background:#eff6ff;color:#1e40af}
.bdg-neutral{background:#f9fafb;color:#6b7280;border:1px solid var(--rule)}
.bdg-err{background:#fef2f2;color:#991b1b}

/* VTABS */
.vtab{padding:5px 14px;border:1px solid var(--rule);border-radius:7px;background:#fff;
      color:var(--muted);font-size:11.5px;font-weight:600;cursor:pointer;transition:background .12s}
.vtab.active{background:var(--navy);color:#fff;border-color:var(--navy)}

/* MODAL */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:900;
               overflow-y:auto;padding:32px 16px}
.modal-box{background:#fff;border-radius:14px;max-width:680px;margin:0 auto;overflow:hidden;
           box-shadow:0 20px 60px rgba(0,0,0,.3)}
.modal-head{background:var(--navy);padding:18px 22px;display:flex;align-items:center;gap:13px}
.modal-head-info{flex:1}
.modal-head-name{font-size:15px;font-weight:700;color:#fff}
.modal-head-email{font-size:11px;color:rgba(255,255,255,.6);margin-top:2px}
.modal-close{background:none;border:none;color:rgba(255,255,255,.5);cursor:pointer;
             font-size:20px;line-height:1;padding:2px 6px}
.modal-close:hover{color:#fff}
.modal-body{padding:18px 22px;max-height:65vh;overflow-y:auto}
.modal-foot{padding:14px 22px;border-top:1px solid var(--rule);background:var(--bg);
            display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-bottom:18px}
.info-item label{display:block;font-size:9.5px;color:var(--muted);text-transform:uppercase;
                 letter-spacing:.06em;margin-bottom:2px}
.info-item span{font-size:12.5px;font-weight:500}
.sec-hd{font-size:11.5px;font-weight:700;color:var(--navy);border-bottom:1px solid var(--rule);
         padding-bottom:6px;margin-bottom:10px}
.pw-box{background:var(--bg);border-radius:9px;padding:12px 14px;margin-bottom:18px}

/* ALERT */
.adm-alert{background:#fff7ed;border:1px solid #fed7aa;border-radius:9px;padding:10px 14px;
           font-size:12px;color:#9a3412;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.adm-alert a{color:var(--accent);font-weight:600;cursor:pointer;text-decoration:underline}

/* TOAST */
#toast{position:fixed;bottom:20px;right:20px;padding:10px 18px;border-radius:9px;color:#fff;
       font-size:12.5px;font-weight:600;z-index:9999;display:none;max-width:320px;
       box-shadow:0 4px 20px rgba(0,0,0,.25)}

/* MINI STAT */
.mini-stat{background:var(--card);border:1px solid var(--rule);border-radius:10px;
           padding:13px 15px;display:flex;align-items:center;gap:11px}
.mini-ico{width:34px;height:34px;border-radius:8px;display:grid;place-items:center;flex-shrink:0}
.mini-ico svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}
.mini-val{font-size:17px;font-weight:800;color:var(--navy);line-height:1}
.mini-lbl{font-size:10px;color:var(--muted);margin-top:2px}

/* INPUT */
.adm-input{padding:7px 10px;border:1px solid var(--rule);border-radius:7px;font-size:12px;
           font-family:'Sora',sans-serif;background:#fff;color:var(--text);outline:none}
.adm-input:focus{border-color:#94a3b8}
.adm-select{padding:7px 10px;border:1px solid var(--rule);border-radius:7px;font-size:12px;
            font-family:'Sora',sans-serif;background:#fff;color:var(--text);outline:none;cursor:pointer}

/* PAGER */
.pager{padding:11px 16px;border-top:1px solid var(--rule);display:flex;justify-content:space-between;
       align-items:center;font-size:11px;color:var(--muted)}

/* PROG */
.prog{height:4px;background:var(--rule);border-radius:4px;overflow:hidden;margin-top:4px}
.prog-fill{height:100%;border-radius:4px}

/* RESPONSIVE */
@media(max-width:991px){
  #sb{transform:translateX(-100%);transition:transform .25s}
  #sb.mob-open{transform:translateX(0)}
  #tb,#main{left:0!important;margin-left:0!important}
}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-thumb{background:#d1d5db;border-radius:4px}
</style>
` }) %>

<body>

<!-- ════════════════════════════════════════════════════════════════
     SIDEBAR
════════════════════════════════════════════════════════════════ -->
<aside id="sb">
  <a href="/" class="sb-logo">
    <div class="sb-logo-mark">
      <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    </div>
    <div class="sb-logo-txt">
      <div class="sb-logo-name">Bildfie</div>
      <div class="sb-logo-sub">Admin Panel</div>
    </div>
  </a>

  <nav class="sb-nav">
    <div class="sb-grp sb-lbl">Platform</div>

    <a id="nav-overview" class="sb-link active" onclick="showSection('overview')">
      <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      <span class="sb-lbl">Overview</span>
    </a>

    <a id="nav-users" class="sb-link" onclick="showSection('users')">
      <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
      <span class="sb-lbl">Users</span>
    </a>

    <a id="nav-finance" class="sb-link" onclick="showSection('finance')">
      <svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
      <span class="sb-lbl">Finance</span>
    </a>

    <a id="nav-verifications" class="sb-link" onclick="showSection('verifications')">
      <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <span class="sb-lbl">Verifications</span>
      <span class="sb-badge" id="sb-verif-badge" style="display:none">0</span>
    </a>

    <a id="nav-bids" class="sb-link" onclick="showSection('bids')">
      <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
      <span class="sb-lbl">Bids</span>
    </a>

    <a id="nav-analytics" class="sb-link" onclick="showSection('analytics')">
      <svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      <span class="sb-lbl">Analytics</span>
    </a>

    <div class="sb-div"></div>

    <a href="/" class="sb-link" style="opacity:.65">
      <svg viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      <span class="sb-lbl">View Site</span>
    </a>
    <a href="/api/auth/logout" class="sb-link" style="opacity:.65">
      <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      <span class="sb-lbl">Logout</span>
    </a>
  </nav>

  <div class="sb-footer">
    <div class="sb-user">
      <div class="sb-avatar"><%= user ? user.name.charAt(0).toUpperCase() : 'A' %></div>
      <div class="sb-lbl">
        <div style="font-size:11.5px;font-weight:600;color:rgba(255,255,255,.85)"><%= user ? user.name : 'Admin' %></div>
        <div style="font-size:9.5px;color:var(--sb-muted)">Super Admin</div>
      </div>
    </div>
  </div>
</aside>

<!-- ════════════════════════════════════════════════════════════════
     TOPBAR
════════════════════════════════════════════════════════════════ -->
<header id="tb">
  <button class="tb-toggle" onclick="toggleSidebar()">
    <svg viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
  <div>
    <div class="tb-bc">Admin / <strong id="bc-section">Overview</strong></div>
  </div>
  <div class="tb-right">
    <div style="font-size:11px;color:var(--muted)" id="tb-date"></div>
    <div style="width:1px;height:20px;background:var(--rule)"></div>
    <div class="tb-user">
      <div class="tb-avatar"><%= user ? user.name.charAt(0).toUpperCase() : 'A' %></div>
      <div>
        <div class="tb-user-name"><%= user ? user.name : 'Admin' %></div>
        <div class="tb-user-role">Super Admin</div>
      </div>
    </div>
  </div>
</header>

<!-- ════════════════════════════════════════════════════════════════
     MAIN
════════════════════════════════════════════════════════════════ -->
<main id="main">

<!-- ─── OVERVIEW ─── -->
<div id="sec-overview" class="adm-page">
  <div class="pg-head">
    <h1>Dashboard Overview</h1>
    <p id="pg-date">Loading…</p>
  </div>

  <div id="verif-alert" class="adm-alert" style="display:none">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span><strong id="verif-alert-count">0</strong> verification document(s) are waiting for your review.</span>
    <a onclick="showSection('verifications')">Review now →</a>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
      <div class="kpi">
        <div class="kpi-icon" style="background:#eff6ff;color:#2563eb">
          <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
        </div>
        <div class="kpi-val" id="kpi-users">—</div>
        <div class="kpi-lbl">Total Users</div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="kpi">
        <div class="kpi-icon" style="background:#f0fdf4;color:#16a34a">
          <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
        </div>
        <div class="kpi-val" id="kpi-profs">—</div>
        <div class="kpi-lbl">Professionals</div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="kpi">
        <div class="kpi-icon" style="background:#fef3c7;color:#d97706">
          <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
        </div>
        <div class="kpi-val" id="kpi-revenue">—</div>
        <div class="kpi-lbl">Total Revenue</div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="kpi">
        <div class="kpi-icon" style="background:#fdf4ff;color:#9333ea">
          <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <div class="kpi-val" id="kpi-bids">—</div>
        <div class="kpi-lbl">Total Bids</div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
      <div class="mini-stat">
        <div class="mini-ico" style="background:#fff7ed;color:#ea580c">
          <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <div><div class="mini-val" id="kpi-projects">—</div><div class="mini-lbl">Projects</div></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="mini-stat">
        <div class="mini-ico" style="background:#eff6ff;color:#2563eb">
          <svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        </div>
        <div><div class="mini-val" id="kpi-txns">—</div><div class="mini-lbl">Transactions</div></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="mini-stat">
        <div class="mini-ico" style="background:#fef2f2;color:#dc2626">
          <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div><div class="mini-val" id="kpi-pending-verifs">—</div><div class="mini-lbl">Pending Verifs</div></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="mini-stat">
        <div class="mini-ico" style="background:#f0fdf4;color:#16a34a">
          <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <div><div class="mini-val" style="font-size:13px" id="kpi-revenue2">—</div><div class="mini-lbl">KES Revenue</div></div>
