/* ── Pagination helper ────────────────────────────────────────────── */
const pagerBtn = 'padding:4px 10px;border:1px solid var(--rule);border-radius:6px;background:#fff;font-size:10.5px;cursor:pointer';
function renderPager(id, page, total, fn) {
  const el = document.getElementById(id);
  if (total <= 1) { el.style.display='none'; return; }
  el.style.display = 'flex';
  el.innerHTML = '<span style="font-size:11px;color:var(--muted)">Page '+page+' of '+total+'</span>' +
    '<div style="display:flex;gap:6px">' +
    (page > 1     ? '<button onclick="'+fn+'('+(page-1)+')" style="'+pagerBtn+'">← Prev</button>' : '') +
    (page < total ? '<button onclick="'+fn+'('+(page+1)+')" style="'+pagerBtn+'">Next →</button>' : '') +
    '</div>';
}

