let talentPage = 1, talentDebounce;
function debounceTalent() { clearTimeout(talentDebounce); talentDebounce = setTimeout(() => loadTalent(1), 420); }

async function loadTalent(page) {
  talentPage = page || 1;
  const search = document.getElementById('talent-search').value.trim();
  const trade  = document.getElementById('talent-trade').value;
  const avail  = document.getElementById('talent-avail').value;
  const params = new URLSearchParams({ page: talentPage, limit: 25, search, trade, available: avail });
  const tbody  = document.getElementById('talent-body');
  tbody.innerHTML = '<tr><td colspan="9" style="padding:20px;text-align:center;color:var(--muted)">Loading…</td></tr>';
  try {
    const { professionals, total, limit, trades } = await apiFetch('/api/admin/professionals?' + params);
    sectionLoaded.talent = true;
    document.getElementById('talent-count').textContent = total.toLocaleString() + ' professionals';
    // Populate trade filter first time
    const sel = document.getElementById('talent-trade');
    if (sel.options.length <= 1 && trades) {
      trades.forEach(t => { const o = new Option(t, t); sel.add(o); });
    }
    if (!professionals.length) {
      tbody.innerHTML = '<tr><td colspan="9" style="padding:20px;text-align:center;color:var(--muted)">No professionals found</td></tr>';
      document.getElementById('talent-pager').style.display = 'none'; return;
    }
    tbody.innerHTML = professionals.map(p => `
      <tr style="cursor:pointer" onclick="openUserModal(${p.id})">
        <td>
          <div style="display:flex;align-items:center;gap:8px">
            <div style="width:28px;height:28px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font-size:10px;font-weight:700;flex-shrink:0">
              ${esc(p.name.charAt(0).toUpperCase())}
            </div>
            <div>
              <div style="font-size:12px;font-weight:600;color:var(--navy)">${esc(p.name)}</div>
              <div style="font-size:10px;color:var(--muted)">${esc(p.email)}</div>
            </div>
          </div>
        </td>
        <td><span class="bdg bdg-neutral">${esc(p.trade)}</span></td>
        <td style="font-size:12px">${esc(p.nca_grade||'—')}</td>
        <td style="font-size:12px">${p.hourly_rate ? 'KES '+Number(p.hourly_rate).toLocaleString() : '—'}</td>
        <td style="text-align:center;font-size:12px">${p.jobs_done||0}</td>
