══════════════════════════════════════════════════════════════════ */
async function loadCrm() {
  sectionLoaded.crm = true;
  const tbody = document.getElementById('crm-body');
  try {
    const d = await apiFetch('/api/admin/crm');
    document.getElementById('crm-clients').textContent   = d.clients.toLocaleString();
    document.getElementById('crm-suppliers').textContent = d.suppliers.toLocaleString();
    document.getElementById('crm-projects').textContent  = d.active_projects.toLocaleString();
    document.getElementById('crm-bids').textContent      = d.open_bids.toLocaleString();

    if (!d.top_clients.length) {
      tbody.innerHTML = '<tr><td colspan="6" style="padding:20px;text-align:center;color:var(--muted)">No client data yet</td></tr>'; return;
    }
    tbody.innerHTML = d.top_clients.map(c => `
      <tr>
        <td>
          <div style="display:flex;align-items:center;gap:8px">
            <div style="width:28px;height:28px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font-size:10px;font-weight:700;flex-shrink:0">
              ${esc(c.name.charAt(0).toUpperCase())}
            </div>
            <span style="font-size:12.5px;font-weight:600;color:var(--navy)">${esc(c.name)}</span>
          </div>
        </td>
        <td style="font-size:11.5px;color:var(--muted)">${esc(c.email)}</td>
        <td style="font-size:11.5px">${esc(c.location||'—')}</td>
        <td style="text-align:center">
          <span style="background:#eff6ff;color:#1e40af;padding:2px 10px;border-radius:100px;font-size:11px;font-weight:700">
            ${c.project_count}
          </span>
        </td>
        <td style="font-size:11px;color:var(--muted)">${fmtDate(c.created_at)}</td>
        <td>
          <button onclick="openUserModal(${c.id})"
                  style="background:var(--navy);color:#fff;border:none;border-radius:6px;font-size:10.5px;padding:3px 10px;cursor:pointer">View</button>
        </td>
      </tr>`).join('');
  } catch(e) { toast('CRM load failed: '+e.message, true); }
}

/* ══════════════════════════════════════════════════════════════════
   COMMUNICATIONS
══════════════════════════════════════════════════════════════════ */
async function loadComms() {
  sectionLoaded.comms = true;
  try {
    const d = await apiFetch('/api/admin/messages/stats');
    document.getElementById('comms-total').textContent  = d.total.toLocaleString();
    document.getElementById('comms-unread').textContent = d.unread.toLocaleString();

    const tbody = document.getElementById('comms-body');
    if (!d.recent.length) {
      tbody.innerHTML = '<tr><td colspan="5" style="padding:20px;text-align:center;color:var(--muted)">No messages yet</td></tr>'; return;
    }
    tbody.innerHTML = d.recent.map(m => `
      <tr>
        <td style="font-size:12px;font-weight:600">${esc(m.sender_name)}</td>
        <td style="font-size:12px">${esc(m.recipient_name)}</td>
        <td style="font-size:11.5px;max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--muted)">
          ${esc(m.content)}
        </td>
        <td style="font-size:11px;color:var(--muted)">${fmtDate(m.created_at)}</td>
        <td>${m.read ? '<span class="bdg bdg-neutral">Read</span>' : '<span class="bdg bdg-pending">Unread</span>'}</td>
      </tr>`).join('');
  } catch(e) { toast('Comms load failed: '+e.message, true); }
}

function toggleBcAll(cb) {
  document.querySelectorAll('.bc-role').forEach(r => { r.disabled = cb.checked; r.checked = false; });
}

async function doBroadcast() {
  const title = document.getElementById('bc-title').value.trim();
  const body  = document.getElementById('bc-body').value.trim();
  if (!title || !body) { toast('Title and body are required', true); return; }

  const allUsers = document.getElementById('bc-all').checked;
  const roles = allUsers ? [] :
    Array.from(document.querySelectorAll('.bc-role:checked')).map(el => el.value);
  if (!allUsers && !roles.length) { toast('Select at least one recipient group', true); return; }

  if (!confirm((allUsers ? 'Send to ALL users?' : 'Send to: '+roles.join(', ')+'?') + ' This will create a notification for each user.')) return;
  try {
    const r = await apiCall('POST', '/api/admin/notifications/broadcast', { title, body, roles });
    toast(r.message);
    document.getElementById('bc-title').value = '';
    document.getElementById('bc-body').value  = '';
  } catch(e) { toast(e.message, true); }
}

/* ══════════════════════════════════════════════════════════════════
   GROWTH
══════════════════════════════════════════════════════════════════ */
async function loadGrowth() {
  sectionLoaded.growth = true;
  try {
    const d = await apiFetch('/api/admin/growth');
    document.getElementById('grw-users').textContent    = d.new_users.toLocaleString();
    document.getElementById('grw-bids').textContent     = d.new_bids.toLocaleString();
    document.getElementById('grw-projects').textContent = d.new_projects.toLocaleString();
    document.getElementById('grw-apps').textContent     = d.applications.toLocaleString();

    // Role breakdown bars
    const rolesEl = document.getElementById('grw-roles-body');
    const total   = d.role_breakdown.reduce((s, r) => s + Number(r.cnt), 0);
    rolesEl.innerHTML = d.role_breakdown.map(r => {
      const pct = total ? Math.round(Number(r.cnt)/total*100) : 0;
      const colors = {admin:'#1e40af',professional:'#16a34a',client:'#6b7280',supplier:'#854d0e',banned:'#991b1b'};
      const c = colors[r.role] || '#9ca3af';
      return `
        <div style="margin-bottom:10px">
          <div style="display:flex;justify-content:space-between;font-size:11.5px;margin-bottom:3px">
            <span style="font-weight:600;text-transform:capitalize">${esc(r.role)}</span>
            <span style="color:var(--muted)">${Number(r.cnt).toLocaleString()} (${pct}%)</span>
          </div>
          <div class="prog"><div class="prog-fill" style="width:${pct}%;background:${c}"></div></div>
        </div>`;
    }).join('');

    // Top trades
    const tradesEl = document.getElementById('grw-trades-body');
    const maxCnt   = d.top_trades.reduce((m, t) => Math.max(m, Number(t.cnt)), 1);
    tradesEl.innerHTML = d.top_trades.map(t => {
      const pct = Math.round(Number(t.cnt)/maxCnt*100);
      return `
        <div style="margin-bottom:9px">
          <div style="display:flex;justify-content:space-between;font-size:11.5px;margin-bottom:3px">
            <span style="font-weight:600">${esc(t.trade)}</span>
            <span style="color:var(--muted)">${Number(t.cnt).toLocaleString()}</span>
          </div>
          <div class="prog"><div class="prog-fill" style="width:${pct}%;background:var(--accent)"></div></div>
        </div>`;
    }).join('') || '<div style="font-size:12px;color:var(--muted)">No trade data yet</div>';

  } catch(e) { toast('Growth load failed: '+e.message, true); }
}

/* ══════════════════════════════════════════════════════════════════
   AUDIT LOG
══════════════════════════════════════════════════════════════════ */
async function loadAudit() {
  sectionLoaded.audit = true;
  const el = document.getElementById('audit-body');
  el.innerHTML = '<div style="padding:24px;text-align:center;color:var(--muted)">Loading…</div>';
  try {
    const events = await apiFetch('/api/admin/audit?limit=80');
    if (!events.length) {
      el.innerHTML = '<div style="padding:24px;text-align:center;color:var(--muted)">No audit events yet</div>'; return;
    }
    const icons = {
      verification: '✓', payment: '💳', user_registered: '👤', bid_posted: '📋',
    };
    const colors = {
      verification: '#16a34a', payment: '#2563eb', user_registered: '#9333ea', bid_posted: '#d97706',
    };
    el.innerHTML = events.map(e => `
      <div style="display:flex;align-items:flex-start;gap:12px;padding:10px 16px;border-bottom:1px solid var(--rule)">
        <div style="width:28px;height:28px;border-radius:50%;background:${colors[e.event_type]||'#6b7280'}20;
                    color:${colors[e.event_type]||'#6b7280'};display:grid;place-items:center;
                    font-size:12px;flex-shrink:0;margin-top:1px">
          ${icons[e.event_type]||'·'}
        </div>
        <div style="flex:1">
          <div style="font-size:12px;font-weight:600;color:var(--text)">${esc(e.subject||'—')}</div>
          <div style="font-size:11px;color:var(--muted);margin-top:2px">
            ${esc(e.detail||'—')}
            ${e.actor ? ' · by <strong>'+esc(e.actor)+'</strong>' : ''}
          </div>
        </div>
        <div style="font-size:10.5px;color:var(--muted);white-space:nowrap;flex-shrink:0">
          ${fmtDate(e.ts)}
        </div>
      </div>`).join('');
  } catch(e) {
    el.innerHTML = '<div style="padding:24px;text-align:center;color:#dc2626">'+esc(e.message)+'</div>';
  }
}

