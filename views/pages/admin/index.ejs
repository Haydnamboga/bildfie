let currentUserId = null, currentUserData = null;
let usersPage = 1, finPage = 1, bidsPage = 1;
let usersSearch = '', finSearch = '';
let sectionLoaded = {};
let verifStatus = 'pending';
let globalStats = null;
let bidsCache = {};
let aCharts = {};
let userDebounce, finDebounce;

/* ── API helpers ──────────────────────────────────────────────────── */
async function apiFetch(url) {
  const r = await fetch(url);
  const data = await r.json();
  if (!r.ok) throw new Error(data.error || 'Request failed');
  return data;
}
async function apiCall(method, url, body) {
  const r = await fetch(url, {
    method,
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  const data = await r.json();
  if (!r.ok) throw new Error(data.error || 'Error ' + r.status);
  return data;
}

/* ── Toast ────────────────────────────────────────────────────────── */
function toast(msg, isErr) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.cssText = 'position:fixed;bottom:20px;right:20px;padding:10px 18px;border-radius:9px;color:#fff;' +
    'font-size:12.5px;font-weight:600;z-index:9999;max-width:320px;box-shadow:0 4px 20px rgba(0,0,0,.25);' +
    'background:' + (isErr ? '#dc2626' : '#16a34a');
  clearTimeout(t._tid);
  t._tid = setTimeout(() => t.style.cssText += ';display:none', 3200);
}

/* ── Escape ───────────────────────────────────────────────────────── */
function esc(s) {
  if (s == null) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function fmtDate(s) {
  if (!s) return '—';
  return new Date(s).toLocaleDateString('en-KE',{day:'numeric',month:'short',year:'numeric'});
}
function fmtKES(n) {
  const v = Number(n);
  if (isNaN(v)) return '—';
  if (v >= 1e6) return 'KES ' + (v/1e6).toFixed(2) + 'M';
  if (v >= 1e3) return 'KES ' + (v/1e3).toFixed(0) + 'K';
  return 'KES ' + v.toLocaleString();
}
function roleBdg(role) {
  const m = {admin:'bdg-admin',professional:'bdg-professional',client:'bdg-client',supplier:'bdg-supplier',banned:'bdg-banned'};
  return m[role] || 'bdg-neutral';
}
function statusBdg(s) {
  const m = {completed:'bdg-ok',pending:'bdg-pending',failed:'bdg-err',approved:'bdg-ok',rejected:'bdg-err',open:'bdg-ok',closed:'bdg-neutral'};
  return m[s] || 'bdg-neutral';
}

/* ── Sidebar group collapse ───────────────────────────────────────── */
function toggleGrp(id) {
  const el = document.getElementById(id);
  el.classList.toggle('collapsed');
  const hdr = el.previousElementSibling;
  const arr = hdr && hdr.querySelector('.grp-arr');
  if (arr) arr.classList.toggle('up');
}

/* ── Section switching ────────────────────────────────────────────── */
const SECTIONS = [
  'overview','system',
  'users','talent','verifications',
  'bids','projects','listings','reviews',
  'finance','invoices',
  'crm','comms',
  'analytics','growth',
  'audit','superadmin',
];
const LABELS = {
  overview:'Overview', system:'System Health',
  users:'User Management', talent:'Talent Registry', verifications:'Verifications',
  bids:'Bids & Jobs', projects:'Projects', listings:'Listings', reviews:'Reviews',
  finance:'Transactions', invoices:'Invoices & Escrow',
  crm:'Client Accounts', comms:'Messages & Broadcast',
  analytics:'Platform Analytics', growth:'Growth Metrics',
  audit:'Audit Log', superadmin:'Superadmin Control Plane',
};

function showSection(name) {
  SECTIONS.forEach(s => {
    const el = document.getElementById('sec-'+s);
    if (el) el.style.display = s === name ? 'block' : 'none';
    const nav = document.getElementById('nav-'+s);
    if (nav) nav.classList.toggle('active', s === name);
  });
  document.getElementById('bc-section').textContent = LABELS[name] || name;
  _loadSection(name);
}
function _loadSection(name) {
  switch (name) {
    case 'overview':      loadOverview(); break;
    case 'system':        if (!sectionLoaded.system) loadSystem(); break;
    case 'users':         if (!sectionLoaded.users) loadUsers(1); break;
    case 'talent':        if (!sectionLoaded.talent) loadTalent(1); break;
    case 'verifications': loadVerifications('pending'); break;
    case 'bids':          if (!sectionLoaded.bids) loadBids(1); break;
    case 'projects':      if (!sectionLoaded.projects) loadProjects(1); break;
    case 'listings':      if (!sectionLoaded.listings) loadListings('materials',1); break;
    case 'reviews':       if (!sectionLoaded.reviews) loadReviews(1); break;
    case 'finance':       if (!sectionLoaded.finance) loadFinance(1); break;
    case 'invoices':      if (!sectionLoaded.invoices) loadInvoices(1); break;
    case 'crm':           if (!sectionLoaded.crm) loadCrm(); break;
    case 'comms':         if (!sectionLoaded.comms) loadComms(); break;
    case 'analytics':     if (!sectionLoaded.analytics) loadAnalytics(); break;
    case 'growth':        if (!sectionLoaded.growth) loadGrowth(); break;
    case 'audit':         if (!sectionLoaded.audit) loadAudit(); break;
    case 'superadmin':    if (!sectionLoaded.superadmin) loadSuperadmin(); break;
  }
}

/* ══════════════════════════════════════════════════════════════════
   OVERVIEW
══════════════════════════════════════════════════════════════════ */
async function loadOverview() {
  try {
    const s = await apiFetch('/api/admin/stats');
    globalStats = s;

    // KPI cards
    document.getElementById('kpi-users').textContent    = s.users.toLocaleString();
    document.getElementById('kpi-profs').textContent    = s.professionals.toLocaleString();
    document.getElementById('kpi-revenue').textContent  = fmtKES(s.revenue_kes);
    document.getElementById('kpi-bids').textContent     = s.bids.toLocaleString();
    document.getElementById('kpi-projects').textContent = s.projects.toLocaleString();
    document.getElementById('kpi-txns').textContent     = s.transactions.toLocaleString();
    document.getElementById('kpi-pending-verifs').textContent = s.pending_verifications;
    document.getElementById('kpi-revenue2').textContent = Number(s.revenue_kes).toLocaleString();

    // Finance KPI mirror
    document.getElementById('fin-revenue').textContent = Number(s.revenue_kes).toLocaleString();
    document.getElementById('fin-txns').textContent    = s.transactions.toLocaleString();

    // Pending verif alert
    if (s.pending_verifications > 0) {
      document.getElementById('verif-alert').style.display = 'flex';
      document.getElementById('verif-alert-count').textContent = s.pending_verifications;
      const badge = document.getElementById('sb-verif-badge');
      badge.textContent = s.pending_verifications;
      badge.style.display = '';
      document.getElementById('vcount-pending').textContent = s.pending_verifications;
    }

    // Recent payments
    const tbody = document.getElementById('recent-pay-body');
    if (!s.recent_payments || !s.recent_payments.length) {
      tbody.innerHTML = '<tr><td colspan="5" style="padding:20px;text-align:center;color:var(--muted)">No payments yet</td></tr>';
      return;
    }
    tbody.innerHTML = s.recent_payments.map(p => `
      <tr>
        <td style="font-size:12.5px;font-weight:600">${esc(p.user_name)}</td>
        <td style="font-size:13px;font-weight:700;color:var(--navy)">KES ${Number(p.amount).toLocaleString()}</td>
        <td style="font-size:11px;font-family:monospace;color:var(--muted)">${esc(p.mpesa_receipt||'—')}</td>
        <td style="font-size:11px;color:var(--muted)">${fmtDate(p.completed_at)}</td>
        <td><span class="bdg bdg-ok">Completed</span></td>
      </tr>`).join('');
  } catch(e) {
    toast('Failed to load stats: '+e.message, true);
  }
}

/* ══════════════════════════════════════════════════════════════════
   USERS
══════════════════════════════════════════════════════════════════ */
function debounceUsers() {
  clearTimeout(userDebounce);
  userDebounce = setTimeout(() => loadUsers(1), 420);
}

async function loadUsers(page) {
  usersPage = page || 1;
  usersSearch = document.getElementById('user-search').value.trim();
  const role = document.getElementById('user-role-filter').value;
  const params = new URLSearchParams({ page: usersPage, limit: 25, search: usersSearch, role });
  const tbody = document.getElementById('users-body');
  tbody.innerHTML = '<tr><td colspan="8" style="padding:20px;text-align:center;color:var(--muted)">Loading…</td></tr>';

  try {
    const { users, total, limit } = await apiFetch('/api/admin/users?' + params);
    sectionLoaded.users = true;
    document.getElementById('users-count').textContent = total.toLocaleString() + ' users';

    if (!users.length) {
      tbody.innerHTML = '<tr><td colspan="8" style="padding:20px;text-align:center;color:var(--muted)">No users found</td></tr>';
      document.getElementById('users-pager').style.display = 'none';
      return;
    }
    tbody.innerHTML = users.map(u => `
      <tr style="cursor:pointer" onclick="openUserModal(${u.id})">
        <td>
          <div style="display:flex;align-items:center;gap:9px">
            <div style="width:30px;height:30px;border-radius:50%;background:var(--navy);color:#fff;
                        display:grid;place-items:center;font-size:11px;font-weight:700;flex-shrink:0">
              ${esc(u.name.charAt(0).toUpperCase())}
            </div>
            <div>
              <div style="font-size:12px;font-weight:600;color:var(--navy)">${esc(u.name)}</div>
              ${u.trade ? '<div style="font-size:10px;color:var(--muted)">'+esc(u.trade)+'</div>' : ''}
            </div>
          </div>
        </td>
        <td style="font-size:11.5px;color:var(--muted)">${esc(u.email)}</td>
        <td><span class="bdg ${roleBdg(u.role)}">${esc(u.role)}</span></td>
        <td style="font-size:11.5px">${esc(u.phone||'—')}</td>
        <td style="font-size:11.5px">${esc(u.location||'—')}</td>
        <td style="font-size:11px;color:var(--muted)">${fmtDate(u.created_at)}</td>
        <td>${u.verified
          ? '<span class="bdg bdg-ok">✓ Verified</span>'
          : '<span class="bdg bdg-neutral">Unverified</span>'}</td>
        <td onclick="event.stopPropagation()">
          <button onclick="openUserModal(${u.id})"
                  style="background:var(--navy);color:#fff;border:none;border-radius:6px;font-size:10.5px;padding:3px 10px;cursor:pointer">
            View
          </button>
        </td>
      </tr>`).join('');

    renderPager('users-pager', usersPage, Math.ceil(total/limit), 'loadUsers');
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="8" style="padding:20px;text-align:center;color:#dc2626">'+esc(e.message)+'</td></tr>';
  }
}

async function openUserModal(id) {
  currentUserId = id;
  document.getElementById('modal-overlay').style.display = 'block';
  document.getElementById('modal-body').style.opacity = '.4';
  try {
    const u = await apiFetch('/api/admin/users/' + id);
    currentUserData = u;

    // Header
    document.getElementById('m-avi').textContent = u.name.charAt(0).toUpperCase();
    document.getElementById('m-name').textContent  = u.name;
    document.getElementById('m-email').textContent = u.email;
    const rb = document.getElementById('m-role-badge');
    rb.textContent = u.role; rb.className = 'bdg ' + roleBdg(u.role);

    // Info
    document.getElementById('m-phone').textContent    = u.phone || '—';
    document.getElementById('m-location').textContent = u.location || '—';
    document.getElementById('m-joined').textContent   = fmtDate(u.created_at);
    document.getElementById('m-verified').innerHTML   = u.verified
      ? '<span class="bdg bdg-ok">✓ '+(u.verification_badge||'Verified')+'</span>'
      : '<span class="bdg bdg-neutral">Not verified</span>';

    if (u.bio) {
      document.getElementById('m-bio-row').style.display = '';
      document.getElementById('m-bio').textContent = u.bio;
    } else {
      document.getElementById('m-bio-row').style.display = 'none';
    }

    // Professional
    if (u.trade) {
      document.getElementById('m-prof').style.display = '';
      document.getElementById('m-trade').textContent = u.trade || '—';
      document.getElementById('m-nca').textContent   = u.nca_grade || '—';
      document.getElementById('m-rate').textContent  = u.hourly_rate ? 'KES '+u.hourly_rate+'/hr' : '—';
      document.getElementById('m-exp').textContent   = u.experience_years ? u.experience_years+' yrs' : '—';
      document.getElementById('m-jobs').textContent  = u.jobs_done || 0;
      document.getElementById('m-rating').textContent= u.rating ? u.rating+' ★' : '—';
    } else {
      document.getElementById('m-prof').style.display = 'none';
    }

    // Documents
    document.getElementById('m-docs-count').textContent = u.documents.length;
    document.getElementById('m-docs-list').innerHTML = u.documents.length
      ? u.documents.map(d => `
          <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--rule)">
            <div>
              <div style="font-size:12px;font-weight:500">${esc(d.original_name)}</div>
              <div style="font-size:10px;color:var(--muted)">${esc(d.document_type)} · ${fmtDate(d.created_at)}</div>
            </div>
            <span class="bdg ${statusBdg(d.status)}">${d.status}</span>
          </div>`).join('')
      : '<div style="font-size:12px;color:var(--muted);padding:6px 0">No documents uploaded</div>';

    // Footer role select & ban button
    document.getElementById('m-role-sel').value = (u.role === 'banned') ? 'client' : u.role;
    const bb = document.getElementById('m-ban-btn');
    if (u.role === 'banned') {
      bb.textContent = 'Unban User';
      bb.style.cssText = 'background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;border-radius:7px;font-size:11.5px;padding:7px 14px;cursor:pointer';
    } else {
      bb.textContent = 'Ban User';
      bb.style.cssText = 'background:#fef2f2;color:#dc2626;border:1px solid #fca5a5;border-radius:7px;font-size:11.5px;padding:7px 14px;cursor:pointer';
    }

    // Reset pw form
    document.getElementById('reset-pw-form').style.display = 'none';
    document.getElementById('new-pw').value = '';
  } catch(e) {
    toast('Failed to load user: '+e.message, true);
  } finally {
    document.getElementById('modal-body').style.opacity = '1';
  }
}

function maybeCloseModal(e) {
  if (e.target === document.getElementById('modal-overlay'))
    document.getElementById('modal-overlay').style.display = 'none';
}

function toggleResetPw() {
  const f = document.getElementById('reset-pw-form');
  f.style.display = f.style.display === 'none' ? 'block' : 'none';
}

async function doResetPw() {
  const pw = document.getElementById('new-pw').value;
  if (!pw || pw.length < 8) { toast('Password must be at least 8 characters', true); return; }
  try {
    const r = await apiCall('POST', '/api/admin/users/'+currentUserId+'/reset-password', { password: pw });
    toast(r.message);
    document.getElementById('reset-pw-form').style.display = 'none';
    document.getElementById('new-pw').value = '';
  } catch(e) { toast(e.message, true); }
}

async function doChangeRole() {
  const role = document.getElementById('m-role-sel').value;
  try {
    const r = await apiCall('PUT', '/api/admin/users/'+currentUserId+'/role', { role });
    toast(r.message);
    const rb = document.getElementById('m-role-badge');
    rb.textContent = role; rb.className = 'bdg '+roleBdg(role);
    if (sectionLoaded.users) loadUsers(usersPage);
  } catch(e) { toast(e.message, true); }
}

async function doBan() {
  const isBanned = currentUserData && currentUserData.role === 'banned';
  if (!confirm(isBanned ? 'Unban this user?' : 'Ban this user? They will lose access.')) return;
  try {
    const r = await apiCall('PUT', '/api/admin/users/'+currentUserId+'/ban', {});
    toast(r.message);
    await openUserModal(currentUserId);
    if (sectionLoaded.users) loadUsers(usersPage);
  } catch(e) { toast(e.message, true); }
}

/* ══════════════════════════════════════════════════════════════════
   FINANCE
══════════════════════════════════════════════════════════════════ */
function debounceFinance() {
  clearTimeout(finDebounce);
  finDebounce = setTimeout(() => loadFinance(1), 420);
}

async function loadFinance(page) {
  finPage = page || 1;
  finSearch = document.getElementById('fin-search').value.trim();
  const params = new URLSearchParams({ page: finPage, limit: 30, search: finSearch });
  const tbody = document.getElementById('fin-body');
  tbody.innerHTML = '<tr><td colspan="6" style="padding:20px;text-align:center;color:var(--muted)">Loading…</td></tr>';

  try {
    const { transactions, total, limit } = await apiFetch('/api/admin/transactions?'+params);
    sectionLoaded.finance = true;

    // Count pending in current result set for the mini stat
    const pending = transactions.filter(t => t.status === 'pending').length;
    document.getElementById('fin-pending').textContent = pending + (total > limit ? '+' : '');

    if (!transactions.length) {
      tbody.innerHTML = '<tr><td colspan="6" style="padding:20px;text-align:center;color:var(--muted)">No transactions found</td></tr>';
      document.getElementById('fin-pager').style.display = 'none';
      return;
    }
    tbody.innerHTML = transactions.map(t => `
      <tr>
        <td style="font-size:11px;color:var(--muted)">${fmtDate(t.created_at)}</td>
        <td>
          <div style="font-size:12px;font-weight:600">${esc(t.user_name)}</div>
          <div style="font-size:10.5px;color:var(--muted)">${esc(t.user_email)}</div>
        </td>
        <td style="font-size:13px;font-weight:700;color:var(--navy)">KES ${Number(t.amount).toLocaleString()}</td>
        <td style="font-size:11.5px">${esc(t.phone||'—')}</td>
        <td style="font-size:11px;font-family:monospace;color:var(--muted)">${esc(t.mpesa_receipt||'—')}</td>
        <td><span class="bdg ${statusBdg(t.status)}">${t.status}</span></td>
      </tr>`).join('');

    renderPager('fin-pager', finPage, Math.ceil(total/limit), 'loadFinance');
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="6" style="padding:20px;text-align:center;color:#dc2626">'+esc(e.message)+'</td></tr>';
  }
}

/* ══════════════════════════════════════════════════════════════════
   VERIFICATIONS
══════════════════════════════════════════════════════════════════ */
async function loadVerifications(status) {
  verifStatus = status || 'pending';
  ['pending','approved','rejected'].forEach(s => {
    document.getElementById('vtab-'+s).classList.toggle('active', s === verifStatus);
  });
  const tbody = document.getElementById('verif-body');
  tbody.innerHTML = '<tr><td colspan="6" style="padding:20px;text-align:center;color:var(--muted)">Loading…</td></tr>';
  try {
    const docs = await apiFetch('/api/admin/verifications?status='+verifStatus);
    if (verifStatus === 'pending') {
      document.getElementById('vcount-pending').textContent = docs.length;
    }
    if (!docs.length) {
      tbody.innerHTML = '<tr><td colspan="6" style="padding:20px;text-align:center;color:var(--muted)">No '+verifStatus+' documents</td></tr>';
      return;
    }
    tbody.innerHTML = docs.map(d => `
      <tr>
        <td>
          <div style="font-size:12.5px;font-weight:600">${esc(d.user_name)}</div>
          <div style="font-size:10.5px;color:var(--muted)">${esc(d.user_email)}</div>
        </td>
        <td style="font-size:12px">${esc(d.trade||'—')}</td>
        <td>
          <div style="font-size:12px;font-weight:500">${esc(d.original_name)}</div>
          <div style="font-size:10px;color:var(--muted)">${(d.size_bytes/1024).toFixed(0)} KB · ${esc(d.mime_type)}</div>
        </td>
        <td><span class="bdg bdg-neutral">${esc(d.document_type.replace(/_/g,' '))}</span></td>
        <td style="font-size:11px;color:var(--muted)">${fmtDate(d.created_at)}</td>
        <td>
          ${verifStatus === 'pending'
            ? `<button onclick="approveDoc(${d.id})"
                       style="background:#16a34a;color:#fff;border:none;border-radius:6px;font-size:10.5px;padding:4px 9px;cursor:pointer;margin-right:4px">Approve</button>
               <button onclick="rejectDoc(${d.id})"
                       style="background:#fef2f2;color:#dc2626;border:1px solid #fca5a5;border-radius:6px;font-size:10.5px;padding:4px 9px;cursor:pointer">Reject</button>`
            : `<span class="bdg ${statusBdg(verifStatus)}">${verifStatus}</span>
               ${d.rejection_reason ? '<div style="font-size:10px;color:var(--muted);margin-top:3px">'+esc(d.rejection_reason)+'</div>' : ''}`
          }
        </td>
      </tr>`).join('');
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="6" style="padding:20px;text-align:center;color:#dc2626">'+esc(e.message)+'</td></tr>';
  }
}

async function approveDoc(id) {
  if (!confirm('Approve this document and mark user as verified?')) return;
  try {
    const r = await apiCall('PUT', '/api/admin/verifications/'+id+'/approve', {});
    toast(r.message);
    loadVerifications(verifStatus);
    loadOverview();
  } catch(e) { toast(e.message, true); }
}

async function rejectDoc(id) {
  const reason = prompt('Rejection reason (will be shown to the user):');
  if (!reason || !reason.trim()) return;
  try {
    const r = await apiCall('PUT', '/api/admin/verifications/'+id+'/reject', { reason: reason.trim() });
    toast(r.message);
    loadVerifications(verifStatus);
  } catch(e) { toast(e.message, true); }
}

/* ══════════════════════════════════════════════════════════════════
   BIDS
══════════════════════════════════════════════════════════════════ */
async function loadBids(page) {
  bidsPage = page || 1;
  const tbody = document.getElementById('bids-body');
  tbody.innerHTML = '<tr><td colspan="7" style="padding:20px;text-align:center;color:var(--muted)">Loading…</td></tr>';
  try {
    const bids = await apiFetch('/api/admin/bids?page='+bidsPage+'&limit=30');
    sectionLoaded.bids = true;
    document.getElementById('bids-count').textContent = bids.length + ' bids (this page)';
    bids.forEach(b => bidsCache[b.id] = b);
    if (!bids.length) {
      tbody.innerHTML = '<tr><td colspan="7" style="padding:20px;text-align:center;color:var(--muted)">No bids found</td></tr>';
      return;
    }
    tbody.innerHTML = bids.map(b => `
      <tr>
        <td>
          <div style="font-size:12px;font-weight:600;color:var(--navy)">${esc(b.title)}</div>
          <div style="font-size:10px;color:var(--muted)">${esc(b.location||'—')}</div>
        </td>
        <td>
          <div style="font-size:12px">${esc(b.poster_name)}</div>
          <div style="font-size:10.5px;color:var(--muted)">${esc(b.poster_email)}</div>
        </td>
        <td style="font-size:12px;font-weight:500">
          ${(b.budget_min && b.budget_max)
            ? Number(b.budget_min).toLocaleString()+' – '+Number(b.budget_max).toLocaleString()
            : '—'}
        </td>
        <td><span class="bdg ${statusBdg(b.status)}">${b.status}</span></td>
        <td style="text-align:center;font-size:12px">${b.applications_count||0}</td>
        <td style="font-size:11px;color:var(--muted)">${fmtDate(b.created_at)}</td>
        <td>
          <button onclick="deleteBid(${b.id})"
                  style="background:#fef2f2;color:#dc2626;border:1px solid #fca5a5;border-radius:6px;font-size:10.5px;padding:4px 9px;cursor:pointer">Delete</button>
        </td>
      </tr>`).join('');

    const pager = document.getElementById('bids-pager');
    pager.style.display = bids.length === 30 ? 'flex' : 'none';
    if (bids.length === 30) {
      pager.innerHTML = '<span style="font-size:11px;color:var(--muted)">Page '+bidsPage+'</span>' +
        '<div style="display:flex;gap:6px">' +
        (bidsPage > 1 ? '<button onclick="loadBids('+(bidsPage-1)+')" style="'+pagerBtn+'">← Prev</button>' : '') +
        '<button onclick="loadBids('+(bidsPage+1)+')" style="'+pagerBtn+'">Next →</button></div>';
    }
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="7" style="padding:20px;text-align:center;color:#dc2626">'+esc(e.message)+'</td></tr>';
  }
}

async function deleteBid(id) {
  const b = bidsCache[id];
  const title = b ? b.title : 'this bid';
  if (!confirm('Delete "'+title+'"? This cannot be undone.')) return;
  try {
    const r = await apiCall('DELETE', '/api/admin/bids/'+id, {});
    toast(r.message);
    loadBids(bidsPage);
  } catch(e) { toast(e.message, true); }
}

/* ══════════════════════════════════════════════════════════════════
   ANALYTICS
══════════════════════════════════════════════════════════════════ */
async function loadAnalytics() {
  sectionLoaded.analytics = true;
  try {
    const { revenueByDay, signupsByDay } = await apiFetch('/api/admin/analytics');

    const rCtx = document.getElementById('chartRevenue').getContext('2d');
    if (aCharts.revenue) aCharts.revenue.destroy();
    aCharts.revenue = new Chart(rCtx, {
      type: 'line',
      data: {
        labels: revenueByDay.map(d => d.day.slice(5)),
        datasets: [{
          label: 'Revenue KES',
          data: revenueByDay.map(d => Number(d.total)),
          borderColor: '#011D47', backgroundColor: 'rgba(1,29,71,0.07)',
          borderWidth: 2, pointRadius: 3, fill: true, tension: 0.3,
        }]
      },
      options: {
        responsive:true, maintainAspectRatio:false,
        plugins:{ legend:{ display:false } },
        scales:{
          x:{ grid:{ display:false }, ticks:{ font:{ size:9 }, color:'#9ca3af' } },
          y:{ grid:{ color:'#f3f4f6' }, border:{ display:false },
              ticks:{ font:{ size:9 }, color:'#9ca3af', callback: v => 'KES '+v.toLocaleString() } }
        }
      }
    });

    const sCtx = document.getElementById('chartSignups').getContext('2d');
    if (aCharts.signups) aCharts.signups.destroy();
    aCharts.signups = new Chart(sCtx, {
      type: 'bar',
      data: {
        labels: signupsByDay.map(d => d.day.slice(5)),
        datasets: [{
          label: 'New Users',
          data: signupsByDay.map(d => Number(d.total)),
          backgroundColor: 'rgba(196,49,0,0.75)',
          borderRadius: 4, borderSkipped: false,
        }]
      },
      options: {
        responsive:true, maintainAspectRatio:false,
        plugins:{ legend:{ display:false } },
        scales:{
          x:{ grid:{ display:false }, ticks:{ font:{ size:9 }, color:'#9ca3af' } },
          y:{ grid:{ color:'#f3f4f6' }, border:{ display:false },
              ticks:{ font:{ size:9 }, color:'#9ca3af', stepSize:1 } }
        }
      }
    });

    if (!revenueByDay.length && !signupsByDay.length) {
      toast('No analytics data yet — make some transactions and signups first!');
    }
  } catch(e) { toast('Analytics error: '+e.message, true); }
}

/* ══════════════════════════════════════════════════════════════════
   SYSTEM HEALTH
══════════════════════════════════════════════════════════════════ */
async function loadSystem() {
  sectionLoaded.system = true;
  try {
    const s = await apiFetch('/api/admin/system');
    const hrs  = Math.floor(s.uptime_seconds / 3600);
    const mins = Math.floor((s.uptime_seconds % 3600) / 60);
    document.getElementById('sys-uptime').textContent = hrs + 'h ' + mins + 'm';
    document.getElementById('sys-node').textContent   = s.node_version;
    document.getElementById('sys-db').textContent     = s.db_type.toUpperCase();
    document.getElementById('sys-env').textContent    = s.env;

    const mem = s.memory_mb;
    const heapPct = Math.round((mem.heap_used / mem.heap_total) * 100);
    document.getElementById('sys-mem-body').innerHTML = `
      <div style="margin-bottom:12px">
        <div style="display:flex;justify-content:space-between;font-size:11.5px;margin-bottom:4px">
          <span style="color:var(--muted)">Heap Used</span>
          <strong>${mem.heap_used} MB / ${mem.heap_total} MB</strong>
        </div>
        <div class="prog"><div class="prog-fill" style="width:${heapPct}%;background:${heapPct>80?'#dc2626':heapPct>60?'#d97706':'#16a34a'}"></div></div>
      </div>
      <div>
        <div style="display:flex;justify-content:space-between;font-size:11.5px;margin-bottom:4px">
          <span style="color:var(--muted)">RSS (Resident Memory)</span>
          <strong>${mem.rss} MB</strong>
        </div>
        <div class="prog"><div class="prog-fill" style="width:${Math.min(100,Math.round(mem.rss/256*100))}%;background:#2563eb"></div></div>
      </div>`;

    const tc = s.table_counts;
    document.getElementById('sys-tables-body').innerHTML = `
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px">
        ${Object.entries(tc).map(([k,v]) => `
          <div style="background:var(--bg);border-radius:8px;padding:10px 12px;text-align:center">
            <div style="font-size:16px;font-weight:800;color:var(--navy)">${Number(v).toLocaleString()}</div>
            <div style="font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-top:2px">${k}</div>
          </div>`).join('')}
      </div>`;
  } catch(e) { toast('System load failed: '+e.message, true); }
}

