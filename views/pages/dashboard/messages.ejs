<%- include('../../partials/head', { title: "Messages — BuildLink" }) %>
<%- include('../../partials/dash-topbar', { user: locals.user }) %>
<%- include('../../partials/dash-sidebar', { activeSection: "messages" }) %>


<!-- MESSAGES LAYOUT -->
<div class="bl-dash-main p-0">
  <div class="bl-msg-layout">

    <!-- Thread List -->
    <div class="bl-msg-threads">
      <div class="p-3 border-bottom d-flex align-items-center justify-content-between" style="background:#fff">
        <h6 class="fw-bold mb-0" style="color:var(--bl-navy)">Messages</h6>
        <button class="btn btn-primary btn-sm" onclick="showToast('Select a recipient to start a new message')" style="font-size:11px;border-radius:8px">+ New</button>
      </div>
      <div class="p-2 border-bottom" style="background:#fff">
        <input class="form-control form-control-sm" placeholder="Search messages…" style="border-radius:8px;font-size:12px" oninput="filterThreads(this.value)">
      </div>
      <div id="thread-list">
        <div class="text-center text-muted py-5" style="font-size:12px">
          <div class="spinner-border spinner-border-sm mb-2"></div><br>Loading messages…
        </div>
      </div>
    </div>

    <!-- Conversation View -->
    <div class="bl-msg-conv" id="conv-wrap">
      <div class="bl-msg-empty" id="conv-empty">
        <div class="fw-600" style="font-size:14px;color:var(--bl-navy)">Select a conversation</div>
        <div style="font-size:12px">Choose a message from the list to read and reply</div>
      </div>

      <!-- Conversation header (hidden until thread selected) -->
      <div id="conv-header" class="bl-msg-conv-header" style="display:none">
        <img id="conv-avatar" src="" style="width:38px;height:38px;border-radius:50%;object-fit:cover" alt="">
        <div>
          <div class="fw-bold" id="conv-name" style="font-size:14px;color:var(--bl-navy)"></div>
          <div class="text-muted" id="conv-role" style="font-size:11px"></div>
        </div>
        <div class="ms-auto d-flex gap-2">
          <button class="btn btn-sm btn-outline-secondary" style="border-radius:8px;font-size:11px" onclick="showToast('Opening project context…')">View Project</button>
        </div>
      </div>

      <!-- Messages body -->
      <div class="bl-msg-conv-body" id="conv-body" style="display:none"></div>

      <!-- Reply footer -->
      <div class="bl-msg-conv-footer" id="conv-footer" style="display:none">
        <textarea class="bl-msg-input" id="reply-input" rows="1" placeholder="Type a message…" onkeydown="handleMsgKey(event)"></textarea>
        <button class="btn btn-primary px-3" style="border-radius:10px" onclick="sendReply()">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>
    </div>

  </div>
</div>


<%- include('../../partials/scripts') %>
<script>
let _threads = [];
let _activeThread = null;
let _myId = null;

function timeAgo(iso) {
  const d = new Date(iso), now = new Date();
  const diff = (now - d) / 1000;
  if (diff < 60) return 'Just now';
  if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
  if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
  return d.toLocaleDateString('en-KE', { day:'numeric', month:'short' });
}

async function loadMessages() {
  const user = await BLApi.me();
  if (!user) return;
  _myId = user.id;
  document.getElementById('topbar-avatar').src = user.avatar || `https://i.pravatar.cc/100?img=${user.id % 70 + 1}`;

  const msgs = await BLApi.getMessages();
  const fallback = BL.messages || [];
  const data = msgs || fallback;

  // Update unread badge
  const unread = data.filter(m => !m.read).length;
  const badge = document.getElementById('unread-count');
  if (unread > 0) { badge.textContent = unread; badge.style.display = ''; }

  // Build thread groups (by sender)
  const byThread = {};
  data.forEach(m => {
    const senderId = m.sender_id || m.id;
    const key = senderId;
    if (!byThread[key]) byThread[key] = { ...m, messages: [] };
    byThread[key].messages.push(m);
  });
  _threads = Object.values(byThread);
  renderThreadList(_threads);
}

function renderThreadList(threads) {
  const el = document.getElementById('thread-list');
  if (!threads.length) {
    el.innerHTML = `<div class="text-center text-muted py-5" style="font-size:12px">No messages yet</div>`;
    return;
  }
  el.innerHTML = threads.map((t, i) => {
    const name   = t.sender_name || t.from || 'Unknown';
    const avatar = t.sender_avatar || t.avatar || `https://i.pravatar.cc/100?img=${i + 1}`;
    const preview = t.content || t.preview || '';
    const time   = t.created_at ? timeAgo(t.created_at) : t.time || '';
    const unread = !t.read;
    return `<div class="bl-msg-thread ${unread ? 'unread' : ''}" onclick="openThread(${i})" id="thread-${i}">
      <div class="position-relative flex-shrink-0">
        <img src="${avatar}" style="width:40px;height:40px;border-radius:50%;object-fit:cover" alt="">
        ${unread ? '<div style="position:absolute;bottom:0;right:0;width:11px;height:11px;background:var(--bl-accent);border-radius:50%;border:2px solid #fff"></div>' : ''}
      </div>
      <div class="flex-grow-1 overflow-hidden">
        <div class="d-flex justify-content-between align-items-center">
          <div class="bl-msg-thread-name">${name}</div>
          <div class="bl-msg-thread-time">${time}</div>
        </div>
        <div class="bl-msg-thread-preview">${preview}</div>
      </div>
    </div>`;
  }).join('');
}

function filterThreads(q) {
  const filtered = q ? _threads.filter(t => (t.sender_name || '').toLowerCase().includes(q.toLowerCase()) || (t.content || '').toLowerCase().includes(q.toLowerCase())) : _threads;
  renderThreadList(filtered);
}

function openThread(idx) {
  _activeThread = _threads[idx];
  document.querySelectorAll('.bl-msg-thread').forEach(el => el.classList.remove('active'));
  const el = document.getElementById('thread-' + idx);
  if (el) el.classList.add('active');

  const t = _activeThread;
  document.getElementById('conv-empty').style.display   = 'none';
  document.getElementById('conv-header').style.display  = 'flex';
  document.getElementById('conv-body').style.display    = 'flex';
  document.getElementById('conv-footer').style.display  = 'flex';

  document.getElementById('conv-avatar').src  = t.sender_avatar || t.avatar || 'https://i.pravatar.cc/100?img=1';
  document.getElementById('conv-name').textContent  = t.sender_name || t.from || 'Unknown';
  document.getElementById('conv-role').textContent  = t.sender_role || t.role || '';

  // Render messages (thread messages + reply simulation)
  const body = document.getElementById('conv-body');
  const msgs = t.messages || [t];
  body.innerHTML = msgs.map(m => {
    const isMe = m.sender_id === _myId;
    return `<div class="d-flex flex-column ${isMe ? 'align-items-end' : 'align-items-start'}">
      <div class="bl-msg-bubble ${isMe ? 'me' : 'them'}">${m.content || m.preview || ''}</div>
      <div class="text-muted mt-1" style="font-size:9px;padding:0 4px">${m.created_at ? timeAgo(m.created_at) : m.time || ''}</div>
    </div>`;
  }).join('');
  body.scrollTop = body.scrollHeight;

  // Mark as read
  if (t.id && !t.read) BLApi.sendMessage && BLApi.me && fetch(`/api/messages/${t.id}/read`, { method:'PUT', credentials:'include' }).catch(() => {});
}

async function sendReply() {
  const inp = document.getElementById('reply-input');
  const msg = inp.value.trim();
  if (!msg || !_activeThread) return;
  inp.value = '';

  // Optimistically add bubble
  const body = document.getElementById('conv-body');
  body.innerHTML += `<div class="d-flex flex-column align-items-end">
    <div class="bl-msg-bubble me">${msg}</div>
    <div class="text-muted mt-1" style="font-size:9px;padding:0 4px">Just now</div>
  </div>`;
  body.scrollTop = body.scrollHeight;

  await BLApi.sendMessage({ recipient_id: _activeThread.sender_id, content: msg, project_id: _activeThread.project_id || null });
}

function handleMsgKey(e) {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendReply(); }
}

document.addEventListener('DOMContentLoaded', loadMessages);
</script>
</body>
</html>
