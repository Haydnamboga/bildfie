<%- include('../../partials/head', { title: "Invoices — BuildLink" }) %>
<%- include('../../partials/dash-topbar', { user: locals.user }) %>
<%- include('../../partials/dash-sidebar', { activeSection: "invoices" }) %>


<!-- MAIN -->
<main class="bl-dash-main">

  <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
      <h4 class="fw-bold mb-0" style="font-family:'Playfair Display',serif;color:var(--bl-navy)">Invoices & Payments</h4>
      <p class="text-muted small mb-0">Review, approve, and track all project invoices</p>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="row g-3 mb-4" id="invoice-summary">
    <div class="col-6 col-lg-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <div class="bl-metric-val" id="sum-pending">0</div>
          <div class="bl-metric-label">Pending Approval</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <div class="bl-metric-val" id="sum-approved">0</div>
          <div class="bl-metric-label">Approved</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <div class="bl-metric-val" id="sum-paid">0</div>
          <div class="bl-metric-label">Paid</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <div class="bl-metric-val" id="sum-total">KES 0</div>
          <div class="bl-metric-label">Total Due</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter tabs -->
  <div class="d-flex gap-2 mb-3 flex-wrap">
    <button class="btn btn-sm btn-primary" id="filter-all" onclick="filterInvoices('all',this)" style="border-radius:8px">All</button>
    <button class="btn btn-sm btn-outline-secondary" id="filter-pending" onclick="filterInvoices('pending',this)" style="border-radius:8px">Pending</button>
    <button class="btn btn-sm btn-outline-secondary" id="filter-approved" onclick="filterInvoices('approved',this)" style="border-radius:8px">Approved</button>
    <button class="btn btn-sm btn-outline-secondary" id="filter-paid" onclick="filterInvoices('paid',this)" style="border-radius:8px">Paid</button>
  </div>

  <!-- Invoice List -->
  <div id="invoice-list">
    <div class="card border-0 shadow-sm" style="border-radius:14px">
      <div class="card-body p-4 text-center">
        <div class="spinner-border text-primary" style="width:24px;height:24px"></div>
        <div class="text-muted mt-2" style="font-size:12px">Loading invoices…</div>
      </div>
    </div>
  </div>

</main>

<!-- Approve Confirmation Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:420px">
    <div class="modal-content border-0 shadow-lg" style="border-radius:16px">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" style="font-family:'Playfair Display',serif;color:var(--bl-navy)">Approve Invoice</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body px-4">
        <div id="approve-detail" class="p-3 rounded-3 mb-3" style="background:var(--bl-bg)"></div>
        <p class="text-muted small">Approving this invoice will release payment from escrow to the professional. This action cannot be undone.</p>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-success" id="confirm-approve-btn">Release Payment</button>
      </div>
    </div>
  </div>
</div>


<%- include('../../partials/scripts') %>
<script>
function showToast(msg, type) {
  let t = document.getElementById('bl-toast');
  if (!t) {
    t = document.createElement('div'); t.id = 'bl-toast'; t.className = 'bl-toast';
    t.innerHTML = '<div class="bl-toast-dot"></div><span id="bl-toast-msg"></span>';
    document.body.appendChild(t);
  }
  t.querySelector('.bl-toast-dot').style.background = type === 'error' ? '#ef9a9a' : type === 'warning' ? '#D4A017' : '#4CAF50';
  t.querySelector('#bl-toast-msg').textContent = msg;
  t.classList.add('show');
  clearTimeout(t._t);
  t._t = setTimeout(() => t.classList.remove('show'), 3500);
}

let _invoices = [];
let _activeFilter = 'all';
let _pendingApproveId = null;

function fmtKES(n) {
  if (n >= 1000000) return 'KES ' + (n/1000000).toFixed(1) + 'M';
  if (n >= 1000) return 'KES ' + (n/1000).toFixed(0) + 'K';
  return 'KES ' + n.toLocaleString();
}

function formatDate(d) {
  if (!d) return '—';
  return new Date(d).toLocaleDateString('en-KE', { day:'numeric', month:'short', year:'numeric' });
}

const statusConf = {
  pending:  { bg:'var(--bl-bg)', color:'var(--bl-muted)',  label:'Pending' },
  approved: { bg:'var(--bl-bg)', color:'var(--bl-navy)',   label:'Approved' },
  paid:     { bg:'var(--bl-bg)', color:'var(--bl-navy)',   label:'Paid' },
};

async function loadInvoices() {
  const user = await BLApi.me();
  if (user) document.getElementById('topbar-avatar').src = user.avatar || `https://i.pravatar.cc/100?img=${user.id % 70 + 1}`;

  const data = await BLApi.getInvoices();

  // Use seeded fallback data if API returns nothing
  if (!data || !data.length) {
    _invoices = (BL.invoices || []).map((inv, i) => ({
      ...inv,
      id: i + 1,
      issuer_name: inv.issuer_name || 'Professional',
      project_name: inv.project_name || 'Project',
      currency: 'KES',
      due_date: inv.due_date || '',
    }));
  } else {
    _invoices = data;
  }

  updateSummary();
  renderInvoices(_invoices);
}

function updateSummary() {
  const pending  = _invoices.filter(i => i.status === 'pending').length;
  const approved = _invoices.filter(i => i.status === 'approved').length;
  const paid     = _invoices.filter(i => i.status === 'paid').length;
  const totalDue = _invoices.filter(i => i.status !== 'paid').reduce((s, i) => s + (i.amount || 0), 0);
  document.getElementById('sum-pending').textContent  = pending;
  document.getElementById('sum-approved').textContent = approved;
  document.getElementById('sum-paid').textContent     = paid;
  document.getElementById('sum-total').textContent    = fmtKES(totalDue);
}

function filterInvoices(status, btn) {
  _activeFilter = status;
  document.querySelectorAll('[id^="filter-"]').forEach(b => {
    b.className = 'btn btn-sm btn-outline-secondary';
    b.style.borderRadius = '8px';
  });
  btn.className = 'btn btn-sm btn-primary';
  btn.style.borderRadius = '8px';
  const filtered = status === 'all' ? _invoices : _invoices.filter(i => i.status === status);
  renderInvoices(filtered);
}

function renderInvoices(list) {
  const el = document.getElementById('invoice-list');
  if (!list.length) {
    el.innerHTML = `<div class="card border-0 shadow-sm" style="border-radius:14px"><div class="card-body p-5 text-center text-muted"><div style="font-size:13px">No invoices found.</div></div></div>`;
    return;
  }
  el.innerHTML = `
    <div class="card border-0 shadow-sm" style="border-radius:14px;overflow:hidden">
      <div class="table-responsive">
        <table class="table mb-0" style="font-size:13px">
          <thead style="background:var(--bl-bg)">
            <tr>
              <th class="px-4 py-3 border-0 fw-600" style="color:var(--bl-muted);font-size:11px;text-transform:uppercase;letter-spacing:.06em">#</th>
              <th class="py-3 border-0 fw-600" style="color:var(--bl-muted);font-size:11px;text-transform:uppercase;letter-spacing:.06em">From</th>
              <th class="py-3 border-0 fw-600" style="color:var(--bl-muted);font-size:11px;text-transform:uppercase;letter-spacing:.06em">Project</th>
              <th class="py-3 border-0 fw-600" style="color:var(--bl-muted);font-size:11px;text-transform:uppercase;letter-spacing:.06em">Milestone</th>
              <th class="py-3 border-0 fw-600" style="color:var(--bl-muted);font-size:11px;text-transform:uppercase;letter-spacing:.06em">Amount</th>
              <th class="py-3 border-0 fw-600" style="color:var(--bl-muted);font-size:11px;text-transform:uppercase;letter-spacing:.06em">Due</th>
              <th class="py-3 border-0 fw-600" style="color:var(--bl-muted);font-size:11px;text-transform:uppercase;letter-spacing:.06em">Status</th>
              <th class="py-3 pe-4 border-0 fw-600" style="color:var(--bl-muted);font-size:11px;text-transform:uppercase;letter-spacing:.06em">Action</th>
            </tr>
          </thead>
          <tbody>
            ${list.map((inv, idx) => {
              const s = statusConf[inv.status] || statusConf.pending;
              const overdue = inv.status === 'pending' && inv.due_date && new Date(inv.due_date) < new Date();
              return `<tr style="border-top:1px solid var(--bl-rule)">
                <td class="px-4 py-3 text-muted" style="font-size:11px">#${String(inv.id).padStart(4,'0')}</td>
                <td class="py-3">
                  <div class="fw-600" style="color:var(--bl-navy)">${inv.issuer_name || '—'}</div>
                </td>
                <td class="py-3">
                  <div style="font-size:12px;color:var(--bl-muted)">${inv.project_name || '—'}</div>
                </td>
                <td class="py-3" style="max-width:180px">
                  <div style="font-size:12px;color:var(--bl-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${inv.milestone || ''}">${inv.milestone || '—'}</div>
                </td>
                <td class="py-3">
                  <div class="fw-bold" style="color:var(--bl-navy)">${inv.currency || 'KES'} ${(inv.amount || 0).toLocaleString()}</div>
                </td>
                <td class="py-3">
                  <div style="font-size:12px;color:${overdue ? 'var(--bl-accent)' : 'var(--bl-muted)'}">${formatDate(inv.due_date)}${overdue ? ' (overdue)' : ''}</div>
                </td>
                <td class="py-3">
                  <span class="badge" style="background:${s.bg};color:${s.color};font-size:10px;padding:5px 10px;border-radius:100px">${s.label}</span>
                </td>
                <td class="py-3 pe-4">
                  ${inv.status === 'pending' ? `<button class="btn btn-sm btn-success" style="border-radius:8px;font-size:11px;font-weight:700" onclick="confirmApprove(${inv.id},'${inv.issuer_name}',${inv.amount},'${inv.currency}','${inv.milestone}')">Approve</button>` : ''}
                  ${inv.status === 'approved' ? `<button class="btn btn-sm btn-primary" style="border-radius:8px;font-size:11px;font-weight:700" onclick="showToast('Payment processing…')">Release</button>` : ''}
                  ${inv.status === 'paid' ? `<span class="text-muted" style="font-size:11px"><i class="bi bi-check"></i>  Settled</span>` : ''}
                </td>
              </tr>`;
            }).join('')}
          </tbody>
          <tfoot style="background:var(--bl-bg)">
            <tr>
              <td colspan="4" class="px-4 py-3 fw-600" style="font-size:12px;color:var(--bl-muted)">Total Outstanding</td>
              <td class="py-3 fw-bold" style="font-size:14px;color:var(--bl-navy)">${fmtKES(list.filter(i => i.status !== 'paid').reduce((s,i) => s + (i.amount||0), 0))}</td>
              <td colspan="3"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>`;
}

function confirmApprove(id, name, amount, currency, milestone) {
  _pendingApproveId = id;
  document.getElementById('approve-detail').innerHTML = `
    <div class="fw-bold mb-1" style="font-size:14px;color:var(--bl-navy)">${name}</div>
    <div class="text-muted small mb-2">${milestone || 'Invoice'}</div>
    <div class="fw-bold" style="font-size:20px;font-family:'Playfair Display',serif;color:var(--bl-accent)">${currency} ${amount.toLocaleString()}</div>`;
  const btn = document.getElementById('confirm-approve-btn');
  btn.onclick = () => doApprove(id);
  new bootstrap.Modal(document.getElementById('approveModal')).show();
}

async function doApprove(id) {
  const btn = document.getElementById('confirm-approve-btn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing…';
  await BLApi.approveInvoice(id);
  bootstrap.Modal.getInstance(document.getElementById('approveModal')).hide();
  showToast('Invoice approved — payment released from escrow <i class="bi bi-check"></i> ');
  setTimeout(() => loadInvoices(), 500);
}

document.addEventListener('DOMContentLoaded', loadInvoices);
</script>
</body>
</html>
