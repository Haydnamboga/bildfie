<!-- NEW PROJECT MODAL -->
<div class="modal fade" id="newProjectModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow-lg" style="border-radius:16px">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" style="font-family:'Playfair Display',serif">Create New Project</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label small fw-600">Project Name *</label>
            <input type="text" class="form-control" id="np-name" placeholder="e.g. Karen Bungalow Phase 3">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-600">Project Type *</label>
            <select class="form-select" id="np-type">
              <option value="">Select type</option>
              <option>Residential</option><option>Commercial</option><option>Industrial</option>
              <option>Infrastructure</option><option>Renovation</option><option>Interior Design</option>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label small fw-600">Description</label>
            <textarea class="form-control" id="np-desc" rows="3" placeholder="Describe the project scope, goals, and key requirements…"></textarea>
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-600">Location *</label>
            <input type="text" class="form-control" id="np-location" placeholder="e.g. Karen, Nairobi">
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-600">Due Date</label>
            <input type="date" class="form-control" id="np-due">
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-600">Budget Min (KES)</label>
            <input type="number" class="form-control" id="np-budget-min" placeholder="500,000">
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-600">Budget Max (KES)</label>
            <input type="number" class="form-control" id="np-budget-max" placeholder="2,000,000">
          </div>
        </div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" onclick="submitNewProject()">Create Project</button>
      </div>
    </div>
  </div>
</div>

<!-- INVITE TO PROJECT MODAL -->
<div class="modal fade" id="inviteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius:16px">
      <div class="modal-header border-0"><h5 class="modal-title fw-bold">Invite Professional to Project</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="mb-3"><label class="form-label small fw-600">Search Professional</label><input type="text" class="form-control" placeholder="Search by name, trade, or ID…" oninput="showToast('Searching professionals…')"></div>
        <div class="mb-3"><label class="form-label small fw-600">Select Project</label><select class="form-select" id="invite-project-select"><option value="1">Karen Bungalow — Phase 2</option><option value="2">Westlands Office Extension</option></select></div>
        <div class="mb-3"><label class="form-label small fw-600">Role / Capacity</label><select class="form-select" id="invite-role-select"><option value="contractor">Main Contractor</option><option value="architect">Architect</option><option value="engineer">Engineer</option><option value="qs">Quantity Surveyor</option><option value="mep">MEP Consultant</option><option value="pm">Project Manager</option><option value="subcontractor">Subcontractor</option></select></div>
        <div class="mb-3"><label class="form-label small fw-600">Message (optional)</label><textarea class="form-control" id="invite-message" rows="3" placeholder="Tell them about the project and what you need…"></textarea></div>
      </div>
      <div class="modal-footer border-0 pt-0"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" onclick="submitInvite()">Send Invitation</button></div>
    </div>
  </div>
</div>


<%- include('../../partials/scripts') %>
<script>
function openInviteToProject(projectId) {
  document.getElementById('invite-project-select').value = projectId;
  new bootstrap.Modal(document.getElementById('inviteModal')).show();
}

/* ── Live dashboard data from API ── */
async function loadDashboardLive() {
  // Update avatar from session
  const user = await BLApi.me();
  if (user) {
    const av = document.getElementById('dash-user-avatar');
    if (av) av.src = user.avatar || `https://i.pravatar.cc/100?img=${user.id % 70 + 1}`;
    const nameEl = document.getElementById('dash-user-name');
    if (nameEl) nameEl.textContent = user.name || 'User';
    // Update greeting
    const greet = document.getElementById('dash-greeting-name');
    if (greet) greet.textContent = (user.name || 'there').split(' ')[0];
  }

  // Dashboard summary
  const summary = await BLApi.getDashboardSummary();
  if (summary) {
    const el = (id, v) => { const e = document.getElementById(id); if (e) e.textContent = v; };
    el('metric-projects',  summary.active_projects || summary.projects || 0);
    el('metric-messages',  summary.unread_messages || 0);
    el('metric-invoices',  summary.pending_invoices || 0);
    const budgetEl = document.getElementById('metric-budget');
    if (budgetEl && summary.total_budget) {
      const b = summary.total_budget;
      budgetEl.textContent = b >= 1000000 ? `KES ${(b/1000000).toFixed(1)}M` : `KES ${(b/1000).toFixed(0)}K`;
    }
    // Update sidebar badges
    const msgBadge = document.getElementById('dsb-msg-badge');
    if (msgBadge) {
      msgBadge.textContent = summary.unread_messages || 0;
      msgBadge.style.display = summary.unread_messages > 0 ? '' : 'none';
    }
    const invPayBadge = document.getElementById('dsb-inv-pay-badge');
    if (invPayBadge) {
      invPayBadge.textContent = summary.pending_invoices || 0;
      invPayBadge.style.display = summary.pending_invoices > 0 ? '' : 'none';
    }
  }

  // My projects
  const myProjs = await BLApi.getMyProjects();
  if (myProjs && myProjs.length) {
    BL.userProjects = myProjs;
    renderDashProjects(myProjs);
  }

  // Messages preview
  const msgs = await BLApi.getMessages();
  if (msgs && msgs.length) {
    BL.messages = msgs;
    renderDashMessages(msgs);
  }
}

document.addEventListener('DOMContentLoaded', loadDashboardLive);
</script>
</body>
</html>
