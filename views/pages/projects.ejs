<%- include('../partials/head', { title: "Projects — BuildLink" }) %>
<%- include('../partials/navbar', { activePage: "projects", user: locals.user }) %>


<!-- INFO BAR -->
<div class="bl-infobar">
  <div class="container-xl d-flex align-items-center justify-content-between h-100">
    <div class="d-flex align-items-center gap-4">
      <div class="bl-ib-item"><div class="bl-ib-dot"></div>12,400+ Projects Completed</div>
      <div class="bl-ib-item">$1.2B+ Total Value Delivered</div>
      <div class="bl-ib-item d-none d-lg-flex">180+ Countries</div>
    </div>
    <div class="bl-ib-right d-none d-lg-flex">
      <div class="bl-ib-price"><i class="bi bi-clock"></i>  <strong id="live-time">&mdash;</strong> EAT</div>
    </div>
  </div>
</div>

<!-- PAGE HERO -->
<section class="bl-page-hero">
  <div class="bl-ph-texture"></div>
  <div class="bl-ph-glow"></div>
  <div class="container-xl position-relative">
    <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
      <div class="bl-ph-pill"><span></span>12,400+ Completed Projects</div>
      <div class="bl-ph-etag"><i class="bi bi-trophy"></i>  Award-winning builds</div>
      <div class="bl-ph-etag"><i class="bi bi-check-circle-fill text-success"></i>  Verified deliveries</div>
      <div class="bl-ph-etag d-none d-md-block"><i class="bi bi-bar-chart"></i>  Transparent budgets</div>
    </div>
    <div class="bl-ph-search mb-4">
      <div class="bl-ph-seg">
        <div class="bl-ph-seg-label"><i class="bi bi-search"></i>  Search Projects</div>
        <input class="bl-ph-sinp" placeholder="Project name, type, location, or contractor&hellip;" autocomplete="off">
      </div>
      <div class="bl-ph-div"></div>
      <div class="bl-ph-sel-wrap">
        <div class="bl-ph-seg-label"><i class="bi bi-building-fill-gear"></i>  Type</div>
        <select class="bl-ph-sel">
          <option>All Types</option><option>Residential</option><option>Commercial</option>
          <option>Industrial</option><option>Infrastructure</option><option>Renovation</option>
        </select>
      </div>
      <div class="bl-ph-div"></div>
      <div class="bl-ph-sel-wrap">
        <div class="bl-ph-seg-label"><i class="bi bi-geo-alt-fill"></i>  Location</div>
        <select class="bl-ph-sel">
          <option>Any Location</option><option>Nairobi</option><option>Mombasa</option>
          <option>Kisumu</option><option>Kampala</option><option>Dar es Salaam</option>
        </select>
      </div>
      <button class="bl-ph-sbtn" onclick="showToast('Searching projects&hellip;')">Search Projects</button>
    </div>
    <div class="bl-ph-stats">
      <div class="bl-ph-stat"><div class="bl-ph-stn">12,400<span>+</span></div><div class="bl-ph-stl">Completed Projects</div></div>
      <div class="bl-ph-stat"><div class="bl-ph-stn">$1.2<span>B</span></div><div class="bl-ph-stl">Total Value</div></div>
      <div class="bl-ph-stat"><div class="bl-ph-stn">98<span>%</span></div><div class="bl-ph-stl">Client Satisfaction</div></div>
      <div class="bl-ph-stat"><div class="bl-ph-stn">180<span>+</span></div><div class="bl-ph-stl">Countries</div></div>
    </div>
  </div>
</section>

<!-- CATEGORY STRIP -->
<div class="bl-cat-strip">
  <div class="bl-cat-inner">
    <div class="bl-cat-pill on" onclick="setCat(this,'all')"><div class="bl-cat-ico"><i class="bi bi-building-fill-gear"></i> </div><div class="bl-cat-lbl">All Projects</div><div class="bl-cat-count">12,400</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'res')"><div class="bl-cat-ico"><i class="bi bi-houses"></i> </div><div class="bl-cat-lbl">Residential</div><div class="bl-cat-count">4,800</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'com')"><div class="bl-cat-ico"><i class="bi bi-building"></i> </div><div class="bl-cat-lbl">Commercial</div><div class="bl-cat-count">3,200</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'ind')"><div class="bl-cat-ico"><i class="bi bi-building-fill"></i> </div><div class="bl-cat-lbl">Industrial</div><div class="bl-cat-count">1,400</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'inf')"><div class="bl-cat-ico"><i class="bi bi-map"></i> </div><div class="bl-cat-lbl">Infrastructure</div><div class="bl-cat-count">1,800</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'ren')"><div class="bl-cat-ico"><i class="bi bi-hammer"></i> </div><div class="bl-cat-lbl">Renovation</div><div class="bl-cat-count">1,200</div></div>
  </div>
</div>

<!-- BREADCRUMB -->
<div class="bg-white border-bottom py-2">
  <div class="container-xl d-flex align-items-center gap-2 small text-muted">
    <a href="/" class="text-decoration-none text-muted">Home</a>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    <span class="text-dark fw-500">Project Showcase</span>
    <span class="ms-auto">Showing <strong>6</strong> of <strong>12,400+</strong> projects</span>
  </div>
</div>

<!-- MAIN -->
<div class="container-xl py-5">
  <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
    <span class="text-muted small">Sort by:</span>
    <select class="form-select form-select-sm" style="width:auto">
      <option>Most Recent</option><option>Highest Value</option><option>Most Reviewed</option><option>Biggest Scale</option>
    </select>
    <div class="d-flex gap-2 ms-auto flex-wrap">
      <button class="btn btn-sm btn-outline-secondary bl-tab on" onclick="initTabs()">All</button>
      <button class="btn btn-sm btn-outline-secondary bl-tab" onclick="initTabs()">Residential</button>
      <button class="btn btn-sm btn-outline-secondary bl-tab" onclick="initTabs()">Commercial</button>
      <button class="btn btn-sm btn-outline-secondary bl-tab" onclick="initTabs()">Infrastructure</button>
    </div>
  </div>

  <div class="row g-3 mb-4" id="projs-grid"></div>

  <!-- FEATURED PROJECT -->
  <div class="card border-0 shadow-sm overflow-hidden mb-4 bl-rv" style="border-radius:16px">
    <div class="row g-0">
      <div class="col-md-5 position-relative">
        <img src="https://images.unsplash.com/photo-1486325212027-8081e485255e?w=600" class="img-fluid h-100" style="object-fit:cover;min-height:280px" alt="Westlands Tower">
        <div class="position-absolute top-0 start-0 w-100 h-100" style="background:linear-gradient(to right,rgba(1,29,71,.6),transparent)"></div>
        <div class="position-absolute top-3 start-3">
          <span class="badge bg-success">Completed 2025</span>
        </div>
        <div class="position-absolute bottom-3 start-3">
          <span class="badge bg-dark bg-opacity-75"><i class="bi bi-trophy"></i>  BuildLink Award Winner</span>
        </div>
      </div>
      <div class="col-md-7 p-4 d-flex flex-column justify-content-between">
        <div>
          <div class="bl-sec-label mb-2">Featured Project</div>
          <h4 class="fw-bold mb-1" style="font-family:'Playfair Display',serif;color:var(--bl-navy)">Westlands Business Tower</h4>
          <div class="text-muted small mb-3"><i class="bi bi-geo-alt-fill"></i>  Westlands, Nairobi &middot; Commercial &middot; 22 Floors</div>
          <p class="text-muted small mb-3" style="line-height:1.75">A landmark 22-storey mixed-use commercial development featuring Grade A office space, retail podium, and rooftop amenities. Delivered 3 weeks ahead of schedule and 4% under budget through BuildLink's integrated platform.</p>
          <div class="row g-2 mb-3">
            <div class="col-4"><div class="text-center p-2 rounded-3 bg-light"><div class="fw-bold" style="color:var(--bl-navy);font-family:'Playfair Display',serif">KES 2.4B</div><div class="text-muted" style="font-size:9px;text-transform:uppercase">Project Value</div></div></div>
            <div class="col-4"><div class="text-center p-2 rounded-3 bg-light"><div class="fw-bold" style="color:var(--bl-navy);font-family:'Playfair Display',serif">18 Months</div><div class="text-muted" style="font-size:9px;text-transform:uppercase">Duration</div></div></div>
            <div class="col-4"><div class="text-center p-2 rounded-3 bg-light"><div class="fw-bold" style="color:var(--bl-navy);font-family:'Playfair Display',serif">47 Pros</div><div class="text-muted" style="font-size:9px;text-transform:uppercase">Team Size</div></div></div>
          </div>
          <div class="d-flex flex-wrap gap-1">
            <span class="bl-tag">High-Rise</span><span class="bl-tag">Mixed-Use</span><span class="bl-tag">Grade A Office</span><span class="bl-tag">LEED Certified</span>
          </div>
        </div>
        <div class="d-flex gap-2 mt-3">
          <button class="btn btn-primary btn-sm" onclick="showToast('Opening project case study&hellip;')">View Case Study</button>
          <button class="btn btn-outline-secondary btn-sm" onclick="showToast('Contacting project team&hellip;')">Contact Team</button>
        </div>
      </div>
    </div>
  </div>

  <nav class="mt-4">
    <ul class="pagination justify-content-center">
      <li class="page-item disabled"><a class="page-link">&larr; Prev</a></li>
      <li class="page-item active"><a class="page-link" href="#">1</a></li>
      <li class="page-item"><a class="page-link" href="#" onclick="showToast('Page 2')">2</a></li>
      <li class="page-item"><a class="page-link" href="#" onclick="showToast('Page 3')">3</a></li>
      <li class="page-item disabled"><a class="page-link">&hellip;</a></li>
      <li class="page-item"><a class="page-link" href="#" onclick="showToast('Last page')">310</a></li>
      <li class="page-item"><a class="page-link" href="#" onclick="showToast('Next page')">Next &rarr;</a></li>
    </ul>
  </nav>

  <!-- CTA -->
  <div class="bl-cta bl-rv mt-5">
    <div class="bl-cta-glow"></div>
    <div class="position-relative">
      <div class="row align-items-center g-4">
        <div class="col-lg-7">
          <h2 class="bl-cta-h">Ready to start your next project?</h2>
          <p class="bl-cta-sub">Join 48,600+ professionals on BuildLink and bring your construction vision to life.</p>
        </div>
        <div class="col-lg-5 d-flex gap-3 justify-content-lg-end flex-wrap">
          <a href="/dashboard" class="btn btn-primary btn-lg">Create Project</a>
          <a href="/professionals" class="btn btn-outline-light btn-lg">Find Professionals</a>
        </div>
      </div>
    </div>
  </div>
</div>


<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
</body>
</html>
