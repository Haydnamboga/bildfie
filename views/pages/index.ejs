<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
<script>
/* Featured professionals — real API data only, with an honest empty state.
   Never falls back to demo data. */
(async () => {
  const grid = document.getElementById('home-pros');
  if (!grid) return;

  const emptyState = `
    <div class="col-12">
      <div class="bl-hp-empty text-center p-5">
        <div class="fw-bold mb-1" style="font-size:16px;color:var(--bl-navy)">No professionals listed yet</div>
        <p class="text-muted small mb-3">bildfie is just getting started. Be one of the first verified professionals.</p>
        <a href="/register" class="btn btn-primary btn-sm">Join as a Professional</a>
      </div>
    </div>`;

  const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const card = p => {
    const name = esc(p.name) || 'Professional';
    const initials = (p.name || '?').trim().split(/\s+/).map(s => s[0]).slice(0,2).join('').toUpperCase();
    const avatar = p.avatar
      ? `<img src="${esc(p.avatar)}" alt="" style="width:46px;height:46px;border-radius:12px;object-fit:cover">`
      : `<div class="d-flex align-items-center justify-content-center" style="width:46px;height:46px;border-radius:12px;background:var(--bl-navy);color:#fff;font-weight:700;font-size:14px">${esc(initials)}</div>`;
    const rating = Number(p.rating) > 0 ? `★ ${Number(p.rating).toFixed(1)}` : 'New';
    const verified = p.verified ? `<span class="badge text-bg-light border" style="font-size:9px">Verified</span>` : '';
    return `
      <div class="col-sm-6 col-lg-3">
        <a href="/professionals" class="text-decoration-none bl-hp-card">
          <div class="d-flex align-items-center gap-2 mb-3">${avatar}
            <div class="overflow-hidden">
              <div class="fw-bold text-truncate" style="font-size:13px;color:var(--bl-navy)">${name}</div>
              <div class="text-muted text-truncate" style="font-size:11px">${esc(p.trade)}</div>
            </div>
          </div>
          <div class="d-flex align-items-center justify-content-between">
            <span class="text-muted" style="font-size:11px">${esc(p.location)}</span>
            <span class="fw-semibold" style="font-size:11px;color:var(--bl-accent)">${rating}</span>
          </div>
          <div class="mt-2">${verified}</div>
        </a>
      </div>`;
  };

  try {
    const res = await fetch('/api/professionals?limit=4');
    if (!res.ok) throw new Error('request failed');
    const data = await res.json();
    const pros = data.professionals || [];
    grid.innerHTML = pros.length ? pros.map(card).join('') : emptyState;
  } catch (e) {
    grid.innerHTML = emptyState;
  }
})();
</script>
</body>
