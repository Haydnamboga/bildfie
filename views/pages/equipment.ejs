<%- include('../partials/head', { title: "Equipment — BuildLink" }) %>
<%- include('../partials/navbar', { activePage: "equipment", user: locals.user }) %>


<!-- INFO BAR -->
<div class="bl-infobar">
  <div class="container-xl d-flex align-items-center justify-content-between h-100">
    <div class="d-flex align-items-center gap-4">
      <div class="bl-ib-item"><div class="bl-ib-dot" style="background:#FF9800"></div>6,400+ Equipment Listed</div>
      <div class="bl-ib-item">1,800+ Verified Owners</div>
      <div class="bl-ib-item d-none d-lg-flex">Hourly, Daily & Weekly Rates</div>
      <div class="bl-ib-item d-none d-xl-flex">Operator Included Options</div>
    </div>
    <div class="bl-ib-right d-none d-lg-flex">
      <div class="bl-ib-price"><i class="bi bi-clock"></i>  <strong id="live-time">&mdash;</strong> EAT</div>
    </div>
  </div>
</div>

<!-- PAGE HERO -->
<section class="bl-page-hero">
  <div class="bl-ph-texture"></div>
  <div class="bl-ph-glow"></div>
  <div class="container-xl position-relative">
    <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
      <div class="bl-ph-pill"><span style="background:#FF9800"></span>6,400+ Equipment Available</div>
      <div class="bl-ph-etag"><i class="bi bi-truck"></i>  Excavators, Cranes & More</div>
      <div class="bl-ph-etag"><i class="bi bi-person-badge"></i>  Operator Included Options</div>
      <div class="bl-ph-etag d-none d-md-block"><i class="bi bi-shield-check"></i>  Fully Insured Equipment</div>
    </div>
    <div class="bl-ph-search mb-2">
      <div class="bl-ph-seg">
        <div class="bl-ph-seg-label"><i class="bi bi-search"></i>  Search Equipment</div>
        <input class="bl-ph-sinp" placeholder="Excavator, crane, concrete mixer, scaffolding&hellip;" autocomplete="off">
      </div>
      <div class="bl-ph-div"></div>
      <div class="bl-ph-sel-wrap">
        <div class="bl-ph-seg-label"><i class="bi bi-building-fill-gear"></i>  Category</div>
        <select class="bl-ph-sel">
          <option>All Equipment</option><option>Excavators</option><option>Cranes & Hoists</option>
          <option>Concrete Equipment</option><option>Compaction</option><option>Scaffolding</option>
          <option>Generators</option><option>Compressors</option><option>Welding Equipment</option>
        </select>
      </div>
      <div class="bl-ph-div"></div>
      <div class="bl-ph-sel-wrap">
        <div class="bl-ph-seg-label"><i class="bi bi-geo-alt-fill"></i>  Location</div>
        <select class="bl-ph-sel">
          <option>Any Location</option><option>Nairobi</option><option>Mombasa</option>
          <option>Kisumu</option><option>Kampala</option><option>Dar es Salaam</option>
        </select>
      </div>
      <div class="bl-ph-div d-none d-lg-block"></div>
      <div class="bl-ph-sel-wrap d-none d-lg-block">
        <div class="bl-ph-seg-label"><i class="bi bi-calendar"></i>  Duration</div>
        <select class="bl-ph-sel">
          <option>Any Duration</option><option>Hourly</option><option>Daily</option><option>Weekly</option><option>Monthly</option>
        </select>
      </div>
      <button class="bl-ph-sbtn" style="background:#BF6900" onclick="showToast('Searching equipment&hellip;')">Search Equipment</button>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap mb-4">
      <span class="text-white-50 small">Popular:</span>
      <span class="bl-ph-etag" style="cursor:pointer" onclick="showToast('Searching Excavator&hellip;')"><i class="bi bi-truck"></i>  Excavator</span>
      <span class="bl-ph-etag" style="cursor:pointer" onclick="showToast('Searching Tower Crane&hellip;')"><i class="bi bi-building-fill-gear"></i>  Tower Crane</span>
      <span class="bl-ph-etag" style="cursor:pointer" onclick="showToast('Searching Concrete Mixer&hellip;')"><i class="bi bi-arrow-repeat"></i>  Concrete Mixer</span>
      <span class="bl-ph-etag" style="cursor:pointer" onclick="showToast('Searching Generator&hellip;')"><i class="bi bi-lightning"></i>  Generator</span>
      <span class="bl-ph-etag" style="cursor:pointer" onclick="showToast('Searching Scaffolding&hellip;')"><i class="bi bi-building"></i>  Scaffolding</span>
    </div>
    <div class="bl-ph-stats">
      <div class="bl-ph-stat"><div class="bl-ph-stn">6,400<span>+</span></div><div class="bl-ph-stl">Equipment Listed</div></div>
      <div class="bl-ph-stat"><div class="bl-ph-stn">1,800<span>+</span></div><div class="bl-ph-stl">Verified Owners</div></div>
      <div class="bl-ph-stat"><div class="bl-ph-stn">4.7<span>&#9733;</span></div><div class="bl-ph-stl">Average Rating</div></div>
      <div class="bl-ph-stat"><div class="bl-ph-stn">24<span>hr</span></div><div class="bl-ph-stl">Avg. Delivery</div></div>
    </div>
  </div>
</section>

<!-- CATEGORY STRIP -->
<div class="bl-cat-strip">
  <div class="bl-cat-inner">
    <div class="bl-cat-pill on" onclick="setCat(this,'all')" style="--active-color:#FF9800"><div class="bl-cat-ico"><i class="bi bi-building-fill-gear"></i> </div><div class="bl-cat-lbl">All Equipment</div><div class="bl-cat-count">6,400</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'excavators')"><div class="bl-cat-ico"><i class="bi bi-truck"></i> </div><div class="bl-cat-lbl">Excavators</div><div class="bl-cat-count">840</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'cranes')"><div class="bl-cat-ico"><i class="bi bi-building-fill-gear"></i> </div><div class="bl-cat-lbl">Cranes & Hoists</div><div class="bl-cat-count">620</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'concrete')"><div class="bl-cat-ico"><i class="bi bi-arrow-repeat"></i> </div><div class="bl-cat-lbl">Concrete</div><div class="bl-cat-count">980</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'compaction')"><div class="bl-cat-ico"><i class="bi bi-person-badge"></i> </div><div class="bl-cat-lbl">Compaction</div><div class="bl-cat-count">440</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'scaffold')"><div class="bl-cat-ico"><i class="bi bi-building"></i> </div><div class="bl-cat-lbl">Scaffolding</div><div class="bl-cat-count">1,200</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'gen')"><div class="bl-cat-ico"><i class="bi bi-lightning"></i> </div><div class="bl-cat-lbl">Generators</div><div class="bl-cat-count">760</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'comp')"><div class="bl-cat-ico"><i class="bi bi-wind"></i> </div><div class="bl-cat-lbl">Compressors</div><div class="bl-cat-count">380</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'weld')"><div class="bl-cat-ico"><i class="bi bi-fire"></i> </div><div class="bl-cat-lbl">Welding</div><div class="bl-cat-count">520</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'pump')"><div class="bl-cat-ico"><i class="bi bi-droplet"></i> </div><div class="bl-cat-lbl">Water Pumps</div><div class="bl-cat-count">340</div></div>
    <div class="bl-cat-pill" onclick="setCat(this,'light')"><div class="bl-cat-ico"><i class="bi bi-lightbulb"></i> </div><div class="bl-cat-lbl">Site Lighting</div><div class="bl-cat-count">280</div></div>
  </div>
</div>

<!-- BREADCRUMB -->
<div class="bg-white border-bottom py-2">
  <div class="container-xl d-flex align-items-center gap-2 small text-muted">
    <a href="/" class="text-decoration-none text-muted">Home</a>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    <span class="text-dark fw-500">Equipment Hire</span>
    <span class="ms-auto">Showing <strong>6</strong> of <strong>6,400+</strong> equipment</span>
  </div>
</div>

<!-- MAIN LAYOUT -->
<div class="container-xl py-4">
  <div class="row g-4">
    <!-- SIDEBAR -->
    <div class="col-lg-3">
      <div class="bl-sidebar">
        <div class="bl-sb-section">
          <div class="bl-sb-title">Category</div>
          <div class="d-flex flex-column gap-1">
            <div class="bl-cat-node on" onclick="this.classList.toggle('on')"><span><i class="bi bi-building-fill-gear"></i> </span>All Equipment<span class="ms-auto badge bg-light text-muted">6,400</span></div>
            <div class="bl-cat-node" onclick="this.classList.toggle('on')"><span><i class="bi bi-truck"></i> </span>Excavators<span class="ms-auto badge bg-light text-muted">840</span></div>
            <div class="bl-cat-node" onclick="this.classList.toggle('on')"><span><i class="bi bi-building-fill-gear"></i> </span>Cranes & Hoists<span class="ms-auto badge bg-light text-muted">620</span></div>
            <div class="bl-cat-node" onclick="this.classList.toggle('on')"><span><i class="bi bi-arrow-repeat"></i> </span>Concrete Equipment<span class="ms-auto badge bg-light text-muted">980</span></div>
            <div class="bl-cat-node" onclick="this.classList.toggle('on')"><span><i class="bi bi-person-badge"></i> </span>Compaction<span class="ms-auto badge bg-light text-muted">440</span></div>
            <div class="bl-cat-node" onclick="this.classList.toggle('on')"><span><i class="bi bi-building"></i> </span>Scaffolding<span class="ms-auto badge bg-light text-muted">1,200</span></div>
            <div class="bl-cat-node" onclick="this.classList.toggle('on')"><span><i class="bi bi-lightning"></i> </span>Generators<span class="ms-auto badge bg-light text-muted">760</span></div>
          </div>
        </div>
        <div class="bl-sb-section">
          <div class="bl-sb-title">Availability</div>
          <div class="d-flex flex-column gap-2">
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box on"></div><span class="bl-cb-label"><i class="bi bi-lightning"></i>  Available Now</span><span class="ms-auto text-muted" style="font-size:10px">3,200</span></div>
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box"></div><span class="bl-cb-label"><i class="bi bi-calendar"></i>  Within 24 Hours</span><span class="ms-auto text-muted" style="font-size:10px">4,800</span></div>
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box"></div><span class="bl-cb-label"><i class="bi bi-person-badge"></i>  Operator Included</span><span class="ms-auto text-muted" style="font-size:10px">2,400</span></div>
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box"></div><span class="bl-cb-label"><i class="bi bi-shield-check"></i>  Insured</span><span class="ms-auto text-muted" style="font-size:10px">5,100</span></div>
          </div>
        </div>
        <div class="bl-sb-section">
          <div class="bl-sb-title">Hire Period</div>
          <div class="d-flex flex-column gap-2">
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box on"></div><span class="bl-cb-label"><i class="bi bi-stopwatch"></i>  Hourly Rate</span></div>
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box on"></div><span class="bl-cb-label"><i class="bi bi-calendar"></i>  Daily Rate</span></div>
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box"></div><span class="bl-cb-label"><i class="bi bi-calendar-check"></i>  Weekly Rate</span></div>
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box"></div><span class="bl-cb-label"><i class="bi bi-calendar3"></i>  Monthly Rate</span></div>
          </div>
        </div>
        <div class="bl-sb-section">
          <div class="bl-sb-title">Daily Rate (KES)</div>
          <div class="small fw-bold mb-2" id="eq-rate-val">Up to KES 150,000</div>
          <input type="range" class="form-range" min="1000" max="500000" value="150000" style="accent-color:#BF6900" oninput="document.getElementById('eq-rate-val').textContent='Up to KES '+Number(this.value).toLocaleString()">
          <div class="d-flex justify-content-between text-muted" style="font-size:10px"><span>KES 1,000</span><span>KES 500K+</span></div>
        </div>
        <div class="bl-sb-section">
          <div class="bl-sb-title">Owner Verification</div>
          <div class="d-flex flex-column gap-2">
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box on"></div><span class="bl-cb-label"><i class="bi bi-check-circle-fill text-success"></i>  Verified Owners</span></div>
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box"></div><span class="bl-cb-label"><i class="bi bi-star-fill text-warning"></i>  4.5+ Rating</span></div>
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box"></div><span class="bl-cb-label"><i class="bi bi-trophy"></i>  Top Rated</span></div>
          </div>
        </div>
        <div class="bl-sb-section">
          <div class="bl-sb-title">Location</div>
          <div class="d-flex flex-column gap-2">
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box on"></div><span class="bl-cb-label">Nairobi</span><span class="ms-auto text-muted" style="font-size:10px">3,800</span></div>
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box"></div><span class="bl-cb-label">Mombasa</span><span class="ms-auto text-muted" style="font-size:10px">820</span></div>
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box"></div><span class="bl-cb-label">Kisumu</span><span class="ms-auto text-muted" style="font-size:10px">440</span></div>
            <div class="bl-cb-item" onclick="toggleCheck(this)"><div class="bl-cb-box"></div><span class="bl-cb-label">Other</span><span class="ms-auto text-muted" style="font-size:10px">1,340</span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="col-lg-9">
      <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
        <span class="text-muted small">Sort by:</span>
        <select class="form-select form-select-sm" style="width:auto">
          <option>Best Match</option><option>Lowest Daily Rate</option><option>Highest Rated</option><option>Nearest</option>
        </select>
        <span class="text-muted small ms-auto"><strong>6,400+</strong> equipment available</span>
        <div class="btn-group btn-group-sm"><button class="btn btn-dark"><i class="bi bi-grid"></i></button><button class="btn btn-outline-secondary" onclick="showToast('List view coming soon')"><i class="bi bi-list-ul"></i></button></div>
      </div>

      <div class="row g-3" id="eq-grid"></div>

      <!-- TRANSPORT SECTION -->
      <div class="mt-5">
        <div class="d-flex align-items-end justify-content-between mb-4 bl-rv">
          <div>
            <div class="bl-sec-label">Logistics</div>
            <h2 class="bl-sec-h">Transport & Delivery</h2>
            <p class="bl-sec-sub">Flatbeds, low-loaders, and logistics partners for equipment and material transport.</p>
          </div>
          <a href="/transport" class="bl-see-all d-none d-md-block">View All Transport &rarr;</a>
        </div>
        <div class="row g-3" id="tr-grid"></div>
      </div>

      <nav class="mt-4">
        <ul class="pagination justify-content-center">
          <li class="page-item disabled"><a class="page-link">&larr; Prev</a></li>
          <li class="page-item active"><a class="page-link" href="#">1</a></li>
          <li class="page-item"><a class="page-link" href="#" onclick="showToast('Page 2')">2</a></li>
          <li class="page-item"><a class="page-link" href="#" onclick="showToast('Page 3')">3</a></li>
          <li class="page-item disabled"><a class="page-link">&hellip;</a></li>
          <li class="page-item"><a class="page-link" href="#" onclick="showToast('Last page')">160</a></li>
          <li class="page-item"><a class="page-link" href="#" onclick="showToast('Next page')">Next &rarr;</a></li>
        </ul>
      </nav>
    </div>
  </div>
</div>


<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
</body>
</html>
