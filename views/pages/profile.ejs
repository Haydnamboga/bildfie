        <div class="mb-3"><label class="form-label small fw-600">Select Project</label><select class="form-select" id="invite-project-select"><option value="">&mdash; Choose a project &mdash;</option></select></div>
        <div class="mb-3"><label class="form-label small fw-600">Role / Capacity</label><select class="form-select" id="invite-role-select"><option value="engineer">Structural Engineer</option><option value="contractor">Main Contractor</option><option value="pm">Project Manager</option><option value="consultant">Technical Consultant</option></select></div>
        <div class="mb-3"><label class="form-label small fw-600">Personal Message (optional)</label><textarea class="form-control" id="invite-message" rows="3" placeholder="Tell James about your project&hellip;"></textarea></div>
      </div>
