<section class="py-4">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-7">
        <h2 class="section-title mb-4">My Profile</h2>
        <div class="card mb-3">
          <div class="card-header fw-bold">Account Information</div>
          <div class="card-body">
            <div class="row g-2 small">
              <div class="col-md-6"><span class="text-muted">Name:</span> <strong><%=user.name%></strong></div>
              <div class="col-md-6"><span class="text-muted">Email:</span> <%=user.email%></div>
              <%if(user.phone){%><div class="col-md-6"><span class="text-muted">Phone:</span> <%=user.phone%></div><%}%>
              <div class="col-md-6"><span class="text-muted">Role:</span> <span class="badge bg-primary"><%=user.system_role%></span></div>
            </div>
          </div>
        </div>
        <%if(church){%>
        <div class="card mb-3">
          <div class="card-header fw-bold">My Church</div>
          <div class="card-body">
            <h6 class="fw-bold"><%=church.name%></h6>
            <p class="small text-muted mb-1"><%=church.sub_county?church.sub_county+', ':''%><%=church.county%></p>
            <%if(church.pastor_name){%><p class="small mb-0"><i class="bi bi-person-badge"></i> Pastor <%=church.pastor_name%></p><%}%>
            <a href="/portal/church/<%=church.id%>" class="btn btn-sm btn-outline-primary mt-2">View Church Page</a>
          </div>
        </div>
        <%}%>
        <%if(member){%>
        <div class="card">
          <div class="card-header fw-bold">Church Member Record</div>
          <div class="card-body small">
            <%if(member.baptism_date){%><div class="mb-2 text-success"><i class="bi bi-water"></i> Baptized: <%=new Date(member.baptism_date).toLocaleDateString()%></div><%}%>
            <%if(member.joined_date){%><div class="mb-2"><span class="text-muted">Joined:</span> <%=new Date(member.joined_date).toLocaleDateString()%></div><%}%>
            <div><span class="text-muted">Membership:</span> <span class="badge badge-active"><%=member.membership_status%></span></div>
          </div>
        </div>
        <%}%>
        <div class="mt-3 text-center">
          <a href="/auth/logout" class="btn btn-outline-danger"><i class="bi bi-box-arrow-right"></i> Sign Out</a>
        </div>
      </div>
    </div>
  </div>
</section>
