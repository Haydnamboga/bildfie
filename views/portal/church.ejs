<section class="py-4">
  <div class="container">
    <div class="row align-items-center mb-4">
      <div class="col">
        <h1 class="section-title"><%=church.name%></h1>
        <p class="text-muted"><%=church.sub_county?church.sub_county+', ':''%><%=church.county||'Nyamira'%><%=church.pastor_name?' · Pastor: '+church.pastor_name:''%></p>
      </div>
      <div class="col-auto"><span class="badge bg-success fs-6"><%=memberCount%> Active Members</span></div>
    </div>
    <%if(church.description){%><div class="alert alert-light border mb-4"><%=church.description%></div><%}%>
    <div class="row g-3">
      <%if(announcements.length){%>
      <div class="col-md-6">
        <div class="card h-100"><div class="card-header fw-bold"><i class="bi bi-megaphone me-2"></i>Announcements</div>
          <ul class="list-group list-group-flush"><%announcements.forEach(a=>{%><li class="list-group-item small px-3"><strong><%=a.title%></strong><p class="text-muted mb-0 small"><%=a.content.substring(0,100)%></p></li><%})%></ul>
        </div>
      </div>
      <%}%>
      <%if(events.length){%>
      <div class="col-md-6">
        <div class="card h-100"><div class="card-header fw-bold"><i class="bi bi-calendar-event me-2"></i>Events</div>
          <ul class="list-group list-group-flush"><%events.forEach(e=>{%><li class="list-group-item px-3 py-2"><div class="fw-semibold small"><%=e.title%></div><div class="text-muted small"><%=new Date(e.start_date).toLocaleDateString()%><%=e.venue?' · '+e.venue:''%></div></li><%})%></ul>
        </div>
      </div>
      <%}%>
      <%if(sermons.length){%>
      <div class="col-12">
        <div class="card"><div class="card-header fw-bold"><i class="bi bi-mic me-2"></i>Recent Sermons</div>
          <div class="row g-2 p-3">
            <%sermons.forEach(s=>{%>
            <div class="col-md-4"><div class="border rounded p-3"><h6 class="fw-bold small"><%=s.title%></h6><div class="text-muted small"><%=s.preacher%><%=s.sermon_date?' · '+new Date(s.sermon_date).toLocaleDateString():''%></div><%if(s.scripture_reference){%><div class="text-muted small"><i class="bi bi-book"></i> <%=s.scripture_reference%></div><%}%></div></div>
            <%})%>
          </div>
        </div>
      </div>
      <%}%>
      <%if(departments.length){%>
      <div class="col-12">
        <div class="card"><div class="card-header fw-bold"><i class="bi bi-diagram-3 me-2"></i>Departments & Ministries</div>
          <div class="card-body"><div class="row g-2"><%departments.forEach(d=>{%><div class="col-md-3 col-6"><div class="border rounded p-2 text-center small"><i class="bi bi-people d-block text-primary mb-1"></i><%=d.name%></div></div><%})%></div></div>
        </div>
      </div>
      <%}%>
      <div class="col-12 text-center">
        <% if (!locals.session?.userId) { %><a href="/auth/register" class="btn btn-primary me-2">Join This Church</a><%}%>
        <a href="/churches" class="btn btn-outline-secondary">← All Churches</a>
      </div>
    </div>
  </div>
</section>
